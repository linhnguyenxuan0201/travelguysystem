@model TripCompass.WebUI.ViewModels.PremiumViewModel
@{
    ViewData["Title"] = "Premium - TripCompass";
    Layout = "_Layout";
}

<div class="premium-page">
    <!-- Hero Section -->
    <section class="premium-hero">
        <div class="container">
            <h1 class="hero-title">Khám phá thế giới không giới hạn</h1>
            <p class="hero-subtitle">Trải nghiệm du lịch tuyệt vời với các tính năng Premium độc quyền</p>
            <div class="hero-actions">
                @if (Model.IsAuthenticated)
                {
                    @if (Model.IsPremium)
                    {
                        <div class="current-plan-badge">
                            <span>Bạn đang sử dụng gói @Model.CurrentPlan</span>
                            @if (Model.PremiumExpiresAt.HasValue)
                            {
                                <span class="expires-text">Hết hạn: @Model.PremiumExpiresAt.Value.ToString("dd/MM/yyyy")</span>
                            }
                        </div>
                    }
                    else
                    {
                        <a href="#pricing" class="btn btn-primary">Nâng cấp ngay</a>
                    }
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-primary">Đăng nhập để nâng cấp</a>
                }
                <a href="#features" class="btn btn-secondary">Xem demo</a>
            </div>
        </div>
    </section>

    <!-- Feature Comparison Section -->
    <section class="feature-comparison" id="features">
        <div class="container">
            <h2 class="section-title">So sánh tính năng</h2>
            <div class="comparison-table">
                <table>
                    <thead>
                        <tr>
                            <th>Tính năng</th>
                            <th>Miễn phí</th>
                            <th>Premium</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Hướng dẫn cơ bản</td>
                            <td>✓</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td>Bản đồ GPS offline</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td>AI lập lịch trình thông minh</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td>Hỗ trợ 24/7</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td>Ưu đãi độc quyền</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td>Không giới hạn đánh giá</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section class="pricing-section" id="pricing">
        <div class="container">
            <h2 class="section-title">Chọn gói phù hợp</h2>
            <div class="pricing-cards">
                <div class="pricing-card @(Model.CurrentPlan == "Free" ? "current" : "")">
                    <h3>Cơ bản</h3>
                    <div class="price">Miễn phí</div>
                    <ul class="features-list">
                        <li>Hướng dẫn cơ bản</li>
                        <li>Truy cập cộng đồng</li>
                        <li>Đánh giá hạn chế</li>
                    </ul>
                    @if (Model.CurrentPlan == "Free")
                    {
                        <button class="btn btn-outline" disabled>Gói hiện tại</button>
                    }
                    else
                    {
                        <button class="btn btn-outline" disabled>Miễn phí</button>
                    }
                </div>
                <div class="pricing-card featured @(Model.CurrentPlan == "Pro" ? "current" : "")">
                    <div class="badge">Phổ biến</div>
                    <h3>Premium</h3>
                    <div class="price">299,000₫<span>/tháng</span></div>
                    <ul class="features-list">
                        <li>Tất cả tính năng cơ bản</li>
                        <li>Bản đồ GPS offline</li>
                        <li>AI lập lịch trình</li>
                        <li>Hỗ trợ 24/7</li>
                        <li>Ưu đãi độc quyền</li>
                    </ul>
                    @if (Model.CurrentPlan == "Pro")
                    {
                        <button class="btn btn-outline" disabled>Gói hiện tại</button>
                    }
                    else if (Model.IsAuthenticated)
                    {
                        <form asp-action="UpgradePlan" asp-controller="Account" method="post" style="display: inline;">
                            <input type="hidden" name="planCode" value="Pro" />
                            <input type="hidden" name="planType" value="monthly" />
                            <button type="submit" class="btn btn-primary">Nâng cấp ngay</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-primary">Đăng nhập để nâng cấp</a>
                    }
                </div>
                <div class="pricing-card @(Model.CurrentPlan == "Enterprise" ? "current" : "")">
                    <h3>Premium Năm</h3>
                    <div class="price">2,390,000₫<span>/năm</span></div>
                    <div class="savings">Tiết kiệm 20%</div>
                    <ul class="features-list">
                        <li>Tất cả tính năng Premium</li>
                        <li>Thanh toán một lần</li>
                        <li>Ưu đãi tốt nhất</li>
                    </ul>
                    @if (Model.CurrentPlan == "Enterprise")
                    {
                        <button class="btn btn-outline" disabled>Gói hiện tại</button>
                    }
                    else if (Model.IsAuthenticated)
                    {
                        <form asp-action="UpgradePlan" asp-controller="Account" method="post" style="display: inline;">
                            <input type="hidden" name="planCode" value="Enterprise" />
                            <input type="hidden" name="planType" value="yearly" />
                            <button type="submit" class="btn btn-secondary">Chọn gói này</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-secondary">Đăng nhập để nâng cấp</a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Premium Features Section -->
    <section class="premium-features">
        <div class="container">
            <h2 class="section-title">Tính năng Premium độc quyền</h2>
            <div class="features-grid">
                <div class="features-content">
                    <div class="feature-item">
                        <div class="feature-icon">🤖</div>
                        <div class="feature-text">
                            <h3>AI lập lịch trình thông minh</h3>
                            <p>Tạo lịch trình du lịch tối ưu dựa trên sở thích và ngân sách của bạn</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">🗺️</div>
                        <div class="feature-text">
                            <h3>Bản đồ GPS Offline</h3>
                            <p>Tải xuống và sử dụng bản đồ ngay cả khi không có internet</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">💬</div>
                        <div class="feature-text">
                            <h3>Hỗ trợ 24/7</h3>
                            <p>Đội ngũ hỗ trợ luôn sẵn sàng giúp đỡ bạn mọi lúc, mọi nơi</p>
                        </div>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">🎁</div>
                        <div class="feature-text">
                            <h3>Ưu đãi độc quyền</h3>
                            <p>Nhận các ưu đãi đặc biệt từ đối tác và nhà cung cấp dịch vụ</p>
                        </div>
                    </div>
                </div>
                <div class="features-image">
                    <div class="phone-mockup">
                        <div class="phone-screen">
                            <div class="map-preview"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials">
        <div class="container">
            <h2 class="section-title">Khách hàng nói gì về Premium</h2>
            <div class="testimonials-grid">
                <div class="testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p class="testimonial-text">"Premium giúp tôi tiết kiệm rất nhiều thời gian lập kế hoạch. AI lập lịch trình thật sự thông minh!"</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">NH</div>
                        <div class="author-info">
                            <div class="author-name">Nguyễn Hồ</div>
                            <div class="author-role">Du khách Premium</div>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p class="testimonial-text">"Bản đồ offline là cứu cánh khi đi phượt ở vùng sâu vùng xa. Rất đáng giá!"</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">TM</div>
                        <div class="author-info">
                            <div class="author-name">Trần Minh</div>
                            <div class="author-role">Phượt thủ</div>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p class="testimonial-text">"Hỗ trợ 24/7 rất nhanh chóng và chuyên nghiệp. Tôi cảm thấy an tâm khi đi du lịch."</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">LT</div>
                        <div class="author-info">
                            <div class="author-name">Lê Thảo</div>
                            <div class="author-role">Blogger du lịch</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <h2 class="cta-title">Sẵn sàng khám phá thế giới?</h2>
            <div class="cta-actions">
                @if (Model.IsAuthenticated)
                {
                    @if (!Model.IsPremium)
                    {
                        <a href="#pricing" class="btn btn-primary">Nâng cấp ngay</a>
                    }
                    else
                    {
                        <a href="/Account/Profile" class="btn btn-primary">Quản lý gói của tôi</a>
                    }
                }
                else
                {
                    <a href="/Account/Register" class="btn btn-primary">Bắt đầu dùng thử miễn phí</a>
                }
                <a href="#features" class="btn btn-secondary">Tìm hiểu thêm</a>
            </div>
        </div>
    </section>
</div>

<style>
    .premium-page {
        min-height: 100vh;
        background: #ffffff;
    }

    /* Hero Section */
    .premium-hero {
        background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
        color: white;
        padding: 100px 20px;
        text-align: center;
    }

    .premium-hero .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 20px;
        line-height: 1.2;
    }

    .hero-subtitle {
        font-size: 20px;
        opacity: 0.9;
        margin-bottom: 40px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        padding: 14px 32px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: #F97316;
        color: white;
    }

    .btn-primary:hover {
        background: #ea580c;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 2px solid white;
    }

    .btn-secondary:hover {
        background: white;
        color: #1e40af;
    }

    .btn-outline {
        background: transparent;
        color: #6b7280;
        border: 2px solid #d1d5db;
        cursor: not-allowed;
    }

    /* Feature Comparison */
    .feature-comparison {
        padding: 80px 20px;
        background: #f9fafb;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-title {
        font-size: 36px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 50px;
        color: #111827;
    }

    .comparison-table {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .comparison-table table {
        width: 100%;
        border-collapse: collapse;
    }

    .comparison-table thead {
        background: #1e40af;
        color: white;
    }

    .comparison-table th {
        padding: 20px;
        text-align: left;
        font-weight: 600;
    }

    .comparison-table td {
        padding: 20px;
        border-bottom: 1px solid #e5e7eb;
    }

    .comparison-table tbody tr:hover {
        background: #f9fafb;
    }

    .comparison-table td:first-child {
        font-weight: 500;
    }

    /* Pricing Section */
    .pricing-section {
        padding: 80px 20px;
        background: white;
    }

    .pricing-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        max-width: 1000px;
        margin: 0 auto;
    }

    .pricing-card {
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 40px 30px;
        text-align: center;
        position: relative;
        transition: all 0.3s;
    }

    .pricing-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .pricing-card.featured {
        border-color: #F97316;
        transform: scale(1.05);
    }

    .pricing-card.current {
        border-color: #10b981;
        background: #f0fdf4;
    }

    .current-plan-badge {
        background: rgba(255, 255, 255, 0.2);
        padding: 12px 24px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 20px;
    }

    .current-plan-badge span {
        display: block;
        font-weight: 600;
    }

    .expires-text {
        font-size: 14px;
        opacity: 0.9;
        margin-top: 5px;
    }

    .pricing-card .badge {
        position: absolute;
        top: -15px;
        left: 50%;
        transform: translateX(-50%);
        background: #F97316;
        color: white;
        padding: 6px 20px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .pricing-card h3 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #111827;
    }

    .price {
        font-size: 36px;
        font-weight: 700;
        color: #1e40af;
        margin-bottom: 10px;
    }

    .price span {
        font-size: 18px;
        color: #6b7280;
        font-weight: 400;
    }

    .savings {
        color: #10b981;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .features-list {
        list-style: none;
        padding: 0;
        margin: 30px 0;
        text-align: left;
    }

    .features-list li {
        padding: 10px 0;
        color: #374151;
        position: relative;
        padding-left: 25px;
    }

    .features-list li:before {
        content: "✓";
        position: absolute;
        left: 0;
        color: #10b981;
        font-weight: bold;
    }

    /* Premium Features */
    .premium-features {
        padding: 80px 20px;
        background: #f9fafb;
    }

    .features-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .feature-item {
        display: flex;
        gap: 20px;
        margin-bottom: 40px;
    }

    .feature-icon {
        font-size: 48px;
        flex-shrink: 0;
    }

    .feature-text h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 8px;
        color: #111827;
    }

    .feature-text p {
        color: #6b7280;
        line-height: 1.6;
    }

    .features-image {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .phone-mockup {
        width: 300px;
        height: 600px;
        background: #1e40af;
        border-radius: 30px;
        padding: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .phone-screen {
        width: 100%;
        height: 100%;
        background: white;
        border-radius: 20px;
        overflow: hidden;
    }

    .map-preview {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
        position: relative;
    }

    .map-preview:before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 80%;
        height: 80%;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%231e40af"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>') no-repeat center;
        background-size: contain;
        opacity: 0.3;
    }

    /* Testimonials */
    .testimonials {
        padding: 80px 20px;
        background: white;
    }

    .testimonials-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
    }

    .testimonial-card {
        background: #f9fafb;
        padding: 30px;
        border-radius: 12px;
        transition: all 0.3s;
    }

    .testimonial-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .stars {
        color: #fbbf24;
        font-size: 20px;
        margin-bottom: 15px;
    }

    .testimonial-text {
        font-size: 16px;
        line-height: 1.6;
        color: #374151;
        margin-bottom: 20px;
        font-style: italic;
    }

    .testimonial-author {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .author-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #1e40af;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 18px;
    }

    .author-name {
        font-weight: 600;
        color: #111827;
    }

    .author-role {
        font-size: 14px;
        color: #6b7280;
    }

    /* CTA Section */
    .cta-section {
        background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
        color: white;
        padding: 80px 20px;
        text-align: center;
    }

    .cta-title {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .cta-actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    @@media (max-width: 768px) {
        .premium-hero {
            padding: 60px 20px;
        }

        .hero-title {
            font-size: 32px;
        }

        .hero-subtitle {
            font-size: 18px;
        }

        .hero-actions {
            flex-direction: column;
            width: 100%;
        }

        .hero-actions .btn {
            width: 100%;
        }

        .section-title {
            font-size: 28px;
        }

        .feature-comparison,
        .pricing-section,
        .premium-features,
        .testimonials,
        .cta-section {
            padding: 60px 20px;
        }

        .comparison-table {
            overflow-x: auto;
        }

        .comparison-table table {
            min-width: 600px;
        }

        .comparison-table th,
        .comparison-table td {
            padding: 15px 10px;
            font-size: 14px;
        }

        .pricing-cards {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .pricing-card.featured {
            transform: scale(1);
        }

        .pricing-card {
            padding: 30px 20px;
        }

        .features-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .feature-item {
            flex-direction: column;
            text-align: center;
            margin-bottom: 30px;
        }

        .feature-icon {
            font-size: 40px;
        }

        .phone-mockup {
            width: 200px;
            height: 400px;
        }

        .testimonials-grid {
            grid-template-columns: 1fr;
        }

        .cta-title {
            font-size: 28px;
        }

        .cta-actions {
            flex-direction: column;
        }

        .cta-actions .btn {
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .hero-title {
            font-size: 24px;
        }

        .hero-subtitle {
            font-size: 16px;
        }

        .section-title {
            font-size: 24px;
        }

        .price {
            font-size: 28px;
        }

        .phone-mockup {
            width: 180px;
            height: 360px;
        }
    }
</style>
