@{
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="hero">
    <div class="container">
        <h1>La Bàn Cho Chuyến Đi Của Bạn</h1>
        <p class="subtitle">Khám phá nhiều hơn, lên kế hoạch ít hơn.</p>
        <p class="desc">
            Bạn chọn điểm đến. Chúng tôi xây dựng chuyến đi hoàn hảo:
            Nơi ở, Ẩm thực và Hoạt động
        </p>

        <!-- Above-the-fold CTA -->
        <div class="home-hero-cta">
            <a class="home-btn home-btn-primary" href="/Review/Reviews">Tìm địa điểm để đi ngay</a>
            <a class="home-btn home-btn-secondary" href="/Review/Create">Viết đánh giá đầu tiên của bạn</a>
        </div>

        <div class="hero-image">
            <img src="~/images/hoi-an.jpg" />
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="how-it-works">
    <div class="container">
        <h2>Cách Hoạt Động?</h2>
        <p class="section-desc">Biến ý tưởng thành lịch trình trong vài giây</p>

        <div class="step">
            <div class="step-text">
                <h3>Bước 1: Chọn Điểm Đến</h3>
                <p>Bạn chỉ cần cho chúng tôi biết nơi bạn muốn đến.</p>
                <a class="primary-btn" href="/Map/Nearby" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Khám phá địa điểm gần bạn</a>
            </div>
            <img src="~/images/map.jpg" />
        </div>

        <div class="step reverse">
            <div class="step-text">
                <h3>Bước 2: Nhận Gợi Ý 3 trong 1</h3>
                <p>
                    Chúng tôi ngay lập tức tích hợp và đề xuất các lựa chọn tốt nhất
                    về Nơi ở, Ẩm thực và Hoạt động dành riêng cho bạn.
                </p>
            </div>
            <img src="~/images/street.jpg" />
        </div>

        <div class="step">
            <div class="step-text">
                <h3>Bước 3: Tận Hưởng Chuyến Đi</h3>
                <p>
                    Ngừng lãng phí thời gian vào những tìm kiếm rời rạc.
                    Tận hưởng chuyến đi suôn sẻ với la bàn thông minh của bạn, TripCompass.
                </p>
                <div class="home-inline-cta">
                    <a class="primary-btn" href="/Review/Reviews" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Khám phá địa điểm</a>
                    <a class="secondary-btn" href="/Review/Create" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Bắt đầu viết đánh giá</a>
                </div>
            </div>
            <img src="~/images/bike.jpg" />
        </div>
    </div>
</section>

<!-- COMPASS INFO -->
<section class="compass-info">
    <div class="container center">
        <h2>La Bàn Của Bạn Có Gì?</h2>
        <p>La bàn dành cho du khách thông minh</p>
        <div class="home-inline-cta center">
            <a class="primary-btn" href="/Review/Reviews" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Khám phá địa điểm</a>
            <a class="secondary-btn" href="/Review/PartnerRegistration" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Đăng ký trở thành đối tác</a>
        </div>
    </div>
</section>

<!-- INSPIRATION -->
<section class="inspiration">
    <div class="container">
        <h2 id="homeFeatured">Cảm Hứng Du Lịch</h2>
        <p class="section-desc">
            Không biết đi đâu? Hãy để TripCompass gợi ý những hành trình hot nhất ngay bây giờ!
        </p>

        <div class="places">
            <div class="place">
                <img src="~/images/phu-quoc.jpg" />
                <span>Phú Quốc</span>
            </div>
            <div class="place">
                <img src="~/images/hagiang.jpg" />
                <span>Hà Giang</span>
            </div>
            <div class="place">
                <img src="~/images/hoian.jpg" />
                <span>Hội An</span>
            </div>
            <div class="place">
                <img src="~/images/dalat.jpg" />
                <span>Đà Lạt</span>
            </div>
        </div>

        <div class="cta">
            <h2>Ngừng Lên Kế Hoạch Mệt Mỏi. Bắt Đầu Khám Phá</h2>
            <p>Bạn chỉ cần xếp hành lý và đi. Hãy để TripCompass lo việc lên kế hoạch.</p>
            <div class="home-inline-cta">
                <a class="primary-btn big" href="/Review/Reviews" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Khám phá địa điểm</a>
                <a class="secondary-btn big" href="/Review/Create" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">Viết đánh giá</a>
            </div>
        </div>

        <div class="cta-image">
            <img src="~/images/terract.jpg" />
        </div>
    </div>
</section>

<!-- PRE-FOOTER CTA BANNER -->
<section class="home-prefooter-cta">
    <div class="container home-prefooter-inner">
        <div class="home-prefooter-text">
            <h2>Sẵn sàng lên kế hoạch chuyến đi tiếp theo?</h2>
            <p>Khám phá địa điểm, đọc đánh giá thật và bắt đầu hành trình của bạn ngay hôm nay.</p>
        </div>
        <div class="home-prefooter-actions">
            <a class="home-btn home-btn-primary" href="/Review/Reviews">Khám phá địa điểm</a>
            <a class="home-btn home-btn-secondary" href="/Review/Create">Viết đánh giá</a>
        </div>
    </div>
</section>
