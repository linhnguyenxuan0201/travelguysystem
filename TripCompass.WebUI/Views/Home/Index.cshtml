@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="hero">
    <div class="container">
        <h1>Compass For Your Trips</h1>
        <p class="subtitle">Discover more, plan less.</p>
        <p class="desc">
            You choose the destination. We build the perfect trip:
            Stays, Food, and Things to Do
        </p>

        <div class="hero-image">
            <img src="~/images/hoi-an.jpg" />
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="how-it-works">
    <div class="container">
        <h2>How It Works?</h2>
        <p class="section-desc">Turn ideas into itineraries in seconds</p>

        <div class="step">
            <div class="step-text">
                <h3>Step 1: Pick Your Destination</h3>
                <p>You just tell us where you want to go.</p>
                <button class="primary-btn">See where you're going</button>
            </div>
            <img src="~/images/map.jpg" />
        </div>

        <div class="step reverse">
            <div class="step-text">
                <h3>Step 2: Get 3-in-1 Suggestions</h3>
                <p>
                    We instantly integrate and recommend the best options
                    for Stay, Food, and Activities just for you.
                </p>
            </div>
            <img src="~/images/street.jpg" />
        </div>

        <div class="step">
            <div class="step-text">
                <h3>Step 3: Enjoy Your Trip</h3>
                <p>
                    Stop wasting time on scattered searches.
                    Enjoy a seamless trip with your smart compass, TripCompass.
                </p>
            </div>
            <img src="~/images/bike.jpg" />
        </div>
    </div>
</section>

<!-- COMPASS INFO -->
<section class="compass-info">
    <div class="container center">
        <h2>What's in your Compass?</h2>
        <p>The compass for the smart traveler</p>
        <button class="primary-btn">Explore more</button>
    </div>
</section>

<!-- INSPIRATION -->
<section class="inspiration">
    <div class="container">
        <h2>Trip Inspiration</h2>
        <p class="section-desc">
            Don't know where to go? Let TripCompass suggest the hottest journeys right now!
        </p>

        <div class="places">
            <div class="place">
                <img src="~/images/phu-quoc.jpg" />
                <span>Phu Quoc</span>
            </div>
            <div class="place">
                <img src="~/images/hagiang.jpg" />
                <span>Ha Giang</span>
            </div>
            <div class="place">
                <img src="~/images/hoian.jpg" />
                <span>Hoi An</span>
            </div>
            <div class="place">
                <img src="~/images/dalat.jpg" />
                <span>Da Lat</span>
            </div>
        </div>

        <div class="cta">
            <h2>Stop the Tiring Planning. Start Exploring</h2>
            <p>You just need to pack your bags and go. Let TripCompass handle the planning.</p>
            <button class="primary-btn big">Plan Your First Trip Now!</button>
        </div>

        <div class="cta-image">
            <img src="~/images/terract.jpg" />
        </div>
    </div>
</section>
