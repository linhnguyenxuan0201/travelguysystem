@using TripCompass.Application.Auth
@using TripCompass.Application.DTOs
@using TripCompass.WebUI.ViewModels
@using System.Security.Claims
@inject UserContextService UserContext
@inject TripCompass.Infrastructure.Persistence.AppDbContext Db
@using Microsoft.EntityFrameworkCore

@{
    UserDropdownViewModel? userDropdown = null;
    bool isBanned = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        // ✅ LẤY EMAIL TỪ CLAIM (ĐÚNG)
        var email = User.FindFirstValue(ClaimTypes.Email);

        if (!string.IsNullOrEmpty(email))
        {
            // 👉 Application trả DTO
            UserDropdownDto? dto = await UserContext.GetDropdownAsync(email);

            // 👉 MAP DTO → VIEWMODEL (BẮT BUỘC)
            if (dto != null)
            {
                userDropdown = new UserDropdownViewModel
                {
                    UserName = dto.UserName,
                    AvatarUrl = dto.AvatarUrl,
                    ReputationLevel = dto.ReputationLevel,
                    ReputationScore = dto.ReputationScore,
                    WalletBalance = dto.WalletBalance
                };
            }
        }

        // Check banned status from DB (real-time)
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (long.TryParse(userIdStr, out var uid))
        {
            isBanned = await Db.Users.AsNoTracking().AnyAsync(u => u.UserId == uid && u.IsBanned);
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TripCompass</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" />

</head>
<body>

    @if (User.Identity?.IsAuthenticated == true && isBanned)
    {
        <div id="banned-overlay">
            <div class="banned-card">
                <div class="banned-title">⚠️ Tài khoản đã bị khóa</div>
                <div class="banned-text">Vui lòng liên hệ quản trị viên để được hỗ trợ.</div>
                <div class="banned-actions">
                    <a class="btn-logout" href="/Account/Logout">Đăng xuất</a>
                    <button class="btn-dismiss" type="button" onclick="dismissBannedBanner()">Để sau</button>
                </div>
            </div>
        </div>
        <style>
            #banned-overlay {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.4);
                backdrop-filter: blur(4px);
                z-index: 9999;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding: 16px;
            }
            #banned-overlay.hidden { display: none; }
            .banned-card {
                margin-top: 12px;
                background: #111827;
                color: #fef2f2;
                border: 1px solid #ef4444;
                border-radius: 14px;
                padding: 16px 18px;
                min-width: 320px;
                box-shadow: 0 15px 30px rgba(0,0,0,0.25);
                font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            }
            .banned-title {
                font-weight: 800;
                font-size: 15px;
                margin-bottom: 6px;
            }
            .banned-text {
                font-size: 13px;
                line-height: 1.5;
                margin-bottom: 12px;
                color: #fee2e2;
            }
            .banned-actions {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }
            .btn-logout {
                background: #ef4444;
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 8px 14px;
                text-decoration: none;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(239,68,68,0.35);
            }
            .btn-logout:hover { background: #dc2626; }
            .btn-dismiss {
                background: transparent;
                color: #fef2f2;
                border: 1px solid rgba(255,255,255,0.25);
                border-radius: 10px;
                padding: 8px 14px;
                cursor: pointer;
            }
            .btn-dismiss:hover { border-color: rgba(255,255,255,0.45); }
        </style>
        <script>
            function dismissBannedBanner() {
                const el = document.getElementById('banned-overlay');
                if (el) el.classList.add('hidden');
            }
        </script>
    }

    <!-- ================= HEADER ================= -->
    <header class="header">
        <div class="container header-inner">

            <!-- LOGO -->
            <a class="logo" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="TripCompass Logo" />
                <span>TripCompass</span>
            </a>

            <!-- NAV -->
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index">Explore</a>
                <a asp-controller="Review" asp-action="Reviews">Reviews</a>
                <a href="#">Trips</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-dropdown">
                        <a href="#" class="user-toggle">
                            <img src="@(userDropdown?.AvatarUrl ?? "/images/avatar-default.png")"
                                 class="avatar" />
                            <strong>@User.Identity!.Name</strong>
                            <i class="fa-solid fa-chevron-down"></i>
                        </a>

                        <ul class="user-menu">

                            <!-- USER INFO -->
                            <li class="user-info">
                                <img src="@(userDropdown?.AvatarUrl ?? "/images/avatar-default.png")"
                                     class="avatar-lg" />
                                <div>
                                    <strong>@User.Identity!.Name</strong>

                                    @if (userDropdown != null)
                                    {
                                        <div class="rep">
                                            ⭐ Reputation Lv. @userDropdown.ReputationLevel
                                        </div>
                                        <div class="coin">
                                            🪙 @userDropdown.WalletBalance.ToString("N0") Coins
                                        </div>
                                    }
                                </div>
                            </li>

                            <li class="divider"></li>

                            <li>
                                <a asp-controller="Account" asp-action="Profile">
                                    <i class="fa-regular fa-user"></i> View Profile
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Account" asp-action="ChangePassword">
                                    <i class="fa-solid fa-lock"></i> Change Password
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Review" asp-action="MyReviews">
                                    <i class="fa-solid fa-star"></i> Your Reviews
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a asp-controller="Admin" asp-action="Dashboard">
                                        <i class="fa-solid fa-shield-halved"></i> Admin
                                    </a>
                                </li>
                            }

                            <li class="divider"></li>

                            <li>
                                <a asp-controller="Account" asp-action="Logout" class="logout">
                                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="login-btn">
                        Log in
                    </a>
                }
            </nav>

        </div>
    </header>

    <!-- ================= MAIN ================= -->
    <main>
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <div class="container footer-grid">

            <div class="footer-logo">
                <img src="~/images/logo.png" alt="TripCompass Logo" />
                <p>DISCOVER MORE. PLAN LESS.</p>
            </div>

            <div class="footer-social">
                <h4>TripCompass Social</h4>
                <div class="social-icons">
                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>

            <div class="footer-contact">
                <h4>Contact</h4>
                <p><i class="fa-regular fa-envelope"></i> tripcompassvn@gmail.com</p>
                <p><i class="fa-solid fa-phone"></i> Hotline 1900 0014</p>
            </div>

        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>&copy; @DateTime.Now.Year TripCompass. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Partnership & Upgrade Prompts (sidebar) -->
    <div class="tc-promo-stack" id="tcPromoStack">
        <div class="tc-promo-card" id="partnerPrompt" style="display:none;">
            <button class="tc-promo-close" data-target="partnerPrompt">&times;</button>
            <div class="tc-promo-badge">Đối tác</div>
            <h3>Trở thành đối tác của TripCompass</h3>
            <p>Tham gia cùng chúng tôi để tiếp cận nhiều khách hàng hơn và nhận ưu đãi hoa hồng hấp dẫn.</p>
            <div class="tc-promo-actions">
                <a class="tc-promo-primary" href="/Review/Reviews?partnerOnly=true">Đăng ký ngay</a>
                <button class="tc-promo-secondary" data-dismiss="partnerPrompt">Không hiển thị lại</button>
            </div>
        </div>

        <div class="tc-promo-card" id="upgradePrompt" style="display:none;">
            <button class="tc-promo-close" data-target="upgradePrompt">&times;</button>
            <div class="tc-promo-badge">Nâng cấp</div>
            <h3>Nâng cấp lên phiên bản tiếp theo</h3>
            <p>Mở khóa nhiều tính năng nâng cao hơn, ưu đãi riêng và hỗ trợ nhanh chóng.</p>
            <div class="tc-promo-actions">
                <a class="tc-promo-primary" href="/Account/Profile">Nâng cấp ngay</a>
                <button class="tc-promo-secondary" data-dismiss="upgradePrompt">Không hiển thị lại</button>
            </div>
        </div>
    </div>

    <style>
        /* Banner-style promo (ad-like) */
        .tc-promo-stack {
            position: fixed;
            right: 12px;
            bottom: 12px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 14px;
            pointer-events: none;
        }

        .tc-promo-card {
            pointer-events: auto;
            width: 300px;
            height: 250px; /* classic ad size */
            max-width: calc(100vw - 24px);
            border-radius: 14px;
            position: relative;
            overflow: hidden;
            border: 2px solid rgba(79,70,229,0.35);
            box-shadow: 0 18px 40px rgba(0,0,0,0.18);
            background:
                radial-gradient(120px 120px at 20% 20%, rgba(255,255,255,0.25), transparent 60%),
                linear-gradient(135deg, #1e40af 0%, #4F46E5 55%, #0b1020 100%);
            color: #fff;
            animation: tcBannerBlink 0.9s steps(2, end) infinite, tcBannerFloat 3.2s ease-in-out infinite;
        }

        @@keyframes tcBannerBlink {
            0%, 100% { filter: brightness(1); border-color: rgba(79,70,229,0.35); }
            50% { filter: brightness(1.25); border-color: rgba(255,255,255,0.55); }
        }

        @@keyframes tcBannerFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }

        .tc-promo-card::before {
            content: "AD";
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.25);
            color: #fff;
            font-weight: 800;
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 999px;
            letter-spacing: 0.5px;
        }

        .tc-promo-close {
            position: absolute;
            top: 10px;
            right: 10px;
            border: none;
            background: rgba(255,255,255,0.18);
            color: #fff;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }
        .tc-promo-close:hover { background: rgba(255,255,255,0.28); }

        .tc-promo-badge {
            display: inline-block;
            margin: 16px 16px 8px 16px;
            background: rgba(255,255,255,0.18);
            border: 1px solid rgba(255,255,255,0.22);
            color: #fff;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
        }

        .tc-promo-card h3 {
            margin: 0 16px 8px 16px;
            font-size: 18px;
            line-height: 1.2;
            font-weight: 900;
        }

        .tc-promo-card p {
            margin: 0 16px 14px 16px;
            font-size: 13px;
            line-height: 1.45;
            opacity: 0.95;
        }

        .tc-promo-actions {
            position: absolute;
            left: 16px;
            right: 16px;
            bottom: 14px;
            display: flex;
            gap: 10px;
        }

        .tc-promo-primary, .tc-promo-secondary {
            flex: 1;
            height: 42px;
            border-radius: 10px;
            font-weight: 900;
            font-size: 13px;
            letter-spacing: 0.2px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.08s ease, filter 0.2s ease;
        }

        .tc-promo-primary {
            background: #fff;
            color: #111827;
        }
        .tc-promo-secondary {
            background: rgba(0,0,0,0.28);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.25);
        }
        .tc-promo-primary:hover, .tc-promo-secondary:hover { filter: brightness(1.05); }
        .tc-promo-primary:active, .tc-promo-secondary:active { transform: scale(0.98); }

        @@media (max-width: 768px) {
            .tc-promo-stack {
                right: 10px;
                bottom: 10px;
            }
            .tc-promo-card {
                width: 280px;
                height: 220px;
            }
        }
    </style>

    <!-- JS -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.querySelector(".user-toggle");
            const menu = document.querySelector(".user-menu");

            if (!toggle || !menu) return;

            toggle.addEventListener("click", function (e) {
                e.preventDefault();
                menu.classList.toggle("show");
            });

            document.addEventListener("click", function (e) {
                if (!e.target.closest(".user-dropdown")) {
                    menu.classList.remove("show");
                }
            });

            // Promo modals - chỉ ẩn trong phiên hiện tại, refresh sẽ hiện lại
            let partnerDismissed = false;
            let upgradeDismissed = false;

            function showModal(id) {
                const el = document.getElementById(id);
                if (el) el.style.display = "block";
            }

            function hideModal(id) {
                const el = document.getElementById(id);
                if (el) el.style.display = "none";
            }

            // Close buttons
            document.querySelectorAll(".tc-promo-close").forEach(btn => {
                btn.addEventListener("click", () => hideModal(btn.dataset.target));
            });

            // Dismiss buttons - chỉ ẩn trong phiên này
            document.querySelectorAll(".tc-promo-secondary").forEach(btn => {
                btn.addEventListener("click", () => {
                    const target = btn.dataset.dismiss;
                    if (target === "partnerPrompt") partnerDismissed = true;
                    if (target === "upgradePrompt") upgradeDismissed = true;
                    hideModal(target);
                });
            });

            // Auto show with slight delay - luôn hiện khi chưa dismiss trong phiên này
            setTimeout(() => {
                if (!partnerDismissed) {
                    showModal("partnerPrompt");
                }
            }, 800);

            setTimeout(() => {
                if (!upgradeDismissed) {
                    showModal("upgradePrompt");
                }
            }, 1600);
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
