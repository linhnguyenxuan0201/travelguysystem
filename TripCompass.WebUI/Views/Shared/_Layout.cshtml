@using TripCompass.Application.Auth
@using TripCompass.Application.DTOs
@using TripCompass.WebUI.ViewModels
@using System.Security.Claims
@inject UserContextService UserContext
@inject TripCompass.Infrastructure.Persistence.AppDbContext Db
@using Microsoft.EntityFrameworkCore

@{
    UserDropdownViewModel? userDropdown = null;
    bool isBanned = false;
    bool isPartner = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        // ✅ LẤY EMAIL TỪ CLAIM (ĐÚNG)
        var email = User.FindFirstValue(ClaimTypes.Email);

        // Kiểm tra role Partner
        isPartner = User.IsInRole("Partner");

        if (!string.IsNullOrEmpty(email))
        {
            // 👉 Application trả DTO
            UserDropdownDto? dto = await UserContext.GetDropdownAsync(email);

            // 👉 MAP DTO → VIEWMODEL (BẮT BUỘC)
            if (dto != null)
            {
                userDropdown = new UserDropdownViewModel
                {
                    UserName = dto.UserName,
                    AvatarUrl = dto.AvatarUrl,
                    ReputationLevel = dto.ReputationLevel,
                    ReputationScore = dto.ReputationScore,
                    WalletBalance = dto.WalletBalance
                };
            }
        }

        // Check banned status from DB (real-time)
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (long.TryParse(userIdStr, out var uid))
        {
            isBanned = await Db.Users.AsNoTracking().AnyAsync(u => u.UserId == uid && u.IsBanned);
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TripCompass</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

    @if (User.Identity?.IsAuthenticated == true && isBanned)
    {
        <div id="banned-overlay">
            <div class="banned-card">
                <div class="banned-title">⚠️ Tài khoản đã bị khóa</div>
                <div class="banned-text">Vui lòng liên hệ quản trị viên để được hỗ trợ.</div>
                <div class="banned-actions">
                    <a class="btn-logout" href="/Account/Logout">Đăng xuất</a>
                    <button class="btn-dismiss" type="button" onclick="dismissBannedBanner()">Để sau</button>
                </div>
            </div>
        </div>
        <style>
            #banned-overlay {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.4);
                backdrop-filter: blur(4px);
                z-index: 9999;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding: 16px;
            }
            #banned-overlay.hidden { display: none; }
            .banned-card {
                margin-top: 12px;
                background: #111827;
                color: #fef2f2;
                border: 1px solid #ef4444;
                border-radius: 14px;
                padding: 16px 18px;
                min-width: 320px;
                box-shadow: 0 15px 30px rgba(0,0,0,0.25);
                font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            }
            .banned-title {
                font-weight: 800;
                font-size: 15px;
                margin-bottom: 6px;
            }
            .banned-text {
                font-size: 13px;
                line-height: 1.5;
                margin-bottom: 12px;
                color: #fee2e2;
            }
            .banned-actions {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }
            .btn-logout {
                background: #ef4444;
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 8px 14px;
                text-decoration: none;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(239,68,68,0.35);
            }
            .btn-logout:hover { background: #dc2626; }
            .btn-dismiss {
                background: transparent;
                color: #fef2f2;
                border: 1px solid rgba(255,255,255,0.25);
                border-radius: 10px;
                padding: 8px 14px;
                cursor: pointer;
            }
            .btn-dismiss:hover { border-color: rgba(255,255,255,0.45); }
        </style>
        <script>
            function dismissBannedBanner() {
                const el = document.getElementById('banned-overlay');
                if (el) el.classList.add('hidden');
            }
        </script>
    }

    <!-- ================= HEADER ================= -->
    <header class="header">
        <div class="container header-inner">

            <!-- LOGO -->
            <a class="logo" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="TripCompass Logo" />
                <span>TripCompass</span>
            </a>

            <!-- NAV -->
            <nav class="nav">
                <a asp-controller="Home" asp-action="Index">Khám phá</a>
                <a asp-controller="Review" asp-action="Reviews">Đánh giá</a>
                <a href="#">Chuyến đi</a>
            </nav>

            <!-- RIGHT SIDE: Notifications, Chat, User -->
            <div class="header-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- NOTIFICATION BELL -->
                    <div class="notification-bell" id="notificationBell">
                        <button class="bell-link" onclick="toggleNotificationDropdown(event)">
                            <i class="fa-solid fa-bell"></i>
                            <span class="notification-badge" id="notificationBadge" style="display: none;">0</span>
                        </button>
                        <div class="notification-dropdown" id="notificationDropdown" style="display: none;">
                            <div class="notification-dropdown-header">
                                <h3>Thông báo</h3>
                                <a href="/Account/Notifications" class="view-all-link">Xem tất cả</a>
                            </div>
                            <div class="notification-dropdown-content" id="notificationDropdownContent">
                                <div class="notification-loading">
                                    <i class="fa-solid fa-spinner fa-spin"></i> Đang tải...
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CHAT BELL -->
                    <div class="chat-bell" id="chatBell">
                        <button class="bell-link" onclick="toggleChatDropdown(event)">
                            <i class="fa-solid fa-comments"></i>
                            <span class="chat-badge" id="chatBadge" style="display: none;">0</span>
                        </button>
                        <div class="chat-dropdown" id="chatDropdown" style="display: none;">
                            <div class="chat-dropdown-header">
                                <h3>Tin nhắn</h3>
                                <a href="/Chat" class="view-all-link">Xem tất cả</a>
                            </div>
                            <div class="chat-dropdown-content" id="chatDropdownContent">
                                <div class="chat-loading">
                                    <i class="fa-solid fa-spinner fa-spin"></i> Đang tải...
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="user-dropdown">
                        <a href="#" class="user-toggle">
                            <img src="@(userDropdown?.AvatarUrl ?? "/images/avatar-default.png")"
                                 class="avatar" />
                            <strong>@User.Identity!.Name</strong>
                            <i class="fa-solid fa-chevron-down"></i>
                        </a>

                        <ul class="user-menu">

                            <!-- USER INFO -->
                            <li class="user-info">
                                <img src="@(userDropdown?.AvatarUrl ?? "/images/avatar-default.png")"
                                     class="avatar-lg" />
                                <div>
                                    <strong>@User.Identity!.Name</strong>

                                    @if (userDropdown != null)
                                    {
                                        <div class="rep">
                                            ⭐ Reputation Lv. @userDropdown.ReputationLevel
                                        </div>
                                        <div class="coin">
                                            🪙 @userDropdown.ReputationScore.ToString("N0") Coins
                                        </div>
                                    }
                                </div>
                            </li>

                            <li class="divider"></li>

                            <li>
                                <a asp-controller="Account" asp-action="Profile">
                                    <i class="fa-regular fa-user"></i> Xem hồ sơ
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Account" asp-action="ChangePassword">
                                    <i class="fa-solid fa-lock"></i> Đổi mật khẩu
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Review" asp-action="MyReviews">
                                    <i class="fa-solid fa-star"></i> Đánh giá của bạn
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Account" asp-action="Wallet">
                                    <i class="fa-solid fa-wallet"></i> Ví tiền
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Chat" asp-action="Index">
                                    <i class="fa-solid fa-comments"></i> Tin nhắn
                                </a>
                            </li>

                            @if (User.IsInRole("Partner"))
                            {
                                <li>
                                    <a asp-controller="Partner" asp-action="Dashboard">
                                        <i class="fa-solid fa-store"></i> Quản lý shop
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a asp-controller="Admin" asp-action="Dashboard">
                                        <i class="fa-solid fa-shield-halved"></i> Admin
                                    </a>
                                </li>
                            }

                            <li class="divider"></li>

                            <li>
                                <a asp-controller="Account" asp-action="Logout" class="logout">
                                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="login-btn">
                        Đăng nhập
                    </a>
                }
            </div>

        </div>
    </header>

    <!-- ================= MAIN ================= -->
    <main>
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <div class="container footer-grid">

            <div class="footer-logo">
                <img src="~/images/logo.png" alt="TripCompass Logo" />
                <p>DISCOVER MORE. PLAN LESS.</p>
            </div>

            <div class="footer-social">
                <h4>TripCompass Social</h4>
                <div class="social-icons">
                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>

            <div class="footer-contact">
                <h4>Contact</h4>
                <p><i class="fa-regular fa-envelope"></i> tripcompassvn@gmail.com</p>
                <p><i class="fa-solid fa-phone"></i> Hotline 1900 0014</p>
            </div>

        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>&copy; @DateTime.Now.Year TripCompass. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Partnership & Upgrade Prompts (sidebar) -->
    <div class="tc-promo-stack" id="tcPromoStack">
        @if (!isPartner)
        {
            <div class="tc-promo-card" id="partnerPrompt" style="display:none;">
                <button class="tc-promo-close" data-target="partnerPrompt">&times;</button>
                <div class="tc-promo-badge">Đối tác</div>
                <h3>Trở thành đối tác của TripCompass</h3>
                <p>Tham gia cùng chúng tôi để tiếp cận nhiều khách hàng hơn và nhận ưu đãi hoa hồng hấp dẫn.</p>
                <div class="tc-promo-actions">
                    <button class="tc-promo-primary" onclick="openPartnerAgreementModal()">Đăng ký ngay</button>
                    <button class="tc-promo-secondary" data-dismiss="partnerPrompt">Không hiển thị lại</button>
                </div>
            </div>
        }

        <div class="tc-promo-card" id="upgradePrompt" style="display:none;">
            <button class="tc-promo-close" data-target="upgradePrompt">&times;</button>
            <div class="tc-promo-badge">Nâng cấp</div>
            <h3>Nâng cấp lên phiên bản tiếp theo</h3>
            <p>Mở khóa nhiều tính năng nâng cao hơn, ưu đãi riêng và hỗ trợ nhanh chóng.</p>
            <div class="tc-promo-actions">
                <a class="tc-promo-primary" href="/Account/Profile">Nâng cấp ngay</a>
                <button class="tc-promo-secondary" data-dismiss="upgradePrompt">Không hiển thị lại</button>
            </div>
        </div>
    </div>

    <style>
        /* Banner-style promo (ad-like) */
        .tc-promo-stack {
            position: fixed;
            right: 12px;
            bottom: 12px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 14px;
            pointer-events: none;
        }

        .tc-promo-card {
            pointer-events: auto;
            width: 300px;
            height: 250px; /* classic ad size */
            max-width: calc(100vw - 24px);
            border-radius: 14px;
            position: relative;
            overflow: hidden;
            border: 2px solid rgba(37,99,235,0.4);
            box-shadow: 0 18px 40px rgba(0,0,0,0.18);
            background:
                radial-gradient(120px 120px at 20% 20%, rgba(255,255,255,0.25), transparent 60%),
                linear-gradient(135deg, #2563eb 0%, #1e40af 50%, #1e3a8a 100%);
            color: #fff;
            animation: tcBannerBlink 0.9s steps(2, end) infinite, tcBannerFloat 3.2s ease-in-out infinite;
        }

        @@keyframes tcBannerBlink {
            0%, 100% { filter: brightness(1); border-color: rgba(79,70,229,0.35); }
            50% { filter: brightness(1.25); border-color: rgba(255,255,255,0.55); }
        }

        @@keyframes tcBannerFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }

        .tc-promo-card::before {
            content: "AD";
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0,0,0,0.35);
            border: 1px solid rgba(255,255,255,0.25);
            color: #fff;
            font-weight: 800;
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 999px;
            letter-spacing: 0.5px;
        }

        .tc-promo-close {
            position: absolute;
            top: 10px;
            right: 10px;
            border: none;
            background: rgba(255,255,255,0.18);
            color: #fff;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }
        .tc-promo-close:hover { background: rgba(255,255,255,0.28); }

        .tc-promo-badge {
            display: inline-block;
            margin: 16px 16px 8px 16px;
            background: rgba(255,255,255,0.18);
            border: 1px solid rgba(255,255,255,0.22);
            color: #fff;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
        }

        .tc-promo-card h3 {
            margin: 0 16px 8px 16px;
            font-size: 18px;
            line-height: 1.2;
            font-weight: 900;
        }

        .tc-promo-card p {
            margin: 0 16px 14px 16px;
            font-size: 13px;
            line-height: 1.45;
            opacity: 0.95;
        }

        .tc-promo-actions {
            position: absolute;
            left: 16px;
            right: 16px;
            bottom: 14px;
            display: flex;
            gap: 10px;
        }

        .tc-promo-primary, .tc-promo-secondary {
            flex: 1;
            height: 42px;
            border-radius: 10px;
            font-weight: 900;
            font-size: 13px;
            letter-spacing: 0.2px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.08s ease, filter 0.2s ease;
        }

        .tc-promo-primary {
            background: #fff;
            color: #111827;
        }
        .tc-promo-secondary {
            background: rgba(0,0,0,0.28);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.25);
        }
        .tc-promo-primary:hover, .tc-promo-secondary:hover { filter: brightness(1.05); }
        .tc-promo-primary:active, .tc-promo-secondary:active { transform: scale(0.98); }

        @@media (max-width: 768px) {
            .tc-promo-stack {
                right: 10px;
                bottom: 10px;
            }
            .tc-promo-card {
                width: 280px;
                height: 220px;
            }
        }

        /* Partner Agreement Modal */
        .partner-agreement-modal {
            display: none;
            position: fixed;
            z-index: 10000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.7);
            overflow-y: auto;
        }

        .partner-agreement-modal.active {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .partner-agreement-content {
            background: white;
            border-radius: 16px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            position: relative;
        }

        .partner-agreement-header {
            padding: 24px;
            border-bottom: 2px solid #e5e7eb;
            position: sticky;
            top: 0;
            background: white;
            z-index: 10;
        }

        .partner-agreement-header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: #111827;
        }

        .partner-agreement-body {
            padding: 24px;
            color: #374151;
            line-height: 1.8;
        }

        .partner-agreement-body h3 {
            color: #111827;
            font-size: 18px;
            font-weight: 600;
            margin-top: 24px;
            margin-bottom: 12px;
        }

        .partner-agreement-body h3:first-child {
            margin-top: 0;
        }

        .partner-agreement-body p {
            margin-bottom: 16px;
        }

        .partner-agreement-body ul {
            margin-left: 24px;
            margin-bottom: 16px;
        }

        .partner-agreement-body li {
            margin-bottom: 8px;
        }

        .partner-agreement-footer {
            padding: 24px;
            border-top: 2px solid #e5e7eb;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .partner-agreement-checkbox {
            display: flex;
            align-items: start;
            gap: 12px;
        }

        .partner-agreement-checkbox input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-top: 2px;
            cursor: pointer;
        }

        .partner-agreement-checkbox label {
            cursor: pointer;
            color: #374151;
            font-size: 14px;
            line-height: 1.5;
        }

        .partner-agreement-actions {
            display: flex;
            gap: 12px;
        }

        .btn-agreement-primary {
            flex: 1;
            background: #2563eb;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-agreement-primary:hover {
            background: #1e40af;
        }

        .btn-agreement-primary:disabled {
            background: #9ca3af;
            cursor: not-allowed;
        }

        .btn-agreement-secondary {
            flex: 1;
            background: #f3f4f6;
            color: #374151;
            border: 1px solid #d1d5db;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-agreement-secondary:hover {
            background: #e5e7eb;
        }

        .partner-agreement-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: none;
            border: none;
            font-size: 28px;
            color: #6b7280;
            cursor: pointer;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: background 0.2s;
        }

        .partner-agreement-close:hover {
            background: #f3f4f6;
        }
    </style>

    <!-- JS -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.querySelector(".user-toggle");
            const menu = document.querySelector(".user-menu");

            if (!toggle || !menu) return;

            toggle.addEventListener("click", function (e) {
                e.preventDefault();
                menu.classList.toggle("show");
            });

            document.addEventListener("click", function (e) {
                if (!e.target.closest(".user-dropdown")) {
                    menu.classList.remove("show");
                }
            });

            // Promo modals - chỉ ẩn trong phiên hiện tại, refresh sẽ hiện lại
            let partnerDismissed = false;
            let upgradeDismissed = false;

            function showModal(id) {
                const el = document.getElementById(id);
                if (el) el.style.display = "block";
            }

            function hideModal(id) {
                const el = document.getElementById(id);
                if (el) el.style.display = "none";
            }

            // Close buttons
            document.querySelectorAll(".tc-promo-close").forEach(btn => {
                btn.addEventListener("click", () => hideModal(btn.dataset.target));
            });

            // Dismiss buttons - chỉ ẩn trong phiên này
            document.querySelectorAll(".tc-promo-secondary").forEach(btn => {
                btn.addEventListener("click", () => {
                    const target = btn.dataset.dismiss;
                    if (target === "partnerPrompt") partnerDismissed = true;
                    if (target === "upgradePrompt") upgradeDismissed = true;
                    hideModal(target);
                });
            });

            // Auto show with slight delay - luôn hiện khi chưa dismiss trong phiên này
            setTimeout(() => {
                if (!partnerDismissed) {
                    showModal("partnerPrompt");
                }
            }, 800);

            setTimeout(() => {
                if (!upgradeDismissed) {
                    showModal("upgradePrompt");
                }
            }, 1600);
        });

        // Partner Agreement Modal
        function openPartnerAgreementModal() {
            document.getElementById('partnerAgreementModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closePartnerAgreementModal() {
            document.getElementById('partnerAgreementModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function submitPartnerRegistration() {
            const checkbox = document.getElementById('agreeToTerms');
            
            if (!checkbox || !checkbox.checked) {
                alert('Bạn phải đồng ý với điều khoản hợp tác để trở thành đối tác.');
                return false;
            }

            // Đóng modal và chuyển đến trang đăng ký đối tác để điền đầy đủ thông tin
            closePartnerAgreementModal();
            // Chuyển đến trang form đăng ký
            window.location.href = '/Review/PartnerRegistration';
            return false;
        }
        
        // Đảm bảo hàm này được sử dụng thay vì bất kỳ phiên bản async nào khác
        window.submitPartnerRegistration = submitPartnerRegistration;

        // Close modal when clicking outside
        document.addEventListener('click', function(e) {
            const modal = document.getElementById('partnerAgreementModal');
            if (e.target === modal) {
                closePartnerAgreementModal();
            }
        });
    </script>

    <!-- Partner Agreement Modal -->
    <div id="partnerAgreementModal" class="partner-agreement-modal">
        <div class="partner-agreement-content">
            <button class="partner-agreement-close" onclick="closePartnerAgreementModal()">&times;</button>
            <div class="partner-agreement-header">
                <h2>ĐIỀU KHOẢN HỢP TÁC ĐỐI TÁC</h2>
                <p style="margin: 8px 0 0 0; color: #6b7280; font-size: 14px;">(Có hiệu lực kể từ ngày Đối tác đồng ý đăng ký trên Website) - Phiên bản v1.0</p>
            </div>
            <div class="partner-agreement-body">
                <h3>Điều 1. Định nghĩa và giải thích thuật ngữ</h3>
                <p><strong>1. Website:</strong> Nền tảng cung cấp thông tin và kết nối dịch vụ du lịch do chúng tôi vận hành.</p>
                <p><strong>2. Đối tác:</strong> Cá nhân hoặc tổ chức đăng ký cung cấp dịch vụ du lịch (bao gồm nhưng không giới hạn: tour, vận chuyển, lưu trú, trải nghiệm).</p>
                <p><strong>3. Khách hàng:</strong> Cá nhân sử dụng Website để tìm kiếm và đặt dịch vụ.</p>
                <p><strong>4. Đơn hàng:</strong> Giao dịch đặt dịch vụ được Khách hàng thực hiện thông qua Website.</p>
                <p><strong>5. Phí hoa hồng:</strong> Khoản phí Website được hưởng tương ứng <strong>3% giá trị mỗi Đơn hàng thành công</strong>.</p>

                <h3>Điều 2. Phạm vi hợp tác</h3>
                <p><strong>1.</strong> Website đóng vai trò là <strong>nền tảng trung gian kết nối</strong>, không phải là bên cung cấp dịch vụ du lịch.</p>
                <p><strong>2.</strong> Đối tác là bên <strong>trực tiếp cung cấp dịch vụ</strong> và chịu toàn bộ trách nhiệm liên quan đến dịch vụ đó.</p>
                <p><strong>3.</strong> Website <strong>không tham gia, không thu hộ và không giữ tiền thanh toán</strong> của Khách hàng.</p>

                <h3>Điều 3. Điều kiện trở thành Đối tác</h3>
                <p><strong>1.</strong> Đối tác cam kết:</p>
                <ul>
                    <li>Có đầy đủ năng lực pháp lý theo quy định của pháp luật hiện hành.</li>
                    <li>Cung cấp thông tin đăng ký trung thực, chính xác và cập nhật.</li>
                </ul>
                <p><strong>2.</strong> Website có quyền:</p>
                <ul>
                    <li>Từ chối hoặc chấm dứt hợp tác nếu phát hiện thông tin sai lệch hoặc hành vi vi phạm.</li>
                </ul>

                <h3>Điều 4. Giá dịch vụ và thanh toán</h3>
                <p><strong>1.</strong> Giá dịch vụ do Đối tác tự xây dựng và công bố trên Website.</p>
                <p><strong>2.</strong> Khách hàng <strong>thanh toán trực tiếp cho Đối tác</strong> thông qua hình thức thanh toán do Đối tác cung cấp.</p>
                <p><strong>3.</strong> Website không chịu trách nhiệm đối với:</p>
                <ul>
                    <li>Việc thanh toán giữa Khách hàng và Đối tác</li>
                    <li>Tranh chấp phát sinh liên quan đến thanh toán</li>
                </ul>

                <h3>Điều 5. Phí hoa hồng</h3>
                <p><strong>1.</strong> Đối tác đồng ý thanh toán cho Website <strong>phí hoa hồng tương đương 3%</strong> giá trị mỗi Đơn hàng được xác nhận là thành công.</p>
                <p><strong>2.</strong> Đơn hàng thành công là đơn hàng:</p>
                <ul>
                    <li>Được Khách hàng thanh toán đầy đủ cho Đối tác</li>
                    <li>Được Đối tác xác nhận đã tiếp nhận dịch vụ</li>
                </ul>
                <p><strong>3.</strong> Việc thanh toán phí hoa hồng được thực hiện:</p>
                <ul>
                    <li>Theo định kỳ (tuần/tháng) <strong>hoặc</strong></li>
                    <li>Theo thông báo đối soát từ Website</li>
                </ul>

                <h3>Điều 6. Quyền và nghĩa vụ của Đối tác</h3>
                <p><strong>1.</strong> Đối tác có trách nhiệm:</p>
                <ul>
                    <li>Cung cấp dịch vụ đúng nội dung đã công bố.</li>
                    <li>Đảm bảo chất lượng, an toàn và quyền lợi của Khách hàng.</li>
                    <li>Chủ động xử lý các yêu cầu, khiếu nại của Khách hàng.</li>
                </ul>
                <p><strong>2.</strong> Đối tác chịu hoàn toàn trách nhiệm pháp lý đối với:</p>
                <ul>
                    <li>Chất lượng dịch vụ</li>
                    <li>Thiệt hại phát sinh trong quá trình cung cấp dịch vụ</li>
                </ul>

                <h3>Điều 7. Quyền và nghĩa vụ của Website</h3>
                <p><strong>1.</strong> Website có trách nhiệm:</p>
                <ul>
                    <li>Cung cấp nền tảng đặt dịch vụ ổn định.</li>
                    <li>Gửi thông tin Đơn hàng đến Đối tác.</li>
                </ul>
                <p><strong>2.</strong> Website không chịu trách nhiệm đối với:</p>
                <ul>
                    <li>Việc thực hiện dịch vụ của Đối tác</li>
                    <li>Các tranh chấp phát sinh giữa Đối tác và Khách hàng</li>
                </ul>

                <h3>Điều 8. Hủy dịch vụ và hoàn tiền</h3>
                <p><strong>1.</strong> Chính sách hủy và hoàn tiền do Đối tác xây dựng và công bố.</p>
                <p><strong>2.</strong> Website chỉ đóng vai trò hỗ trợ chuyển thông tin yêu cầu giữa các bên.</p>

                <h3>Điều 9. Bảo mật thông tin</h3>
                <p><strong>1.</strong> Hai bên cam kết bảo mật thông tin liên quan đến:</p>
                <ul>
                    <li>Khách hàng</li>
                    <li>Giao dịch</li>
                    <li>Dữ liệu kinh doanh</li>
                </ul>
                <p><strong>2.</strong> Việc sử dụng thông tin phải tuân thủ quy định pháp luật hiện hành.</p>

                <h3>Điều 10. Chấm dứt hợp tác</h3>
                <p><strong>1.</strong> Website có quyền đơn phương chấm dứt hợp tác nếu Đối tác:</p>
                <ul>
                    <li>Vi phạm điều khoản</li>
                    <li>Gây ảnh hưởng đến uy tín Website</li>
                </ul>
                <p><strong>2.</strong> Đối tác có quyền chấm dứt hợp tác bằng cách thông báo trước bằng văn bản.</p>

                <h3>Điều 11. Giải quyết tranh chấp</h3>
                <p><strong>1.</strong> Mọi tranh chấp phát sinh sẽ được ưu tiên giải quyết thông qua thương lượng.</p>
                <p><strong>2.</strong> Trường hợp không đạt được thỏa thuận, tranh chấp sẽ được giải quyết theo quy định pháp luật Việt Nam.</p>

                <h3>Điều 12. Điều khoản chung</h3>
                <p><strong>1.</strong> Việc Đối tác đăng ký và sử dụng Website được xem là đã đọc, hiểu và đồng ý toàn bộ Điều khoản này.</p>
                <p><strong>2.</strong> Website có quyền sửa đổi, bổ sung Điều khoản và sẽ thông báo công khai trên Website.</p>
            </div>
            <div class="partner-agreement-footer">
                <div class="partner-agreement-checkbox">
                    <input type="checkbox" id="agreeToTerms" required>
                    <label for="agreeToTerms">Tôi đã đọc và đồng ý với toàn bộ điều khoản hợp tác đối tác trên đây <span style="color: #dc2626;">*</span></label>
                </div>
                <div class="partner-agreement-actions">
                    <button class="btn-agreement-secondary" onclick="closePartnerAgreementModal()">Hủy</button>
                    <button class="btn-agreement-primary" id="submitPartnerBtn" onclick="submitPartnerRegistration()">Đăng ký làm đối tác</button>
                </div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
        <script>
            // ==================== SIGNALR CONNECTIONS ====================
            let usePolling = false;
            let notificationPollingInterval = null;
            let chatPollingInterval = null;

            // Notification Hub
            const notificationConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/notifications")
                .build();

            notificationConnection.on("NotificationReceived", function (notification, unreadCount) {
                updateNotificationBadge(unreadCount);
                
                // Reload dropdown if it's open
                if (notificationDropdownOpen) {
                    loadNotificationDropdown();
                }
            });

            notificationConnection.on("UnreadCountUpdated", function (unreadCount) {
                updateNotificationBadge(unreadCount);
            });

            notificationConnection.start()
                .then(function () {
                    console.log("Notification hub connected");
                    loadNotificationCount();
                })
                .catch(function (err) {
                    console.error("Notification hub connection error:", err);
                    enablePolling();
                });

            // Chat Hub
            const chatConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat")
                .build();

            chatConnection.on("ChatUnreadCountUpdated", function (unreadCount) {
                updateChatBadge(unreadCount);
            });

            chatConnection.on("MessageReceived", function (threadId, messageId, content, senderName, sentAt, imageUrl, messageType) {
                // If chat modal is open for this thread, add message
                if (currentChatThreadId && currentChatThreadId === threadId) {
                    const currentUserId = '@ViewContext.HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
                    const isMine = senderName === '@User.Identity.Name';
                    addChatModalMessage(messageId, content, senderName, sentAt, isMine, imageUrl, messageType);
                    scrollChatModalToBottom();
                }
                
                // Reload dropdown if it's open
                if (chatDropdownOpen) {
                    loadChatDropdown();
                }
                
                // Update unread count
                loadChatUnreadCount();
            });

            chatConnection.start()
                .then(function () {
                    console.log("Chat hub connected");
                    loadChatUnreadCount();
                })
                .catch(function (err) {
                    console.error("Chat hub connection error:", err);
                    enablePolling();
                });

            // ==================== POLLING (FALLBACK) ====================
            function enablePolling() {
                if (usePolling) return;
                usePolling = true;
                console.log("Falling back to polling mode");

                notificationPollingInterval = setInterval(loadNotificationCount, 30000);
                chatPollingInterval = setInterval(loadChatUnreadCount, 30000);
            }

            function disablePolling() {
                if (!usePolling) return;
                usePolling = false;
                
                if (notificationPollingInterval) {
                    clearInterval(notificationPollingInterval);
                    notificationPollingInterval = null;
                }
                
                if (chatPollingInterval) {
                    clearInterval(chatPollingInterval);
                    chatPollingInterval = null;
                }
            }

            // Reconnect handlers
            notificationConnection.onclose(function () {
                console.log("Notification hub disconnected, enabling polling");
                enablePolling();
            });

            chatConnection.onclose(function () {
                console.log("Chat hub disconnected, enabling polling");
                enablePolling();
            });

            // ==================== NOTIFICATION DROPDOWN ====================
            let notificationDropdownOpen = false;

            function closeNotificationDropdown() {
                const dropdown = document.getElementById('notificationDropdown');
                if (dropdown) dropdown.style.display = 'none';
                notificationDropdownOpen = false;
            }

            function closeChatDropdown() {
                const dropdown = document.getElementById('chatDropdown');
                if (dropdown) dropdown.style.display = 'none';
                chatDropdownOpen = false;
            }

            function closeUserMenu() {
                const menu = document.querySelector('.user-menu');
                if (menu) menu.classList.remove('show');
            }

            function toggleNotificationDropdown(event) {
                event.preventDefault();
                event.stopPropagation();
                
                // Close other dropdowns
                closeChatDropdown();
                closeUserMenu();
                
                const dropdown = document.getElementById('notificationDropdown');
                if (!dropdown) return;

                notificationDropdownOpen = !notificationDropdownOpen;
                
                if (notificationDropdownOpen) {
                    dropdown.style.display = 'flex';
                    loadNotificationDropdown();
                } else {
                    dropdown.style.display = 'none';
                }
            }

            // Close dropdown when clicking outside
            document.addEventListener('click', function(event) {
                const bell = document.getElementById('notificationBell');
                const dropdown = document.getElementById('notificationDropdown');
                
                if (bell && dropdown && !bell.contains(event.target)) {
                    dropdown.style.display = 'none';
                    notificationDropdownOpen = false;
                }
            });

            async function loadNotificationDropdown() {
                const content = document.getElementById('notificationDropdownContent');
                if (!content) return;

                content.innerHTML = '<div class="notification-loading"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải...</div>';

                try {
                    const response = await fetch('/api/notifications?page=1&pageSize=10');
                    if (response.ok) {
                        const notifications = await response.json();
                        renderNotificationDropdown(notifications);
                    } else {
                        content.innerHTML = '<div class="notification-dropdown-empty"><i class="fa-solid fa-exclamation-circle"></i><p>Có lỗi xảy ra khi tải thông báo</p></div>';
                    }
                } catch (error) {
                    console.error('Error loading notifications:', error);
                    content.innerHTML = '<div class="notification-dropdown-empty"><i class="fa-solid fa-exclamation-circle"></i><p>Có lỗi xảy ra khi tải thông báo</p></div>';
                }
            }

            function renderNotificationDropdown(notifications) {
                const content = document.getElementById('notificationDropdownContent');
                if (!content) return;

                if (!notifications || notifications.length === 0) {
                    content.innerHTML = `
                        <div class="notification-dropdown-empty">
                            <i class="fa-solid fa-bell-slash"></i>
                            <p>Bạn chưa có thông báo nào</p>
                        </div>
                    `;
                    return;
                }

                const iconMap = {
                    'NEW_ORDER': 'fa-shopping-cart',
                    'ORDER_APPROVED': 'fa-check-circle',
                    'ORDER_REJECTED': 'fa-times-circle',
                    'NEW_COMMENT': 'fa-comment',
                    'NEW_FOLLOW': 'fa-user-plus',
                    'COMMISSION_PAID': 'fa-money-bill',
                    'WITHDRAW_COMPLETED': 'fa-wallet',
                    'NEW_MESSAGE': 'fa-envelope'
                };

                const itemsHtml = notifications.map(notif => {
                    const icon = iconMap[notif.type] || 'fa-bell';
                    const isUnread = !notif.isRead;
                    const timeAgo = getTimeAgo(notif.createdAt);
                    const link = notif.link || '#';
                    
                    return `
                        <a href="${link}" class="notification-dropdown-item ${isUnread ? 'unread' : ''}" 
                           onclick="markNotificationAsRead(${notif.notificationId}, event)">
                            <div class="notification-dropdown-item-icon">
                                <i class="fa-solid ${icon}"></i>
                            </div>
                            <div class="notification-dropdown-item-content">
                                <div class="notification-dropdown-item-title">${escapeHtml(notif.title)}</div>
                                <div class="notification-dropdown-item-message">${escapeHtml(notif.message)}</div>
                                <div class="notification-dropdown-item-time">${timeAgo}</div>
                            </div>
                        </a>
                    `;
                }).join('');

                content.innerHTML = itemsHtml;
            }

            async function markNotificationAsRead(notificationId, event) {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch(`/api/notifications/${notificationId}/mark-read`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token || ''
                        }
                    });

                    if (response.ok) {
                        const item = event.currentTarget;
                        item.classList.remove('unread');
                        loadNotificationCount();
                    }
                } catch (error) {
                    console.error('Error marking notification as read:', error);
                }
            }

            async function loadNotificationCount() {
                try {
                    const response = await fetch('/api/notifications/unread-count');
                    if (response.ok) {
                        const data = await response.json();
                        updateNotificationBadge(data.count);
                    }
                } catch (error) {
                    console.error('Error loading notification count:', error);
                }
            }

            function updateNotificationBadge(count) {
                const badge = document.getElementById('notificationBadge');
                if (badge) {
                    if (count > 0) {
                        badge.textContent = count > 99 ? '99+' : count;
                        badge.style.display = 'flex';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            }

            // ==================== CHAT DROPDOWN ====================
            let chatDropdownOpen = false;
            let currentChatThreadId = null;

            function toggleChatDropdown(event) {
                event.preventDefault();
                event.stopPropagation();
                
                // Close other dropdowns
                closeNotificationDropdown();
                closeUserMenu();
                
                const dropdown = document.getElementById('chatDropdown');
                if (!dropdown) return;

                chatDropdownOpen = !chatDropdownOpen;
                
                if (chatDropdownOpen) {
                    dropdown.style.display = 'flex';
                    loadChatDropdown();
                } else {
                    dropdown.style.display = 'none';
                }
            }

            // Close dropdown when clicking outside
            document.addEventListener('click', function(event) {
                const bell = document.getElementById('chatBell');
                const dropdown = document.getElementById('chatDropdown');
                
                if (bell && dropdown && !bell.contains(event.target)) {
                    dropdown.style.display = 'none';
                    chatDropdownOpen = false;
                }
            });

            async function loadChatDropdown() {
                const content = document.getElementById('chatDropdownContent');
                if (!content) return;

                content.innerHTML = '<div class="chat-loading"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải...</div>';

                try {
                    const response = await fetch('/api/chat/threads?page=1&pageSize=10');
                    if (response.ok) {
                        const threads = await response.json();
                        renderChatDropdown(threads);
                    } else {
                        content.innerHTML = '<div class="chat-dropdown-empty"><i class="fa-solid fa-exclamation-circle"></i><p>Có lỗi xảy ra khi tải tin nhắn</p></div>';
                    }
                } catch (error) {
                    console.error('Error loading chat threads:', error);
                    content.innerHTML = '<div class="chat-dropdown-empty"><i class="fa-solid fa-exclamation-circle"></i><p>Có lỗi xảy ra khi tải tin nhắn</p></div>';
                }
            }

            function renderChatDropdown(threads) {
                const content = document.getElementById('chatDropdownContent');
                if (!content) return;

                if (!threads || threads.length === 0) {
                    content.innerHTML = `
                        <div class="chat-dropdown-empty">
                            <i class="fa-solid fa-comments"></i>
                            <p>Bạn chưa có tin nhắn nào</p>
                        </div>
                    `;
                    return;
                }

                const itemsHtml = threads.map(thread => {
                    const timeAgo = getTimeAgo(thread.lastMessageAt);
                    const avatarHtml = thread.otherUserAvatar 
                        ? `<img src="${escapeHtml(thread.otherUserAvatar)}" alt="${escapeHtml(thread.otherUserName)}" />`
                        : `<i class="fa-solid fa-user"></i>`;
                    const unreadBadge = thread.unreadCount > 0 
                        ? `<span class="chat-dropdown-item-unread-badge">${thread.unreadCount > 99 ? '99+' : thread.unreadCount}</span>`
                        : '';
                    
                    return `
                        <div class="chat-dropdown-item ${thread.isUnread ? 'unread' : ''}" 
                             onclick="openChatModal(${thread.chatThreadId}, ${thread.bookingId}, '${escapeHtml(thread.otherUserName)}', ${thread.otherUserAvatar ? `'${escapeHtml(thread.otherUserAvatar)}'` : 'null'}, '${escapeHtml(thread.bookingTitle)}')">
                            <div class="chat-dropdown-item-avatar">
                                ${avatarHtml}
                            </div>
                            <div class="chat-dropdown-item-content">
                                <div class="chat-dropdown-item-header">
                                    <span class="chat-dropdown-item-name">${escapeHtml(thread.otherUserName)}${unreadBadge}</span>
                                    <span class="chat-dropdown-item-time">${timeAgo}</span>
                                </div>
                                <div class="chat-dropdown-item-message">${escapeHtml(thread.lastMessage || '')}</div>
                            </div>
                        </div>
                    `;
                }).join('');

                content.innerHTML = itemsHtml;
            }

            async function loadChatUnreadCount() {
                try {
                    const response = await fetch('/api/chat/unread-count');
                    if (response.ok) {
                        const data = await response.json();
                        updateChatBadge(data.count);
                    }
                } catch (error) {
                    console.error('Error loading chat unread count:', error);
                }
            }

            function updateChatBadge(count) {
                const badge = document.getElementById('chatBadge');
                if (badge) {
                    if (count > 0) {
                        badge.textContent = count > 99 ? '99+' : count;
                        badge.style.display = 'flex';
                    } else {
                        badge.style.display = 'none';
                    }
                }
            }

            // ==================== UTILITY FUNCTIONS ====================
            function getTimeAgo(dateString) {
                const now = new Date();
                const date = new Date(dateString);
                const diffMs = now - date;
                const diffMins = Math.floor(diffMs / 60000);
                const diffHours = Math.floor(diffMs / 3600000);
                const diffDays = Math.floor(diffMs / 86400000);

                if (diffMins < 1) return 'Vừa xong';
                if (diffMins < 60) return `${diffMins} phút trước`;
                if (diffHours < 24) return `${diffHours} giờ trước`;
                if (diffDays < 7) return `${diffDays} ngày trước`;
                
                return date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // ==================== CHAT MODAL ====================
            function openChatModal(chatThreadId, bookingId, otherUserName, otherUserAvatar, bookingTitle) {
                currentChatThreadId = chatThreadId;
                const modal = document.getElementById('chatModal');
                const modalName = document.getElementById('chatModalName');
                const modalTitle = document.getElementById('chatModalTitle');
                const modalAvatar = document.getElementById('chatModalAvatar');
                const modalMessages = document.getElementById('chatModalMessages');

                modalName.textContent = otherUserName;
                modalTitle.textContent = bookingTitle;
                
                if (otherUserAvatar) {
                    modalAvatar.innerHTML = `<img src="${escapeHtml(otherUserAvatar)}" alt="${escapeHtml(otherUserName)}" />`;
                } else {
                    modalAvatar.innerHTML = '<i class="fa-solid fa-user"></i>';
                }

                modal.classList.add('active');
                document.body.style.overflow = 'hidden';

                modalMessages.innerHTML = '<div class="chat-loading"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải tin nhắn...</div>';
                
                fetch(`/Chat/GetMessages?chatThreadId=${chatThreadId}`)
                    .then(response => response.json())
                    .then(data => {
                        renderChatModalMessages(data.messages || []);
                    })
                    .catch(error => {
                        console.error('Error loading messages:', error);
                        modalMessages.innerHTML = '<div class="chat-dropdown-empty"><i class="fa-solid fa-exclamation-circle"></i><p>Có lỗi xảy ra khi tải tin nhắn</p></div>';
                    });

                // Reload chat dropdown to update unread count
                if (chatDropdownOpen) {
                    loadChatDropdown();
                }
                
                closeChatDropdown();
            }

            function closeChatModal() {
                const modal = document.getElementById('chatModal');
                modal.classList.remove('active');
                document.body.style.overflow = '';
                currentChatThreadId = null;
            }

            function renderChatModalMessages(messages) {
                const container = document.getElementById('chatModalMessages');
                if (!container) return;

                const currentUserId = '@ViewContext.HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
                
                const messagesHtml = messages.map(msg => {
                    const isMine = msg.senderUserId.toString() === currentUserId;
                    const time = new Date(msg.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                    
                    let imageHtml = '';
                    if (msg.imageUrl && msg.messageType === 'Image') {
                        imageHtml = `<div class="message-image"><img src="${escapeHtml(msg.imageUrl)}" alt="Ảnh" onclick="openImageModal('${escapeHtml(msg.imageUrl)}')" /></div>`;
                    }

                    let contentHtml = '';
                    if (msg.content) {
                        contentHtml = `<p>${escapeHtml(msg.content)}</p>`;
                    }
                    
                    return `
                        <div class="chat-modal-message ${isMine ? 'mine' : 'other'}" data-message-id="${msg.messageId}">
                            ${!isMine ? `<div class="chat-modal-message-avatar"><i class="fa-solid fa-user"></i></div>` : ''}
                            <div class="chat-modal-message-bubble">
                                ${imageHtml}
                                ${contentHtml}
                                <span style="font-size: 10px; opacity: 0.7; display: block; margin-top: 4px;">${time}</span>
                            </div>
                        </div>
                    `;
                }).join('');

                container.innerHTML = messagesHtml;
                scrollChatModalToBottom();
            }

            function addChatModalMessage(messageId, content, senderName, sentAt, isMine, imageUrl = null, messageType = 'Text') {
                const container = document.getElementById('chatModalMessages');
                if (!container) return;

                const time = new Date(sentAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                
                let imageHtml = '';
                if (imageUrl && messageType === 'Image') {
                    imageHtml = `<div class="message-image"><img src="${escapeHtml(imageUrl)}" alt="Ảnh" onclick="openImageModal('${escapeHtml(imageUrl)}')" /></div>`;
                }

                let contentHtml = '';
                if (content) {
                    contentHtml = `<p>${escapeHtml(content)}</p>`;
                }

                const messageDiv = document.createElement('div');
                messageDiv.className = `chat-modal-message ${isMine ? 'mine' : 'other'}`;
                messageDiv.setAttribute('data-message-id', messageId);
                messageDiv.innerHTML = `
                    ${!isMine ? `<div class="chat-modal-message-avatar"><i class="fa-solid fa-user"></i></div>` : ''}
                    <div class="chat-modal-message-bubble">
                        ${imageHtml}
                        ${contentHtml}
                        <span style="font-size: 10px; opacity: 0.7; display: block; margin-top: 4px;">${time}</span>
                    </div>
                `;

                container.appendChild(messageDiv);
            }

            function openImageModal(imageUrl) {
                // Simple image modal - can be enhanced later
                window.open(imageUrl, '_blank');
            }

            function scrollChatModalToBottom() {
                const container = document.getElementById('chatModalMessages');
                if (container) {
                    container.scrollTop = container.scrollHeight;
                }
            }

            async function sendChatModalMessage(event) {
                event.preventDefault();
                
                if (!currentChatThreadId) return;

                const input = document.getElementById('chatModalInput');
                const sendBtn = document.getElementById('chatModalSendBtn');
                const content = input.value.trim();
                if (!content) return;

                const formData = new FormData();
                formData.append('chatThreadId', currentChatThreadId);
                formData.append('content', content);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                
                sendBtn.disabled = true;
                input.disabled = true;

                try {
                    const response = await fetch('/Chat/SendMessage', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token || ''
                        },
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        input.value = '';
                        // Message will be added via SignalR
                    } else {
                        alert(result.message || 'Gửi tin nhắn thất bại');
                    }
                } catch (error) {
                    console.error('Error sending message:', error);
                    alert('Có lỗi xảy ra khi gửi tin nhắn');
                } finally {
                    sendBtn.disabled = false;
                    input.disabled = false;
                    input.focus();
                }
            }

            // Close modal when clicking outside
            document.getElementById('chatModal')?.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeChatModal();
                }
            });

            // ==================== INITIAL LOAD ====================
            loadNotificationCount();
            loadChatUnreadCount();
        </script>

        <!-- CHAT MODAL -->
        <div class="chat-modal" id="chatModal">
            <div class="chat-modal-header">
                <div class="chat-modal-header-info" id="chatModalHeaderInfo">
                    <div class="chat-modal-header-avatar" id="chatModalAvatar">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="chat-modal-header-text">
                        <h4 id="chatModalName">Loading...</h4>
                        <p id="chatModalTitle">Loading...</p>
                    </div>
                </div>
                <button class="chat-modal-close" onclick="closeChatModal()">
                    <i class="fa-solid fa-times"></i>
                </button>
            </div>
            <div class="chat-modal-messages" id="chatModalMessages">
                <div class="chat-loading">
                    <i class="fa-solid fa-spinner fa-spin"></i> Đang tải tin nhắn...
                </div>
            </div>
            <div class="chat-modal-input-container">
                <form id="chatModalForm" onsubmit="sendChatModalMessage(event)">
                    <div class="chat-modal-input-form">
                        <input type="text" 
                               id="chatModalInput" 
                               class="chat-modal-input"
                               placeholder="Nhập tin nhắn..." 
                               autocomplete="off"
                               maxlength="2000" />
                        <button type="submit" class="chat-modal-send-btn" id="chatModalSendBtn">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>
