@model TripCompass.WebUI.ViewModels.ReviewsPageViewModel
@{
    ViewData["Title"] = "Reviews - TripCompass";
    Layout = "_Layout";
}

<div class="reviews-page">

    <!-- ================= HERO ================= -->
    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content container">
            <div class="hero-text">
                <h1>Khám phá Việt Nam cùng TripCompass</h1>
                <p>So sánh, đánh giá và lựa chọn những trải nghiệm du lịch tốt nhất cho bạn</p>

                <div class="hero-stats">
                    <div class="stat-chip">
                        <span class="stat-icon">📍</span>
                        <span>@Model.TotalProducts.ToString("N0") địa điểm</span>
                    </div>
                    <div class="stat-chip">
                        <span class="stat-icon">⭐</span>
                        <span>@Model.AverageRating.ToString("F1") / 5 trung bình</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= SEARCH & FILTER ================= -->
    <section class="filter-bar">
        <div class="container">
            <form method="get" action="/Review/Reviews" class="filter-card search-filter-form">

                <!-- Search -->
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text"
                           name="search"
                           value="@Model.SearchQuery"
                           placeholder="Tìm tour, khách sạn, nhà hàng..."
                           class="search-input" />
                </div>

                <!-- Filters -->
                <div class="filters-row">

                    <div class="filter-group">
                        <label>Tỉnh thành</label>
                        <select name="province">
                            <option value="">Tất cả</option>
                            @foreach (var prov in Model.Provinces)
                            {
                                if (Model.SelectedProvince == prov)
                                {
                                    <option value="@prov" selected>@prov</option>
                                }
                                else
                                {
                                    <option value="@prov">@prov</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>Mức giá</label>
                        <select name="priceRange">
                            <option value="">Tất cả</option>
                            @if (Model.SelectedPriceRange == "under-1m")
                            {
                                <option value="under-1m" selected>Dưới 1 triệu</option>
                            }
                            else
                            {
                                <option value="under-1m">Dưới 1 triệu</option>
                            }

                            @if (Model.SelectedPriceRange == "1m-3m")
                            {
                                <option value="1m-3m" selected>1 – 3 triệu</option>
                            }
                            else
                            {
                                <option value="1m-3m">1 – 3 triệu</option>
                            }

                            @if (Model.SelectedPriceRange == "3m-5m")
                            {
                                <option value="3m-5m" selected>3 – 5 triệu</option>
                            }
                            else
                            {
                                <option value="3m-5m">3 – 5 triệu</option>
                            }

                            @if (Model.SelectedPriceRange == "over-5m")
                            {
                                <option value="over-5m" selected>Trên 5 triệu</option>
                            }
                            else
                            {
                                <option value="over-5m">Trên 5 triệu</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>Sắp xếp</label>
                        <select name="sortBy">
                            @if (Model.SortBy == "popular")
                            {
                                <option value="popular" selected>Phổ biến nhất</option>
                            }
                            else
                            {
                                <option value="popular">Phổ biến nhất</option>
                            }

                            @if (Model.SortBy == "rating")
                            {
                                <option value="rating" selected>Đánh giá cao nhất</option>
                            }
                            else
                            {
                                <option value="rating">Đánh giá cao nhất</option>
                            }

                            @if (Model.SortBy == "price-low")
                            {
                                <option value="price-low" selected>Giá thấp → cao</option>
                            }
                            else
                            {
                                <option value="price-low">Giá thấp → cao</option>
                            }

                            @if (Model.SortBy == "price-high")
                            {
                                <option value="price-high" selected>Giá cao → thấp</option>
                            }
                            else
                            {
                                <option value="price-high">Giá cao → thấp</option>
                            }

                            @if (Model.SortBy == "newest")
                            {
                                <option value="newest" selected>Mới nhất</option>
                            }
                            else
                            {
                                <option value="newest">Mới nhất</option>
                            }
                        </select>
                    </div>

                </div>

                <!-- Category Tabs -->
                <div class="category-tabs">
                    <a href="/Review/Reviews"
                       class="category-pill @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                        Tất cả
                    </a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a href="/Review/Reviews?category=@cat.Slug"
                           class="category-pill @(Model.SelectedCategory == cat.Slug ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                </div>

            </form>
        </div>
    </section>

    <!-- ================= CONTENT ================= -->
    <main class="container content">

        <!-- ===== Featured ===== -->
        @if (Model.FeaturedPosts.Any())
        {
            <section class="section">
                <header class="section-header">
                    <div>
                        <h2>Sản phẩm nổi bật</h2>
                        <p>Những lựa chọn được cộng đồng yêu thích nhất</p>
                    </div>
                    <div class="carousel-controls">
                        <button onclick="scrollSection('featured', -1)">‹</button>
                        <button onclick="scrollSection('featured', 1)">›</button>
                    </div>
                </header>

                <div class="carousel" id="featured-carousel">
                    @foreach (var post in Model.FeaturedPosts)
                    {
                        <article class="card">
                            <a href="/Review/Detail/@post.PostId" class="card-link">
                                <div class="card-image">
                                    <img src="@post.ThumbnailUrl" alt="@post.Title" />
                                    <span class="badge badge-featured">Nổi bật</span>
                                    <button class="icon-btn"
                                            onclick="event.preventDefault(); toggleFavorite(@post.PostId)">
                                        ❤️
                                    </button>
                                </div>

                                <div class="card-body">
                                    <h3>@post.Title</h3>

                                    <div class="rating-row">
                                        @{
                                            var stars = new string('★', Math.Min(5, post.Rating));
                                        }
                                        <span class="stars">@stars</span>
                                        <span class="count">(@post.CommentCount)</span>
                                    </div>

                                    <div class="price-row">
                                        @if (post.Price.HasValue)
                                        {
                                            <span class="price">@post.Price.Value.ToString("N0")₫</span>
                                        }
                                        else
                                        {
                                            <span class="price muted">Liên hệ</span>
                                        }
                                    </div>

                                    <button class="primary-btn"
                                            onclick="event.preventDefault(); window.location.href='/Review/Detail/@post.PostId'">
                                        Xem chi tiết
                                    </button>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            </section>
        }

        <!-- ===== Partner ===== -->
        @if (Model.PartnerPosts.Any())
        {
            <section class="section">
                <header class="section-header">
                    <div>
                        <h2>Sản phẩm từ đối tác</h2>
                        <p>Được cung cấp bởi các thương hiệu uy tín</p>
                    </div>
                    <a href="/Review/Reviews?partnerOnly=true" class="link-primary">
                        Xem tất cả →
                    </a>
                </header>

                <div class="grid-scroll">
                    @foreach (var post in Model.PartnerPosts.Take(4))
                    {
                        <article class="card">
                            <a href="/Review/Detail/@post.PostId" class="card-link">
                                <div class="card-image">
                                    <img src="@post.ThumbnailUrl" alt="@post.Title" />
                                    <span class="badge badge-partner">Đối tác</span>
                                </div>

                                <div class="card-body">
                                    <h3>@post.Title</h3>

                                    <div class="rating-row">
                                        @{
                                            var stars = new string('★', Math.Min(5, post.Rating));
                                        }
                                        <span class="stars">@stars</span>
                                        <span class="count">(@post.CommentCount)</span>
                                    </div>

                                    <div class="price-row">
                                        @if (post.Price.HasValue)
                                        {
                                            <span class="price">@post.Price.Value.ToString("N0")₫</span>
                                        }
                                        else
                                        {
                                            <span class="price muted">Liên hệ</span>
                                        }
                                    </div>

                                    <button class="primary-btn"
                                            onclick="event.preventDefault(); window.location.href='/Review/Detail/@post.PostId'">
                                        Xem chi tiết
                                    </button>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            </section>
        }

        <!-- ===== Category Sections ===== -->
        @foreach (var categorySection in Model.CategorySections)
        {
            if (categorySection.FeaturedPosts.Any() || categorySection.PartnerPosts.Any())
            {
                <section class="section">
                    <header class="section-header">
                        <h2>@categorySection.CategoryName</h2>
                    </header>

                    @if (categorySection.FeaturedPosts.Any())
                    {
                        <div class="carousel" id="category-@categorySection.CategoryId-carousel">
                            @foreach (var post in categorySection.FeaturedPosts)
                            {
                                <article class="card">
                                    <a href="/Review/Detail/@post.PostId" class="card-link">
                                        <div class="card-image">
                                            <img src="@post.ThumbnailUrl" alt="@post.Title" />
                                            <span class="badge badge-featured">Nổi bật</span>
                                            <button class="icon-btn"
                                                    onclick="event.preventDefault(); toggleFavorite(@post.PostId)">
                                                ❤️
                                            </button>
                                        </div>

                                        <div class="card-body">
                                            <h3>@post.Title</h3>

                                            <div class="rating-row">
                                                @{
                                                    var stars = new string('★', Math.Min(5, post.Rating));
                                                }
                                                <span class="stars">@stars</span>
                                                <span class="count">(@post.CommentCount)</span>
                                            </div>

                                            <div class="price-row">
                                                @if (post.Price.HasValue)
                                                {
                                                    <span class="price">@post.Price.Value.ToString("N0")₫</span>
                                                }
                                                else
                                                {
                                                    <span class="price muted">Liên hệ</span>
                                                }
                                            </div>

                                            <button class="primary-btn"
                                                    onclick="event.preventDefault(); window.location.href='/Review/Detail/@post.PostId'">
                                                Xem chi tiết
                                            </button>
                                        </div>
                                    </a>
                                </article>
                            }
                        </div>
                    }

                    @if (categorySection.PartnerPosts.Any())
                    {
                        <div class="grid-scroll">
                            @foreach (var post in categorySection.PartnerPosts.Take(4))
                            {
                                <article class="card">
                                    <a href="/Review/Detail/@post.PostId" class="card-link">
                                        <div class="card-image">
                                            <img src="@post.ThumbnailUrl" alt="@post.Title" />
                                            <span class="badge badge-partner">Đối tác</span>
                                        </div>

                                        <div class="card-body">
                                            <h3>@post.Title</h3>

                                            <div class="rating-row">
                                                @{
                                                    var stars = new string('★', Math.Min(5, post.Rating));
                                                }
                                                <span class="stars">@stars</span>
                                                <span class="count">(@post.CommentCount)</span>
                                            </div>

                                            <div class="price-row">
                                                @if (post.Price.HasValue)
                                                {
                                                    <span class="price">@post.Price.Value.ToString("N0")₫</span>
                                                }
                                                else
                                                {
                                                    <span class="price muted">Liên hệ</span>
                                                }
                                            </div>

                                            <button class="primary-btn"
                                                    onclick="event.preventDefault(); window.location.href='/Review/Detail/@post.PostId'">
                                                Xem chi tiết
                                            </button>
                                        </div>
                                    </a>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
        }

    </main>
</div>

<style>
/* ===================== BASE ===================== */
.reviews-page {
    min-height: 100vh;
    background: #f8fafc;
    color: #0f172a;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

a {
    text-decoration: none;
    color: inherit;
}

/* ===================== HERO ===================== */
.hero {
    position: relative;
    background: linear-gradient(135deg, #2563eb, #1e40af);
    color: white;
    padding: 80px 0 100px;
    overflow: hidden;
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 20% 30%, rgba(255,255,255,.15), transparent 40%),
        radial-gradient(circle at 80% 20%, rgba(255,255,255,.12), transparent 45%);
}

.hero-content {
    position: relative;
    z-index: 2;
}

.hero-text {
    max-width: 640px;
}

.hero h1 {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 16px;
}

.hero p {
    font-size: 16px;
    opacity: .9;
    margin-bottom: 24px;
}

.hero-stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.stat-chip {
    background: rgba(255,255,255,.18);
    backdrop-filter: blur(6px);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14px;
    display: flex;
    gap: 6px;
    align-items: center;
}

/* ===================== FILTER BAR ===================== */
.filter-bar {
    margin-top: -60px;
    position: relative;
    z-index: 10;
}

.filter-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(15, 23, 42, .08);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.search-box {
    position: relative;
}

.search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    color: #64748b;
}

.search-input {
    width: 100%;
    padding: 14px 16px 14px 44px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    font-size: 15px;
    transition: border-color .15s, box-shadow .15s;
}

.search-input:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,.15);
}

.filters-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.filter-group label {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
}

.filter-group select {
    height: 42px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    font-size: 14px;
    background: white;
    transition: border-color .15s, box-shadow .15s;
}

.filter-group select:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37,99,235,.15);
}

/* ===================== CATEGORY TABS ===================== */
.category-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    border-top: 1px solid #e5e7eb;
    padding-top: 16px;
}

.category-pill {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    transition: all .15s;
}

.category-pill:hover {
    background: #e2e8f0;
}

.category-pill.active {
    background: #2563eb;
    color: white;
}

/* ===================== CONTENT SECTIONS ===================== */
.content {
    padding: 48px 20px 80px;
}

.section {
    margin-top: 48px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 20px;
}

.section-header h2 {
    font-size: 22px;
    font-weight: 700;
}

.section-header p {
    font-size: 14px;
    color: #64748b;
}

.link-primary {
    font-size: 14px;
    font-weight: 600;
    color: #2563eb;
}

.link-primary:hover {
    text-decoration: underline;
}

/* ===================== CAROUSEL / GRID ===================== */
.carousel,
.grid-scroll {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 10px;
}

.carousel::-webkit-scrollbar,
.grid-scroll::-webkit-scrollbar {
    height: 6px;
}

.carousel::-webkit-scrollbar-thumb,
.grid-scroll::-webkit-scrollbar-thumb {
    background: #cbd5f5;
    border-radius: 999px;
}

/* ===================== CARD ===================== */
.card {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    width: 280px;
    flex-shrink: 0;
    box-shadow:
        0 4px 8px rgba(15, 23, 42, .05),
        0 12px 24px rgba(15, 23, 42, .04);
    transition: transform .2s ease, box-shadow .2s ease;
}

.card:hover {
    transform: translateY(-4px);
    box-shadow:
        0 10px 20px rgba(15, 23, 42, .08),
        0 24px 48px rgba(15, 23, 42, .06);
}

.card-link {
    display: block;
    height: 100%;
}

.card-image {
    position: relative;
    height: 200px;
    overflow: hidden;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
}

.card:hover img {
    transform: scale(1.05);
}

.badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .3px;
    color: white;
}

.badge-featured {
    background: linear-gradient(135deg, #fb923c, #f97316);
}

.badge-partner {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
}

.icon-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,.9);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    transition: background .15s, transform .15s;
}

.icon-btn:hover {
    background: white;
    transform: scale(1.05);
}

.card-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.card-body h3 {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 8px;
    color: #0f172a;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 44px;
}

.rating-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    font-size: 13px;
}

.stars {
    color: #f59e0b;
    letter-spacing: 1px;
}

.count {
    color: #64748b;
}

.price-row {
    margin-bottom: 12px;
    min-height: 24px;
    display: flex;
    align-items: center;
}

.price {
    font-size: 17px;
    font-weight: 800;
    color: #2563eb;
}

.price.muted {
    color: #64748b;
    font-weight: 600;
}

.primary-btn {
    margin-top: auto;
    height: 42px;
    border-radius: 10px;
    border: none;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: transform .15s ease, box-shadow .15s ease, background .15s;
    box-shadow: 0 4px 10px rgba(37,99,235,.25);
}

.primary-btn:hover {
    background: linear-gradient(135deg, #1d4ed8, #1e40af);
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(37,99,235,.35);
}

/* ===================== CAROUSEL CONTROLS ===================== */
.carousel-controls {
    display: flex;
    gap: 8px;
}

.carousel-controls button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #e5e7eb;
    background: white;
    font-size: 20px;
    cursor: pointer;
    color: #475569;
    transition: all .15s ease;
}

.carousel-controls button:hover {
    border-color: #2563eb;
    color: #2563eb;
    background: #eff6ff;
}

/* ===================== RESPONSIVE ===================== */
@@media (max-width: 768px) {
    .hero {
        padding: 64px 0 80px;
    }

    .filter-card {
        padding: 16px;
    }

    .section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
    }

    .card {
        width: 260px;
    }
}
</style>

<script>
    function scrollSection(sectionId, direction) {
        const carousel = document.getElementById(sectionId + '-carousel');
        if (carousel) {
            carousel.scrollBy({
                left: direction * 320,
                behavior: 'smooth'
            });
        }
    }

    function toggleFavorite(postId) {
        // TODO: Implement favorite functionality
        console.log('Toggle favorite:', postId);
    }

    document.addEventListener('DOMContentLoaded', function () {
        const filterForm = document.querySelector('.search-filter-form');
        const filterSelects = filterForm.querySelectorAll(
            'select[name="province"], select[name="priceRange"], select[name="sortBy"]'
        );

        filterSelects.forEach(select => {
            select.addEventListener('change', function () {
                filterForm.submit();
            });
        });
    });
</script>
