@model TripCompass.WebUI.ViewModels.ReviewFormViewModel
@{
    ViewData["Title"] = "Viết đánh giá";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/review-create.css" />
}

<div class="review-create-page">
    <div class="reward-banner">
        <h3>🪙 Viết đánh giá để nhận thêm coin!</h3>
        <p>Nhận 50–200 coin cho mỗi đánh giá chất lượng</p>
    </div>

    <div class="review-grid">
        <div class="card">
            <div class="card-title">✍️ Viết đánh giá địa điểm</div>

            <form asp-action="@(Model.PostId > 0 ? "Edit" : "Create")"
                  method="post"
                  enctype="multipart/form-data"
                  id="reviewForm">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PostId" />

                <div class="form-group">
                    <label>
                        Tên địa điểm<span class="required-star">*</span>
                    </label>
                    <input asp-for="Title" placeholder="Nhập tên địa điểm..." required />
                </div>

                <div class="form-group">
                    <label>
                        Địa chỉ<span class="required-star">*</span>
                    </label>
                    <div class="location-input">
                        <i>📍</i>
                        <input asp-for="Location" id="locationInput" placeholder="Nhập địa chỉ..." autocomplete="off" required />
                        <div id="locationDropdown" class="location-dropdown"></div>
                    </div>
                </div>

                <input type="hidden"
                       id="locationSelected"
                       value="@(Model.PostId > 0 ? "true" : "false")" />

                <div id="map"></div>

                <div class="form-group">
                    <label>
                        Đánh giá<span class="required-star">*</span>
                    </label>
                    <div class="rating" id="ratingStars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span data-value="@i">★</span>
                        }
                        <span class="rating-text" id="ratingText">0/5</span>
                    </div>
                    <input type="hidden" asp-for="Rating" id="ratingInput" />
                </div>

                <div class="form-group">
                    <label>
                        Chia sẻ trải nghiệm<span class="required-star">*</span>
                    </label>
                    <textarea asp-for="Content" placeholder="Chia sẻ trải nghiệm của bạn về địa điểm này..." required></textarea>
                </div>
                @if (Model.PostId > 0 && Model.ExistingImages.Any())
                {
                    <div class="form-group">
                        <label>Ảnh hiện tại</label>
                        <div class="upload-preview">
                            @foreach (var img in Model.ExistingImages)
                            {
                                <div class="existing-image-item">
                                    <img src="@img.ImageUrl" />
                                    <label>
                                        <input type="checkbox"
                                               name="DeletedImageIds"
                                               value="@img.PostImageId" />
                                        Xóa
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label>Ảnh (tối đa 5)</label>
                    <div class="upload-box" id="uploadBox">
                        <div>Click để chọn ảnh</div>
                        <div class="upload-box-hint">Tối đa 5 ảnh</div>
                    </div>
                    <input type="file"
                           id="imageInput"
                           asp-for="Images"
                           accept="image/*"
                           multiple
                           hidden />

                    <div class="upload-preview" id="preview"></div>
                </div>

                <div class="form-group">
                    <label>
                        Danh mục<span class="required-star">*</span>
                    </label>
                    <select asp-for="SelectedCategoryId" required>
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var c in Model.AllCategories)
                        {
                            <option value="@c.CategoryId">@c.Name</option>
                        }
                    </select>
                </div>

                <hr class="review-divider" />

                <h3 class="review-section-title">Thông tin chi tiết (Tùy chọn)</h3>

                <div class="form-group">
                    <label>Giờ mở cửa</label>
                    <input asp-for="OpeningHours" placeholder="VD: 6:00 - 22:00 hàng ngày" />
                </div>

                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input asp-for="Phone" placeholder="VD: 024 3123 4567" />
                </div>

                <div class="form-group">
                    <label>Bãi đỗ xe</label>
                    <input asp-for="ParkingInfo" placeholder="VD: Có sẵn" />
                </div>

                <div class="form-group">
                    <label>Giá (₫)</label>
                    <input type="number" asp-for="Price" placeholder="VD: 85000" step="1000" min="0" />
                </div>

                <button type="submit" class="btn-primary">
                    @(Model.PostId > 0 ? "Cập nhật đánh giá ✏️" : "Đăng đánh giá 🚀")
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    /* =====================================================
       COMMON VARIABLES
    ===================================================== */
    const form = document.getElementById("reviewForm");
    const isEdit = document.querySelector('input[name="PostId"]')?.value > 0;

    /* =====================================================
       LOCATION (OSM)
    ===================================================== */
    const input = document.getElementById("locationInput");
    const dropdown = document.getElementById("locationDropdown");
    const locationSelected = document.getElementById("locationSelected");
    let map, marker;

    input.addEventListener("input", async () => {
        locationSelected.value = "false";
        const q = input.value.trim();
        if (q.length < 2) {
            dropdown.style.display = "none";
            return;
        }

        const res = await fetch(
            `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}&limit=5&countrycodes=vn`
        );
        const data = await res.json();

        dropdown.innerHTML = "";
        data.forEach(p => {
            const div = document.createElement("div");
            div.textContent = p.display_name;
            div.onclick = () => selectPlace(p);
            dropdown.appendChild(div);
        });
        dropdown.style.display = "block";
    });

    function selectPlace(p) {
        input.value = p.display_name;
        locationSelected.value = "true";
        dropdown.style.display = "none";

        const lat = p.lat, lon = p.lon;
        if (!map) {
            map = L.map("map").setView([lat, lon], 16);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png").addTo(map);
        } else {
            map.setView([lat, lon], 16);
        }

        if (marker) marker.remove();
        marker = L.marker([lat, lon], { draggable: true }).addTo(map);

        // Cho phép người dùng kéo marker để chỉnh lại vị trí nếu Nominatim không khớp
        marker.on("dragend", () => {
            const pos = marker.getLatLng();
            map.panTo(pos);
        });
        document.getElementById("map").style.display = "block";
    }

    /* =====================================================
       RATING
    ===================================================== */
    const stars = document.querySelectorAll("#ratingStars span[data-value]");
    const ratingInput = document.getElementById("ratingInput");
    const ratingText = document.getElementById("ratingText");

    stars.forEach(star => {
        star.addEventListener("click", () => {
            const v = parseInt(star.dataset.value);
            ratingInput.value = v;
            ratingText.innerText = `${v}/5`;

            stars.forEach(s =>
                s.classList.toggle("active", parseInt(s.dataset.value) <= v)
            );
        });
    });

    // Init rating when EDIT
    if (isEdit && ratingInput.value > 0) {
        const v = parseInt(ratingInput.value);
        ratingText.innerText = `${v}/5`;
        stars.forEach(s =>
            s.classList.toggle("active", parseInt(s.dataset.value) <= v)
        );
    }

    /* =====================================================
       IMAGE UPLOAD (MAX 5)
    ===================================================== */
    const uploadBox = document.getElementById("uploadBox");
    const imageInput = document.getElementById("imageInput");
    const preview = document.getElementById("preview");

    let files = [];

    uploadBox.addEventListener("click", () => imageInput.click());

    imageInput.addEventListener("change", () => {
        const selected = Array.from(imageInput.files);

        for (const f of selected) {
            if (files.length >= 5) break;
            files.push(f);
        }

        imageInput.value = "";
        renderPreview();
    });

    function renderPreview() {
        preview.innerHTML = "";

        files.forEach((file, index) => {
            const div = document.createElement("div");
            div.className = "preview-item";

            const img = document.createElement("img");
            img.src = URL.createObjectURL(file);

            const btn = document.createElement("button");
            btn.innerText = "×";
            btn.type = "button";
            btn.onclick = () => {
                files.splice(index, 1);
                renderPreview();
            };

            div.appendChild(img);
            div.appendChild(btn);
            preview.appendChild(div);
        });
    }

    /* =====================================================
       FORM SUBMIT
    ===================================================== */
    form.addEventListener("submit", e => {

        // Validate ONLY when CREATE
        if (!isEdit) {
            if (ratingInput.value < 1 || locationSelected.value !== "true") {
                e.preventDefault();
                alert("⚠️ Vui lòng nhập đủ thông tin");
                return;
            }
        }

        // Attach images before submit
        const dt = new DataTransfer();
        files.forEach(f => dt.items.add(f));
        imageInput.files = dt.files;
    });
</script>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
}
