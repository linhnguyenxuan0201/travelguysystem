@model TripCompass.WebUI.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-right">
        <h1>Quên mật khẩu</h1>
        <p>Nhập email của bạn để nhận mã OTP xác thực.</p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="background-color: #fee2e2; color: #991b1b; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
                @TempData["Error"]
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="auth-form">
            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="Nhập email của bạn" />
                <span asp-validation-for="Email" class="error"></span>
            </div>

            <button type="submit" class="btn-primary">
                Gửi mã OTP
            </button>

            <div style="text-align: center; margin-top: 20px;">
                <a asp-action="Login" style="color: #2563eb; text-decoration: none;">Quay lại đăng nhập</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
