@model TripCompass.WebUI.ViewModels.VerifyForgotOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
    Layout = "_AuthLayout";
}

<form asp-action="VerifyForgotOtp" method="post" class="auth-form">

    <input type="hidden" asp-for="Email" />

    <label>Enter OTP</label>

    <input asp-for="OtpCode"
           class="otp-input"
           maxlength="6"
           inputmode="numeric"
           autocomplete="one-time-code" />

    <span asp-validation-for="OtpCode" class="error"></span>

    <button type="submit" class="btn-primary">
        Verify OTP
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
