@model TripCompass.WebUI.ViewModels.VerifyForgotOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-right">
        <h1>Xác thực OTP</h1>
        <p>Nhập mã OTP đã được gửi đến email <strong>@Model.Email</strong></p>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success" style="background-color: #d1fae5; color: #065f46; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
                @TempData["Message"]
            </div>
        }

        <form asp-action="VerifyForgotOtp" method="post" class="auth-form">
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label>Mã OTP</label>
                <input asp-for="OtpCode"
                       class="form-control"
                       maxlength="6"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       placeholder="Nhập 6 chữ số"
                       style="text-align: center; font-size: 24px; letter-spacing: 8px; font-weight: bold;" />
                <span asp-validation-for="OtpCode" class="error"></span>
            </div>

            <button type="submit" class="btn-primary">
                Xác thực OTP
            </button>

            <div style="text-align: center; margin-top: 20px;">
                <a asp-action="ForgotPassword" style="color: #2563eb; text-decoration: none;">Gửi lại mã OTP</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
