@model TripCompass.WebUI.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
    Layout = "_AuthLayout";
}

<div class="register-container">
    <!-- LEFT -->
    <div class="register-left">
        <div class="register-nav">
            <span class="register-nav-text">Sign up</span>
            <a asp-controller="Home" asp-action="Index" class="register-nav-link">Home</a>
        </div>
        <div class="register-branding">
            <img src="~/images/logo.png" class="register-logo" />
            <h2>TRIPCOMPASS</h2>
            <p>DISCOVER MORE, PLAN LESS</p>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="register-right">
        <h1>Sign up</h1>

        <form asp-action="Register" method="post" class="register-form">
            <div class="form-group">
                <label>Your full name</label>
                <input asp-for="FullName" placeholder="Your full name" />
                <span asp-validation-for="FullName" class="error"></span>
            </div>

            <div class="form-group">
                <label>Enter your email</label>
                <input asp-for="Email" placeholder="Email" />
                <span asp-validation-for="Email" class="error"></span>
            </div>

            <div class="form-group">
                <label>Choose your password</label>
                <input asp-for="Password" type="password" placeholder="Password" />
                <span asp-validation-for="Password" class="error"></span>
            </div>

            <div class="form-group">
                <label>Confirm your password</label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm password" />
                <span asp-validation-for="ConfirmPassword" class="error"></span>
            </div>

            <a asp-action="GoogleLogin" class="btn-google-register">
                <span class="google-icon">G</span>
                Sign up with Google
            </a>

            <div class="register-actions">
                <button type="submit" class="btn-signup">Sign up</button>
                <a asp-action="Login" class="btn-login">Log in</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
