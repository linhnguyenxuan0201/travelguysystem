@using TripCompass.WebUI.ViewModels
@model ProfileViewModel

<section class="profile-wrapper">

    <!-- PAGE HEADER -->
    <div class="profile-page-header">
        <h1>Hồ sơ người dùng</h1>
        <p>Quản lý thông tin tài khoản và dịch vụ của bạn</p>
    </div>

    <div class="profile-layout">

        <!-- ================= LEFT COLUMN ================= -->
        <div class="profile-left">

            <!-- PROFILE CARD -->
            <div class="card profile-main">

                <div class="profile-top">
                    <img src="@Model.AvatarUrl"
                         alt="User Avatar"
                         class="avatar-lg" />

                    <div class="profile-basic">
                        <h2>@Model.UserName</h2>
                        <span class="email">@Model.Email</span>
                        <small class="joined">
                            Tham gia @Model.JoinedAt.ToString("MMMM yyyy", new System.Globalization.CultureInfo("vi-VN"))
                        </small>
                    </div>
                </div>

                <!-- AVATAR UPLOAD -->
                <form asp-action="UploadAvatar"
                      asp-controller="Account"
                      method="post"
                      enctype="multipart/form-data"
                      class="avatar-upload">
                    <label class="change-avatar">
                        Đổi avatar
                        <input type="file"
                               name="avatar"
                               hidden
                               onchange="this.form.submit()" />
                    </label>
                </form>

                <hr />

                <!-- BASIC INFO -->
                <h4 class="section-title">Thông tin cơ bản</h4>

                <div class="info-grid">
                    <div class="info-item">
                        <span>Họ và tên</span>
                        <strong>@Model.UserName</strong>
                    </div>

                    <div class="info-item">
                        <span>Email</span>
                        <strong>@Model.Email</strong>
                    </div>

                    <div class="info-item">
                        <span>Trạng thái</span>
                        <span class="badge badge-active">Hoạt động</span>
                    </div>

                    <div class="info-item">
                        <span>Loại tài khoản</span>
                        <span class="badge badge-free">Miễn phí</span>
                    </div>
                </div>
            </div>

            <!-- STATS -->
            <div class="stats-grid">
                <div class="stat-card coin">
                    <h3>@Model.ReputationScore.ToString("N0")</h3>
                    <p>Số coin hiện có</p>
                </div>

                <div class="stat-card trust">
                    <h3>@Model.ReputationLevel</h3>
                    <p>Độ uy tín</p>
                    <div class="stars">
                        ★★★★☆
                    </div>
                </div>
            </div>

        </div>

        <!-- ================= RIGHT COLUMN ================= -->
        <div class="profile-right">

            <!-- CURRENT PLAN -->
            <div class="card plan-card">
                <h4>Gói hiện tại</h4>

                <div class="plan-box">
                    <strong>Miễn phí</strong>
                    <span>Truy cập cơ bản</span>
                </div>

                <ul class="plan-features">
                    <li>✔ Truy cập tiêu chuẩn</li>
                    <li>✔ Hỗ trợ cộng đồng</li>
                    <li>✔ Tính năng cơ bản</li>
                </ul>
            </div>

            <!-- UPGRADE -->
            <div class="card upgrade-card">
                <h4>Nâng cấp lên gói tiếp theo?</h4>
                <p>Mở khóa thêm nhiều tính năng nâng cao</p>

                <div class="upgrade-box">
                    <span>Doanh nghiệp</span>
                    <strong>+50%</strong>
                </div>

                <button class="btn-upgrade">
                    Nâng cấp ngay →
                </button>
            </div>

            <!-- QUICK ACTIONS -->
            <div class="card quick-actions">
                <h4>Thao tác nhanh</h4>

                <a asp-action="ChangePassword"
                   asp-controller="Account">
                    Đổi mật khẩu
                </a>

                <a href="#">
                    Lịch sử giao dịch
                </a>
            </div>

        </div>
    </div>
</section>
