@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="login-page">
    <div class="login-container">

        <!-- LEFT -->
        <div class="login-left">
            <img src="~/images/logo.png" class="login-logo" />
            <h2>TRIPCOMPASS</h2>
            <p class="login-slogan">KHÁM PHÁ NHIỀU HƠN, LÊN KẾ HOẠCH ÍT HƠN</p>
        </div>

        <!-- RIGHT -->
        <div class="login-right">
            <h1>Đăng nhập</h1>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="login-form">

                <label>Nhập email của bạn</label>
                <input type="email"
                       name="email"
                       placeholder="Email"
                       required />

                <label>Nhập mật khẩu của bạn</label>
                <input type="password"
                       name="password"
                       placeholder="Mật khẩu"
                       required />

                <div class="forgot">
                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="forgot-link">
                        Quên mật khẩu
                    </a>

                </div>

                @if (ViewBag.Error != null)
                {
                    <p class="error-text">@ViewBag.Error</p>
                }

                <div class="login-actions">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn-outline">
                        Đăng ký
                    </a>

                    <button type="submit" class="btn-primary">
                        Đăng nhập
                    </button>
                </div>

                <div class="divider">
                    <span>hoặc</span>
                </div>

                <!-- GOOGLE LOGIN -->
                <a asp-controller="Account"
                   asp-action="GoogleLogin"
                   class="btn-google">
                    <i class="fab fa-google"></i>
                    Tiếp tục với Google
                </a>
            </form>
        </div>

    </div>
</section>
