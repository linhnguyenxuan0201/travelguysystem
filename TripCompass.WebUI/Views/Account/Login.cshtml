@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="login-page">
    <div class="login-container">

        <!-- LEFT -->
        <div class="login-left">
            <img src="~/images/logo.png" class="login-logo" />
            <h2>TRIPCOMPASS</h2>
            <p class="login-slogan">KHÁM PHÁ NHIỀU HƠN, LÊN KẾ HOẠCH ÍT HƠN</p>
        </div>

        <!-- RIGHT -->
        <div class="login-right">
            <h1>Đăng nhập</h1>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="login-form">

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 16px; border: 1px solid #c3e6cb;">
                        <strong>✓ @ViewBag.Success</strong>
                        @if (ViewBag.AdminEmail != null && ViewBag.AdminPassword != null)
                        {
                            <div style="margin-top: 8px; font-size: 0.9em;">
                                <strong>Thông tin đăng nhập:</strong><br>
                                Email: <code style="background: #fff; padding: 2px 6px; border-radius: 3px;">@ViewBag.AdminEmail</code><br>
                                Password: <code style="background: #fff; padding: 2px 6px; border-radius: 3px;">@ViewBag.AdminPassword</code>
                            </div>
                        }
                    </div>
                }

                <label>Nhập email của bạn</label>
                <input type="email"
                       name="email"
                       placeholder="Email"
                       value="@ViewBag.AdminEmail"
                       required />

                <label>Nhập mật khẩu của bạn</label>
                <input type="password"
                       name="password"
                       placeholder="Mật khẩu"
                       value="@ViewBag.AdminPassword"
                       required />

                <div class="forgot">
                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="forgot-link">
                        Quên mật khẩu
                    </a>

                </div>

                @if (ViewBag.Error != null)
                {
                    <p class="error-text">@ViewBag.Error</p>
                }

                <div class="login-actions">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn-outline">
                        Đăng ký
                    </a>

                    <button type="submit" class="btn-primary">
                        Đăng nhập
                    </button>
                </div>

                <div class="divider">
                    <span>hoặc</span>
                </div>

                <!-- GOOGLE LOGIN -->
                <a asp-controller="Account"
                   asp-action="GoogleLogin"
                   class="btn-google">
                    <i class="fab fa-google"></i>
                    Tiếp tục với Google
                </a>
            </form>
        </div>

    </div>
</section>
