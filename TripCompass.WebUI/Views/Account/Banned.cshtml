@{
    ViewData["Title"] = "Tài khoản bị khóa";
    Layout = "_Layout";
}

<div class="container py-5" style="max-width: 620px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
                <div class="me-3">
                    <i class="fas fa-user-lock fa-2x text-danger"></i>
                </div>
                <div>
                    <h4 class="mb-1">Tài khoản đã bị khóa</h4>
                    <p class="text-muted mb-0">Vui lòng liên hệ quản trị viên để được hỗ trợ.</p>
                </div>
            </div>

            @if (ViewBag.Error is string errorMsg && !string.IsNullOrWhiteSpace(errorMsg))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMsg
                </div>
            }

            <div class="mt-4 d-flex gap-2">
                <a href="/Account/Logout" class="btn btn-outline-secondary">
                    <i class="fas fa-sign-out-alt me-1"></i> Đăng xuất
                </a>
                <a href="/Account/Login" class="btn btn-primary">
                    <i class="fas fa-arrow-right-to-bracket me-1"></i> Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>
