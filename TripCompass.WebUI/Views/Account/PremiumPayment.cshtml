@model TripCompass.Domain.Entities.PremiumOrder
@{
    ViewData["Title"] = "Thanh toán Premium - TripCompass";
    Layout = "_Layout";

    // VietQR: tạo QR động theo từng đơn hàng (MB + số tiền + nội dung PREMIUM-{OrderId})
    // Ref: https://vietqr.io/
    var addInfo = $"PREMIUM-{Model.OrderId}";
    var amount = (int)Math.Round(Model.Amount, MidpointRounding.AwayFromZero);
    var qrUrl =
        "https://img.vietqr.io/image/MB-68161397979-compact2.png" +
        $"?amount={amount}" +
        $"&addInfo={Uri.EscapeDataString(addInfo)}" +
        $"&accountName={Uri.EscapeDataString("Nguyen Xuan Linh")}";
}

<div class="payment-page">
    <div class="container">
        <div class="payment-card">
            <div class="payment-header">
                <h1>Thanh toán gói Premium</h1>
                <p class="order-id">Mã đơn hàng: #@Model.OrderId</p>
            </div>

            <div class="payment-info">
                <div class="info-row">
                    <span class="label">Gói:</span>
                    <span class="value">@Model.PlanCode (@(Model.PlanType == "monthly" ? "Hàng tháng" : "Hàng năm"))</span>
                </div>
                <div class="info-row">
                    <span class="label">Số tiền:</span>
                    <span class="value amount">@Model.Amount.ToString("N0")₫</span>
                </div>
                <div class="info-row">
                    <span class="label">Thời hạn:</span>
                    <span class="value">@(Model.ExpiresAt?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                </div>
            </div>

            <div class="payment-instructions">
                <h3>Hướng dẫn thanh toán</h3>
                <ol>
                    <li>Chuyển khoản số tiền <strong>@Model.Amount.ToString("N0")₫</strong> đến tài khoản:</li>
                </ol>
                
                <div class="qr-section">
                    <div class="qr-title">Quét QR để thanh toán nhanh</div>
                    <div class="qr-wrap">
                        <img class="qr-img" src="@qrUrl" alt="QR thanh toán VietQR" />
                    </div>
                    <div class="qr-hint">
                        QR đã bao gồm <strong>MB Bank</strong>, <strong>@Model.Amount.ToString("N0")₫</strong> và nội dung <strong>@addInfo</strong>.
                    </div>
                    <div class="qr-actions">
                        <a class="btn btn-secondary" href="@qrUrl" target="_blank" rel="noopener noreferrer">Mở QR</a>
                    </div>
                </div>

                <div class="bank-info">
                    <div class="bank-item">
                        <span class="bank-label">Ngân hàng:</span>
                        <span class="bank-value">MB Bank</span>
                    </div>
                    <div class="bank-item">
                        <span class="bank-label">Số tài khoản:</span>
                        <span class="bank-value">68161397979</span>
                    </div>
                    <div class="bank-item">
                        <span class="bank-label">Chủ tài khoản:</span>
                        <span class="bank-value">Nguyen Xuan Linh</span>
                    </div>
                    <div class="bank-item highlight">
                        <span class="bank-label">Nội dung chuyển khoản:</span>
                        <span class="bank-value payment-ref">PREMIUM-@Model.OrderId</span>
                        <button class="copy-btn" onclick="copyPaymentRef()">📋</button>
                    </div>
                </div>

                <div class="warning-box">
                    <strong>⚠️ Lưu ý quan trọng:</strong>
                    <ul>
                        <li>Vui lòng chuyển khoản đúng số tiền và nội dung chuyển khoản</li>
                        <li>Hệ thống sẽ tự động kích hoạt gói Premium sau khi nhận được thanh toán (thường trong vòng 5-10 phút)</li>
                        <li>Nếu sau 30 phút chưa được kích hoạt, vui lòng liên hệ hỗ trợ</li>
                    </ul>
                </div>
            </div>

            <div class="payment-actions">
                <a href="/Home/Premium" class="btn btn-secondary">Quay lại</a>
                <button onclick="checkPayment()" class="btn btn-primary">Đã chuyển khoản</button>
            </div>

            <div id="payment-status" style="display: none; margin-top: 20px; padding: 15px; border-radius: 8px; text-align: center;"></div>
        </div>
    </div>
</div>

<style>
    .payment-page {
        min-height: 100vh;
        background: #f9fafb;
        padding: 40px 20px;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    .payment-card {
        background: white;
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .payment-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #e5e7eb;
    }

    .payment-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 10px;
    }

    .order-id {
        color: #6b7280;
        font-size: 14px;
    }

    .payment-info {
        background: #f9fafb;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .label {
        font-weight: 500;
        color: #6b7280;
    }

    .value {
        font-weight: 600;
        color: #111827;
    }

    .amount {
        color: #1e40af;
        font-size: 20px;
    }

    .payment-instructions {
        margin-bottom: 30px;
    }

    .payment-instructions h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #111827;
    }

    .payment-instructions ol {
        margin-left: 20px;
        margin-bottom: 20px;
    }

    .payment-instructions li {
        margin-bottom: 10px;
        line-height: 1.6;
        color: #374151;
    }

    .bank-info {
        background: #f0f9ff;
        border: 2px solid #1e40af;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
    }

    .qr-section {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        margin: 20px 0;
        text-align: center;
    }

    .qr-title {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 12px;
    }

    .qr-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 12px;
    }

    .qr-img {
        width: 260px;
        height: 260px;
        object-fit: contain;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #fff;
    }

    .qr-hint {
        font-size: 14px;
        color: #374151;
        line-height: 1.5;
        margin-bottom: 12px;
    }

    .qr-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .bank-item {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #bfdbfe;
    }

    .bank-item:last-child {
        border-bottom: none;
    }

    .bank-item.highlight {
        background: #dbeafe;
        padding: 15px;
        border-radius: 6px;
        margin-top: 10px;
    }

    .bank-label {
        font-weight: 600;
        color: #1e40af;
        min-width: 180px;
    }

    .bank-value {
        flex: 1;
        font-weight: 600;
        color: #111827;
        font-family: monospace;
    }

    .payment-ref {
        font-size: 18px;
        color: #1e40af;
    }

    .copy-btn {
        background: #1e40af;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
        margin-left: 10px;
        font-size: 16px;
    }

    .copy-btn:hover {
        background: #1e3a8a;
    }

    .warning-box {
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        padding: 15px;
        border-radius: 6px;
        margin-top: 20px;
    }

    .warning-box strong {
        color: #92400e;
        display: block;
        margin-bottom: 10px;
    }

    .warning-box ul {
        margin: 10px 0 0 20px;
        color: #78350f;
    }

    .warning-box li {
        margin-bottom: 5px;
    }

    .payment-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 32px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: #1e40af;
        color: white;
    }

    .btn-primary:hover {
        background: #1e3a8a;
    }

    .btn-secondary {
        background: #e5e7eb;
        color: #374151;
    }

    .btn-secondary:hover {
        background: #d1d5db;
    }

    @@media (max-width: 768px) {
        .payment-card {
            padding: 20px;
        }

        .qr-img {
            width: 220px;
            height: 220px;
        }

        .bank-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .bank-label {
            min-width: auto;
            margin-bottom: 5px;
        }

        .payment-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }
    }
</style>

<script>
    function copyPaymentRef() {
        const ref = 'PREMIUM-@Model.OrderId';
        navigator.clipboard.writeText(ref).then(() => {
            alert('Đã sao chép mã thanh toán: ' + ref);
        });
    }

    function checkPayment() {
        const orderId = @Model.OrderId;
        const statusDiv = document.getElementById('payment-status');
        statusDiv.style.display = 'block';
        statusDiv.innerHTML = '<p>Đang kiểm tra thanh toán...</p>';

        fetch('/Account/CheckPremiumPayment?orderId=' + orderId)
            .then(response => response.json())
            .then(data => {
                if (data.paid) {
                    statusDiv.innerHTML = '<div style="color: #10b981; font-weight: 600;">✓ Thanh toán thành công! Đang chuyển hướng...</div>';
                    setTimeout(() => {
                        window.location.href = '/Account/Profile';
                    }, 2000);
                } else {
                    statusDiv.innerHTML = '<div style="color: #f59e0b;">Chưa nhận được thanh toán. Vui lòng đợi thêm vài phút hoặc liên hệ hỗ trợ.</div>';
                }
            })
            .catch(error => {
                statusDiv.innerHTML = '<div style="color: #ef4444;">Có lỗi xảy ra. Vui lòng thử lại sau.</div>';
            });
    }
</script>
