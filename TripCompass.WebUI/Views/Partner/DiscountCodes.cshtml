@model TripCompass.WebUI.ViewModels.Partner.DiscountCodesListViewModel
@{
    ViewData["Title"] = "Mã giảm giá";
    Layout = "_PartnerDashboardLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/discount-codes.css" />
}

<div class="dc-header">
    <h2>Mã giảm giá</h2>
    <button class="dc-btn" onclick="openDiscountModal()">
        <i class="fa-solid fa-plus"></i> Tạo mã mới
    </button>
</div>

@if (Model == null || Model.Codes == null || Model.Codes.Count == 0)
{
    <div class="dc-empty">
        <i class="fa-solid fa-tag dc-empty-icon"></i>
        <div>Chưa có mã giảm giá nào.</div>
    </div>
}
else
{
    <div class="dc-table">
        <table>
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Giảm giá</th>
                    <th>Mục đích</th>
                    <th>Hạn sử dụng</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var code in Model.Codes)
                {
                    var statusClass = code.IsActive ? "approved" : "pending";
                    var statusText = code.IsActive ? "Đã duyệt" : "Chờ duyệt";
                    <tr>
                        <td><strong>@code.Code</strong></td>
                        <td>@code.PercentOff%</td>
                        <td>@code.Purpose</td>
                        <td>@(code.ExpiryDate.HasValue? code.ExpiryDate.Value.ToLocalTime().ToString("dd/MM/yyyy") : "Không giới hạn")</td>
                        <td>
                            <span class="dc-badge @statusClass">@statusText</span>
                        </td>
                        <td>@code.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal tạo mã giảm giá -->
<div id="discountModal" class="dc-modal">
    <div class="dc-modal-box">
        <div class="dc-modal-header">
            <h3 class="dc-modal-title">Tạo mã giảm giá</h3>
            <button onclick="closeDiscountModal()" class="dc-modal-close">&times;</button>
        </div>
        <form id="discountForm">
            @Html.AntiForgeryToken()
            <div class="dc-modal-form-group">
                <label class="dc-modal-label">Mã giảm giá <span class="required">*</span></label>
                <input type="text" id="discountCode" name="code" required maxlength="30" class="dc-modal-input" placeholder="VD: SUMMER2024" />
            </div>
            <div class="dc-modal-form-group">
                <label class="dc-modal-label">Phần trăm giảm giá <span class="required">*</span></label>
                <input type="number" id="discountPercent" name="percentOff" required min="1" max="100" class="dc-modal-input" placeholder="1-100" />
            </div>
            <div class="dc-modal-form-group">
                <label class="dc-modal-label">Mục đích <span class="required">*</span></label>
                <input type="text" id="discountPurpose" name="purpose" required maxlength="200" class="dc-modal-input" placeholder="VD: Giảm 20% cho đơn hàng từ 500k" />
            </div>
            <div class="dc-modal-form-group">
                <label class="dc-modal-label">Hạn sử dụng</label>
                <input type="date" id="discountExpiry" name="expiryDate" class="dc-modal-input" />
            </div>
            <div class="dc-modal-actions">
                <button type="button" onclick="closeDiscountModal()" class="dc-modal-btn dc-modal-btn-cancel">Hủy</button>
                <button type="submit" class="dc-modal-btn dc-modal-btn-submit">Tạo mã</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openDiscountModal() {
        const modal = document.getElementById('discountModal');
        if (modal) {
            modal.classList.add('active');
        }
    }
    function closeDiscountModal() {
        const modal = document.getElementById('discountModal');
        const form = document.getElementById('discountForm');
        if (modal) {
            modal.classList.remove('active');
        }
        if (form) {
            form.reset();
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('discountForm');
        const modal = document.getElementById('discountModal');

        if (form) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const submitBtn = this.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                submitBtn.textContent = 'Đang tạo...';
                try {
                    const response = await fetch('/Partner/CreateDiscountCode', {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                    });
                    const result = await response.json();
                    if (result.success) {
                        alert(result.message);
                        window.location.reload();
                    } else {
                        alert(result.message);
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Tạo mã';
                    }
                } catch (error) {
                    alert('Có lỗi xảy ra. Vui lòng thử lại.');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Tạo mã';
                }
            });
        }

        // Close modal khi click outside
        if (modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === this) closeDiscountModal();
            });
        }
    });
</script>
