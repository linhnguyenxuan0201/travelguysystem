@model TripCompass.WebUI.ViewModels.Partner.PartnerDashboardViewModel

@{
    ViewData["Title"] = "Quản lý shop";
    Layout = "_PartnerDashboardLayout";
}

<style>
    .pd-topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom: 18px; }
    .pd-title h2 { margin:0; font-size:20px; font-weight:900; color:#111827; }
    .pd-title p { margin:4px 0 0 0; color:#6b7280; font-size:13px; }
    .pd-actions { display:flex; gap:10px; align-items:center; }
    .pd-btn { height:36px; padding:0 12px; border-radius:10px; border:1px solid #e5e7eb; background:#fff; font-weight:700; cursor:pointer; }
    .pd-btn.primary { background:#2563eb; color:#fff; border-color:#2563eb; }

    .pd-kpis { display:grid; grid-template-columns: repeat(4, 1fr); gap:12px; margin-bottom: 14px; }
    .pd-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:14px; display:flex; justify-content:space-between; gap:10px; }
    .pd-kpi .meta { display:flex; flex-direction:column; gap:6px; }
    .pd-kpi .label { font-size:12px; color:#6b7280; font-weight:700; }
    .pd-kpi .value { font-size:20px; color:#111827; font-weight:900; }
    .pd-kpi .sub { font-size:12px; color:#10b981; font-weight:700; }
    .pd-kpi .icon { width:36px; height:36px; border-radius:12px; display:grid; place-items:center; font-weight:900; }
    .ic-green { background:#dcfce7; color:#16a34a; }
    .ic-blue { background:#dbeafe; color:#2563eb; }
    .ic-purple { background:#ede9fe; color:#7c3aed; }
    .ic-orange { background:#ffedd5; color:#ea580c; }

    .pd-grid { display:grid; grid-template-columns: 2fr 1fr; gap:12px; margin-top: 12px; }
    .pd-card { background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:14px; }
    .pd-card h3 { margin:0 0 10px 0; font-size:14px; font-weight:900; color:#111827; }
    .pd-list { display:flex; flex-direction:column; gap:10px; }
    .pd-row { display:flex; align-items:center; justify-content:space-between; padding:10px; border-radius:12px; background:#f9fafb; border:1px solid #f3f4f6; }
    .pd-row .left { display:flex; flex-direction:column; gap:2px; }
    .pd-row .left .t { font-weight:900; font-size:13px; color:#111827; }
    .pd-row .left .s { font-size:12px; color:#6b7280; }
    .pd-row .amt { font-weight:900; color:#111827; font-size:13px; }
    .pd-badge { font-size:11px; font-weight:900; padding:3px 8px; border-radius:999px; }
    .b-ok { background:#dcfce7; color:#16a34a; }
    .b-proc { background:#dbeafe; color:#2563eb; }
    .b-can { background:#fee2e2; color:#dc2626; }

    .pd-two { display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-top:12px; }

    @@media (max-width: 1024px) {
        .pd-kpis { grid-template-columns: 1fr 1fr; }
        .pd-grid { grid-template-columns: 1fr; }
        .pd-two { grid-template-columns: 1fr; }
    }
</style>

@if (TempData["Message"] != null)
{
    <div class="pd-card" style="border-color:#fde68a; background:#fffbeb; color:#92400e; margin-bottom:12px;">
        @TempData["Message"]
    </div>
}

<div class="pd-topbar">
    <div class="pd-title">
        <h2>Dashboard Quản lý</h2>
        <p>Chào mừng bạn trở lại, theo dõi hoạt động shop</p>
    </div>
    <div class="pd-actions">
        <button class="pd-btn"><i class="fa-regular fa-bell"></i></button>
        <button class="pd-btn primary"><i class="fa-solid fa-plus"></i> Tạo mới</button>
    </div>
</div>

<div class="pd-kpis">
    <div class="pd-kpi">
        <div class="meta">
            <div class="label">Tổng doanh thu</div>
            <div class="value">@Model.TotalRevenue.ToString("N0")</div>
            <div class="sub">+12.5% so với tháng trước</div>
        </div>
        <div class="icon ic-green"><i class="fa-solid fa-dollar-sign"></i></div>
    </div>
    <div class="pd-kpi">
        <div class="meta">
            <div class="label">Đơn hàng mới</div>
            <div class="value">@Model.NewOrders</div>
            <div class="sub">+8.2% so với tuần trước</div>
        </div>
        <div class="icon ic-blue"><i class="fa-solid fa-cart-shopping"></i></div>
    </div>
    <div class="pd-kpi">
        <div class="meta">
            <div class="label">Số dư ví</div>
            <div class="value">@Model.WalletBalance.ToString("N0")</div>
            <div class="sub">Khả dụng</div>
        </div>
        <div class="icon ic-purple"><i class="fa-solid fa-wallet"></i></div>
    </div>
    <div class="pd-kpi" style="cursor:pointer;" onclick="openDiscountModal()">
        <div class="meta">
            <div class="label">Mã giảm giá</div>
            <div class="value">@Model.ActiveDiscountCodes</div>
            <div class="sub">Đang hoạt động</div>
        </div>
        <div class="icon ic-orange"><i class="fa-solid fa-tag"></i></div>
    </div>
</div>

<div class="pd-grid">
    <div class="pd-card">
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <h3>Doanh thu theo tháng</h3>
            <select class="pd-btn" style="height:32px;">
                <option>@DateTime.UtcNow.Year</option>
            </select>
        </div>
        <div style="height:260px; background:#eff6ff; border:1px solid #dbeafe; border-radius:12px; display:grid; place-items:center; color:#2563eb; font-weight:900;">
            (Chart placeholder) Tổng @Model.MonthlyRevenue.Sum(x => x.Amount).ToString("N0")
        </div>
    </div>

    <div class="pd-card" id="orders">
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <h3>Đơn hàng gần đây</h3>
            <a href="/Partner/Orders" style="font-size:12px; font-weight:800; color:#2563eb; text-decoration:none;">Xem tất cả</a>
        </div>
        <div class="pd-list">
            @if (Model.RecentOrders.Count == 0)
            {
                <div style="color:#6b7280; font-size:13px;">Chưa có đơn đặt chỗ nào.</div>
            }
            else
            {
                foreach (var o in Model.RecentOrders)
                {
                    var badgeClass = o.Status == "Completed" ? "b-ok" : (o.Status == "Cancelled" ? "b-can" : "b-proc");
                    <div class="pd-row">
                        <div class="left">
                            <div class="t">#@o.BookingId - @o.PostTitle</div>
                            <div class="s">@o.BookedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                            <div class="amt">@o.TotalAmount.ToString("N0")</div>
                            <span class="pd-badge @badgeClass">@o.Status</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="pd-two">
    <div class="pd-card" id="discounts">
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <h3>Mã giảm giá hoạt động</h3>
            <button class="pd-btn primary" style="height:32px;" type="button" onclick="openDiscountModal()"><i class="fa-solid fa-plus"></i> Tạo mã mới</button>
        </div>
        <div class="pd-list">
            @if (Model.DiscountCodes.Count == 0)
            {
                <div style="color:#6b7280; font-size:13px;">Chưa có mã giảm giá.</div>
            }
            else
            {
                foreach (var c in Model.DiscountCodes)
                {
                    <div class="pd-row" style="background:#fff;">
                        <div class="left">
                            <div class="t">@c.Code</div>
                            <div class="s">
                                @c.Purpose
                                @if (c.ExpiryDate != null)
                                {
                                    <text> • HSD: @c.ExpiryDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</text>
                                }
                            </div>
                        </div>
                        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                            <div class="amt">@c.PercentOff<text>%</text></div>
                            <span class="pd-badge @(c.IsActive ? "b-ok" : "b-can")">@(c.IsActive ? "Đang hoạt động" : "Tạm dừng")</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="pd-card" id="wallet">
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <h3>Quản lý ví tiền</h3>
            <form asp-controller="Partner" asp-action="Withdraw" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button class="pd-btn primary" type="submit" style="height:32px;"><i class="fa-solid fa-arrow-up-right-from-square"></i> Rút tiền</button>
            </form>
        </div>
        <div style="margin-top:10px; border-radius:14px; background:linear-gradient(135deg,#4f46e5,#2563eb); color:#fff; padding:16px;">
            <div style="font-size:12px; opacity:0.9; font-weight:700;">Số dư khả dụng</div>
            <div style="font-size:22px; font-weight:900; margin-top:6px;">@Model.WalletBalance.ToString("N0")</div>
        </div>
        <div class="pd-list" style="margin-top:12px;">
            @if (Model.WalletActivities.Count == 0)
            {
                <div style="color:#6b7280; font-size:13px;">Chưa có giao dịch ví.</div>
            }
            else
            {
                foreach (var a in Model.WalletActivities)
                {
                    <div class="pd-row">
                        <div class="left">
                            <div class="t">@a.Label</div>
                            <div class="s">@a.At.ToLocalTime().ToString("dd/MM HH:mm")</div>
                        </div>
                        <div class="amt" style="color:@(a.Amount >= 0 ? "#16a34a" : "#dc2626")">
                            @(a.Amount >= 0 ? "+" : "")@a.Amount.ToString("N0")
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Create Discount Code Modal -->
<div id="discountModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.55); align-items:center; justify-content:center; z-index:9999;">
    <div style="width:520px; max-width: calc(100vw - 24px); background:#fff; border-radius:16px; box-shadow:0 20px 50px rgba(0,0,0,0.25); overflow:hidden;">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:16px 18px; border-bottom:1px solid #e5e7eb;">
            <div style="font-weight:900; color:#111827;">Tạo mã giảm giá</div>
            <button type="button" class="pd-btn" style="height:32px;" onclick="closeDiscountModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="createDiscountForm" method="post" style="padding:18px;">
            @Html.AntiForgeryToken()
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div>
                    <label style="display:block; font-size:12px; font-weight:800; color:#374151; margin-bottom:6px;">Code *</label>
                    <input name="code" id="dc_code" class="pd-btn" style="width:100%; height:40px; text-align:left;" placeholder="VD: SUMMER2026" maxlength="30" required />
                </div>
                <div>
                    <label style="display:block; font-size:12px; font-weight:800; color:#374151; margin-bottom:6px;">Phần trăm giảm *</label>
                    <input name="percentOff" id="dc_percent" type="number" min="1" max="100" class="pd-btn" style="width:100%; height:40px; text-align:left;" placeholder="10" required />
                </div>
                <div style="grid-column: 1 / -1;">
                    <label style="display:block; font-size:12px; font-weight:800; color:#374151; margin-bottom:6px;">Mục đích *</label>
                    <input name="purpose" id="dc_purpose" class="pd-btn" style="width:100%; height:40px; text-align:left;" placeholder="Dùng để làm gì..." maxlength="200" required />
                </div>
                <div>
                    <label style="display:block; font-size:12px; font-weight:800; color:#374151; margin-bottom:6px;">Hạn sử dụng</label>
                    <input name="expiryDate" id="dc_expiry" type="date" class="pd-btn" style="width:100%; height:40px; text-align:left;" />
                </div>
                <div style="display:flex; align-items:flex-end; justify-content:flex-end; gap:10px;">
                    <button type="button" class="pd-btn" style="height:40px;" onclick="closeDiscountModal()">Hủy</button>
                    <button type="submit" id="dc_submit" class="pd-btn primary" style="height:40px;">Tạo mã</button>
                </div>
            </div>
            <div id="dc_error" style="margin-top:10px; color:#dc2626; font-weight:700; font-size:13px; display:none;"></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openDiscountModal() {
        document.getElementById('discountModal').style.display = 'flex';
    }
    function closeDiscountModal() {
        document.getElementById('discountModal').style.display = 'none';
        const err = document.getElementById('dc_error');
        err.style.display = 'none';
        err.textContent = '';
    }

    document.getElementById('discountModal').addEventListener('click', function (e) {
        if (e.target && e.target.id === 'discountModal') closeDiscountModal();
    });

    document.getElementById('createDiscountForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn = document.getElementById('dc_submit');
        const err = document.getElementById('dc_error');
        err.style.display = 'none';
        err.textContent = '';

        btn.disabled = true;
        btn.textContent = 'Đang tạo...';

        try {
            const formData = new FormData(this);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const response = await fetch('/Partner/CreateDiscountCode', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json',
                    ...(token ? { 'RequestVerificationToken': token } : {})
                }
            });

            const result = await response.json();
            if (result.success) {
                alert(result.message || 'Tạo mã thành công!');
                window.location.reload();
            } else {
                err.textContent = result.message || 'Tạo mã thất bại.';
                err.style.display = 'block';
                btn.disabled = false;
                btn.textContent = 'Tạo mã';
            }
        } catch (ex) {
            err.textContent = 'Có lỗi xảy ra. Vui lòng thử lại.';
            err.style.display = 'block';
            btn.disabled = false;
            btn.textContent = 'Tạo mã';
        }
    });
</script>
}

