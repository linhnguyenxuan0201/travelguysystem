@model List<TripCompass.Application.DTOs.ActivityHistoryDto>

@{
    ViewData["Title"] = "Lịch sử hoạt động";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 20;
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<style>
    :root {
        --font-main: 'Inter', sans-serif;
        --color-bg: #f3f4f6;
        --color-card: #ffffff;
        --color-text-main: #111827;
        --color-text-sub: #6b7280;
        --border-color: #e5e7eb;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    body {
        background-color: var(--color-bg);
        font-family: var(--font-main);
        color: var(--color-text-main);
        font-size: 0.875rem;
    }

    /* Card Styling */
    .card-pro {
        background: var(--color-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: var(--shadow-sm);
        transition: box-shadow 0.2s;
    }

        .card-pro:hover {
            box-shadow: var(--shadow-md);
        }

    /* Headers */
    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        color: #1f2937;
    }

    .section-title {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        color: var(--color-text-sub);
    }

    /* Inputs */
    .form-control, .form-select {
        border-radius: 8px;
        border-color: var(--border-color);
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
        }

    /* Table Styling */
    .table-pro thead th {
        background-color: #f9fafb;
        color: var(--color-text-sub);
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.875rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .table-pro tbody td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #f3f4f6;
        color: var(--color-text-main);
    }

    .table-pro tr:last-child td {
        border-bottom: none;
    }

    /* Custom Icon Box Mapping */
    .icon-box {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }
        /* Soft Colors based on logic classes */
        .icon-box.danger {
            background-color: #fee2e2;
            color: #ef4444;
        }

        .icon-box.success {
            background-color: #dcfce7;
            color: #22c55e;
        }

        .icon-box.warning {
            background-color: #fef3c7;
            color: #f59e0b;
        }

        .icon-box.info {
            background-color: #e0f2fe;
            color: #0ea5e9;
        }

        .icon-box.primary {
            background-color: #e0e7ff;
            color: #4f46e5;
        }

        .icon-box.secondary {
            background-color: #f3f4f6;
            color: #6b7280;
        }

    /* Chips & Badges */
    .target-chip {
        display: inline-block;
        padding: 2px 8px;
        background-color: #f3f4f6;
        border-radius: 6px;
        font-family: 'Consolas', monospace;
        font-size: 0.75rem;
        color: #4b5563;
        border: 1px solid #e5e7eb;
    }

    .note-text {
        max-width: 280px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--color-text-sub);
    }

    /* Admin Avatar Placeholder */
    .avatar-circle {
        width: 32px;
        height: 32px;
        background-color: #e5e7eb;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: #4b5563;
        font-size: 0.75rem;
    }

    /* Pagination */
    .pagination .page-link {
        border: 1px solid var(--border-color);
        margin: 0 3px;
        border-radius: 6px;
        color: var(--color-text-sub);
        padding: 0.375rem 0.75rem;
    }

    .pagination .page-item.active .page-link {
        background-color: #111827; /* Dark theme */
        border-color: #111827;
        color: white;
    }
</style>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title">Lịch sử hoạt động</h1>
            <p class="text-muted small mb-0">Theo dõi toàn bộ nhật ký hệ thống</p>
        </div>
        <a href="/Admin/Portal" class="btn btn-outline-secondary bg-white shadow-sm border">
            <i class="fas fa-arrow-left me-2"></i>Quay lại Portal
        </a>
    </div>

    <div class="card card-pro mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="section-title mb-2">Từ khóa</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="SearchTerm" class="form-control border-start-0 ps-0 bg-light"
                               placeholder="Tìm kiếm..." value="@ViewBag.SearchTerm" />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="section-title mb-2">Hành động</label>
                    <select name="ActionType" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="BAN_USER" selected="@(ViewBag.ActionType == "BAN_USER")">Khóa người dùng</option>
                        <option value="UNBAN_USER" selected="@(ViewBag.ActionType == "UNBAN_USER")">Mở khóa người dùng</option>
                        <option value="CHANGE_POST_STATUS" selected="@(ViewBag.ActionType == "CHANGE_POST_STATUS")">Đổi trạng thái bài</option>
                        <option value="UPDATE_POST" selected="@(ViewBag.ActionType == "UPDATE_POST")">Cập nhật bài viết</option>
                        <option value="DELETE_POST" selected="@(ViewBag.ActionType == "DELETE_POST")">Xóa bài viết</option>
                        <option value="APPROVE_POST" selected="@(ViewBag.ActionType == "APPROVE_POST")">Duyệt bài viết</option>
                        <option value="REJECT_POST" selected="@(ViewBag.ActionType == "REJECT_POST")">Từ chối bài viết</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="section-title mb-2">Bảng đích</label>
                    <select name="TargetTable" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="Users" selected="@(ViewBag.TargetTable == "Users")">Users</option>
                        <option value="Posts" selected="@(ViewBag.TargetTable == "Posts")">Posts</option>
                        <option value="Comments" selected="@(ViewBag.TargetTable == "Comments")">Comments</option>
                        <option value="Reports" selected="@(ViewBag.TargetTable == "Reports")">Reports</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="section-title mb-2">Thời gian</label>
                    <div class="d-flex gap-2">
                        <input type="date" name="FromDate" class="form-control" value="@ViewBag.FromDate" />
                        <input type="date" name="ToDate" class="form-control" value="@ViewBag.ToDate" />
                    </div>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <div class="d-grid gap-2 w-100">
                        <button type="submit" class="btn btn-dark fw-medium">
                            <i class="fas fa-filter me-1"></i> Lọc
                        </button>
                    </div>
                </div>

               
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
        <h5 class="fw-bold mb-0">Danh sách nhật ký</h5>
        <span class="badge bg-white text-dark border shadow-sm px-3 py-2 rounded-pill">
            Tổng: <strong>@totalCount</strong> bản ghi
        </span>
    </div>

    <div class="card card-pro overflow-hidden">
        <div class="table-responsive">
            @if ( Model != null && Model.Any() )
            {
                <table class="table table-pro table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Loại</th>
                            <th>Chi tiết hành động</th>
                            <th>Quản trị viên</th>
                            <th>Đối tượng</th>
                            <th>Ghi chú</th>
                            <th class="text-end pe-4">Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach ( var log in Model )
                        {
                            <tr>
                                <td class="ps-4" style="width: 80px;">
                                    <div class="icon-box @log.ActionColor">
                                        <i class="fas @log.ActionIcon"></i>
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-bold text-dark">@log.ActionDisplayName</div>
                                    <small class="text-muted font-monospace" style="font-size: 0.7rem;">CODE: @log.ActionType</small>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-2">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium text-dark" style="font-size: 0.85rem;">@log.AdminName</div>
                                            <small class="text-muted" style="font-size: 0.75rem;">@log.AdminEmail</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="target-chip">
                                        @log.TargetTable <span class="text-muted mx-1">|</span> #@log.TargetId
                                    </span>
                                </td>

                                <td>
                                    <div class="note-text" title="@log.Note">
                                        @(string.IsNullOrEmpty(log.Note) ? "-" : log.Note)
                                    </div>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="fw-medium">@log.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">
                                        @{
                                            var timeSpan = DateTime.UtcNow - log.CreatedAt;
                                            string timeAgo;
                                            if ( timeSpan.TotalDays >= 7 )
                                                timeAgo = $"{(int)timeSpan.TotalDays / 7} tuần trước";
                                            else if ( timeSpan.TotalDays >= 1 )
                                                timeAgo = $"{(int)timeSpan.TotalDays} ngày trước";
                                            else if ( timeSpan.TotalHours >= 1 )
                                                timeAgo = $"{(int)timeSpan.TotalHours} giờ trước";
                                            else if ( timeSpan.TotalMinutes >= 1 )
                                                timeAgo = $"{(int)timeSpan.TotalMinutes} phút trước";
                                            else
                                                timeAgo = "Vừa xong";
                                        }
                                        @timeAgo
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center p-5">
                    <div class="mb-3">
                        <i class="fas fa-folder-open fa-3x text-light-gray" style="color: #e5e7eb;"></i>
                    </div>
                    <h6 class="text-muted fw-bold">Không tìm thấy dữ liệu</h6>
                    <p class="text-muted small">Vui lòng thử điều chỉnh bộ lọc tìm kiếm.</p>
                </div>
            }
        </div>

        @if ( totalPages > 1 )
        {
            <div class="card-footer bg-white border-top p-3">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @if ( currentPage > 1 )
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(currentPage - 1)&ActionType=@ViewBag.ActionType&TargetTable=@ViewBag.TargetTable&FromDate=@ViewBag.FromDate&ToDate=@ViewBag.ToDate&SearchTerm=@ViewBag.SearchTerm">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        }

                        @for ( int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++ )
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i&ActionType=@ViewBag.ActionType&TargetTable=@ViewBag.TargetTable&FromDate=@ViewBag.FromDate&ToDate=@ViewBag.ToDate&SearchTerm=@ViewBag.SearchTerm">
                                    @i
                                </a>
                            </li>
                        }

                        @if ( currentPage < totalPages )
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@(currentPage + 1)&ActionType=@ViewBag.ActionType&TargetTable=@ViewBag.TargetTable&FromDate=@ViewBag.FromDate&ToDate=@ViewBag.ToDate&SearchTerm=@ViewBag.SearchTerm">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>