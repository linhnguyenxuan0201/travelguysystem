@model List<TripCompass.Application.DTOs.UserListItemDto>

@{
    ViewData["Title"] = "User Management";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string searchTerm = ViewBag.SearchTerm;
    string status = ViewBag.Status;
    string selectedRole = ViewBag.Role;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #f4f6f9;
    }

    .page-header h3 {
        margin-bottom: 4px;
    }

    .card {
        border-radius: 14px;
        border: none;
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }

    table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6c757d;
    }

    table td {
        vertical-align: middle;
    }

    .user-name {
        font-weight: 600;
    }

    .badge-role {
        background-color: #e9ecef;
        color: #495057;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>

<div class="container-fluid p-4">

    <!-- HEADER -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold">User Management</h3>
            <small class="text-muted">Manage users, roles and account status</small>
        </div>

        <!-- FILTER -->
        <form method="get" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Status</option>
                <option value="active" @(status == "active" ? "selected" : "")>Active</option>
                <option value="banned" @(status == "banned" ? "selected" : "")>Banned</option>
            </select>

            <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Roles</option>
                <option value="Admin" @(selectedRole == "Admin" ? "selected" : "")>Admin</option>
                <option value="Moderator" @(selectedRole == "Moderator" ? "selected" : "")>Moderator</option>
                <option value="User" @(selectedRole == "User" ? "selected" : "")>User</option>
            </select>

            <input type="text"
                   name="searchTerm"
                   class="form-control form-control-sm"
                   placeholder="Search user..."
                   value="@searchTerm" />

            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-search me-1"></i>Search
            </button>
        </form>
    </div>

    <!-- TABLE -->
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Reputation</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach ( var user in Model )
                    {
                        <tr>
                            <td class="ps-3">@user.UserId</td>

                            <td>
                                <div class="user-name">@user.UserName</div>
                            </td>

                            <td>@user.Email</td>

                            <td>
                                @foreach ( var roleName in user.Roles.Split(',') )
                                {
                                    if ( !string.IsNullOrWhiteSpace(roleName) )
                                    {
                                        <span class="badge badge-role me-1">@roleName.Trim()</span>
                                    }
                                }
                            </td>

                            <td>
                                <span class="fw-semibold">@user.ReputationScore</span>
                            </td>

                            <td>
                                @if ( user.IsBanned )
                                {
                                    <span class="badge bg-danger">Banned</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>

                            <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>

                            <td class="text-end pe-3">
                                @if ( user.IsBanned )
                                {
                                    <form asp-action="Unban"
                                          asp-route-id="@user.UserId"
                                          method="post"
                                          class="d-inline">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('Unban this user?')">
                                            <i class="fas fa-unlock me-1"></i>Unban
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#banModal"
                                            onclick="setBanUserId(@user.UserId, '@user.UserName')">
                                        <i class="fas fa-ban me-1"></i>Ban
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        <div class="card-footer bg-white">
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    @for ( int i = 1; i <= totalPages; i++ )
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               href="?page=@i&searchTerm=@searchTerm&status=@status&role=@selectedRole">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- BACK TO PORTAL -->
<div class="container-fluid px-4 mb-4">
    <a href="/Admin/Portal" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Quay lại Portal
    </a>
</div>

<!-- BAN MODAL -->
<div class="modal fade" id="banModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Ban" id="banForm">
                <div class="modal-header">
                    <h5 class="modal-title">Ban User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p>
                        Are you sure you want to ban
                        <strong id="banUserName"></strong>?
                    </p>

                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <textarea class="form-control"
                                  name="reason"
                                  rows="3"
                                  required></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        Ban User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setBanUserId(id, name) {
        document.getElementById('banForm').action = '/Admin/User/Ban/' + id;
        document.getElementById('banUserName').innerText = name;
    }
</script>
