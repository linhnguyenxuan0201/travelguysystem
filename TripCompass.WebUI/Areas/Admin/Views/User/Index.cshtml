@model List<TripCompass.Application.DTOs.UserListItemDto>

@{
    ViewData["Title"] = "User Management";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string searchTerm = ViewBag.SearchTerm;
    string status = ViewBag.Status;
    string selectedRole = ViewBag.Role;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #f4f6f9;
    }

    .page-header h3 {
        margin-bottom: 4px;
    }

    .card {
        border-radius: 14px;
        border: none;
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }

    table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6c757d;
    }

    table td {
        vertical-align: middle;
    }

    .user-name {
        font-weight: 600;
    }

    .badge-role {
        background-color: #e9ecef;
        color: #495057;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .form-select-sm {
        min-width: 110px;
    }
</style>

<div class="container-fluid p-4">

    <!-- HEADER -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold">User Management</h3>
            <small class="text-muted">Manage users, roles and account status</small>
        </div>

        <!-- FILTER -->
        <form method="get" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Status</option>
                @if (status == "Active")
                {
                    <option value="Active" selected>Active</option>
                }
                else
                {
                    <option value="Active">Active</option>
                }

                @if (status == "Banned")
                {
                    <option value="Banned" selected>Banned</option>
                }
                else
                {
                    <option value="Banned">Banned</option>
                }
            </select>

            <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Roles</option>
                @if (selectedRole == "Admin") { <option value="Admin" selected>Admin</option> } else { <option value="Admin">Admin</option> }
                @if (selectedRole == "Moderator") { <option value="Moderator" selected>Moderator</option> } else { <option value="Moderator">Moderator</option> }
                @if (selectedRole == "Staff") { <option value="Staff" selected>Staff</option> } else { <option value="Staff">Staff</option> }
                @if (selectedRole == "User") { <option value="User" selected>User</option> } else { <option value="User">User</option> }
            </select>

            <input type="text"
                   name="searchTerm"
                   class="form-control form-control-sm"
                   placeholder="Search user..."
                   value="@searchTerm" />

            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-search me-1"></i>Search
            </button>
        </form>
    </div>

    <!-- TABLE -->
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>User</th>
                        <th>Email</th>
                        <th style="width: 160px;">Role</th>
                        <th>Reputation</th>
                        <th style="width: 160px;">Status</th>
                        <th>Joined</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach ( var user in Model )
                    {
                        <tr>
                            <td class="ps-3">@user.UserId</td>

                            <td>
                                <div class="user-name">@user.UserName</div>
                            </td>

                            <td>@user.Email</td>

                            <!-- ROLE -->
                            <td>
                                <form asp-action="ChangeRole" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    @Html.AntiForgeryToken()

                                    <select name="role"
                                            class="form-select form-select-sm"
                                            onchange="return confirmChange(this)">
                                        @if (user.Role == "User") { <option value="User" selected>User</option> } else { <option value="User">User</option> }
                                        @if (user.Role == "Staff") { <option value="Staff" selected>Staff</option> } else { <option value="Staff">Staff</option> }
                                        @if (user.Role == "Moderator") { <option value="Moderator" selected>Moderator</option> } else { <option value="Moderator">Moderator</option> }
                                        @if (user.Role == "Admin") { <option value="Admin" selected>Admin</option> } else { <option value="Admin">Admin</option> }
                                    </select>
                                </form>
                            </td>

                            <td>
                                <span class="fw-semibold">@user.ReputationScore</span>
                            </td>

                            <!-- STATUS -->
                            <td>
                                <form asp-action="ChangeStatus" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    @Html.AntiForgeryToken()

                                    <select name="status"
                                            class="form-select form-select-sm"
                                            onchange="return confirmChange(this)">
                                        @if (user.Status == "Active") { <option value="Active" selected>Active</option> } else { <option value="Active">Active</option> }
                                        @if (user.Status == "Banned") { <option value="Banned" selected>Banned</option> } else { <option value="Banned">Banned</option> }
                                    </select>
                                </form>
                            </td>

                            <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        <div class="card-footer bg-white">
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    @for ( int i = 1; i <= totalPages; i++ )
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               href="?page=@i&searchTerm=@searchTerm&status=@status&role=@selectedRole">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- BACK TO PORTAL -->
<div class="container-fluid px-4 mb-4">
    <a href="/Admin/Portal" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Quay lại Portal
    </a>
</div>

<script>
    function confirmChange(select) {
        if (confirm("Are you sure you want to apply this change?")) {
            select.form.submit();
        } else {
            location.reload();
            return false;
        }
    }
</script>
