@using TripCompass.Application.Features.Admin.Locations.GetLocations
@using TripCompass.Application.DTOs
@model List<LocationListItemDto>

@{
    ViewData["Title"] = "Location Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --bs-font-sans-serif: 'Inter', sans-serif;
        --bs-body-color: #3f4254;
        --bs-light-bg: #f9f9fc;
    }

    body {
        background-color: var(--bs-light-bg);
    }

    .card-flush {
        border: none;
        box-shadow: 0 0 20px 0 rgba(76, 87, 125, 0.02);
        background-color: #fff;
        border-radius: 12px;
    }

    .table-custom thead th {
        background-color: #f9f9fc;
        color: #a1a5b7;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #eff2f5;
    }

    .table-custom tbody td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px dashed #eff2f5;
        font-size: 0.95rem;
        color: #5e6278;
    }

    .table-custom tbody tr:hover {
        background-color: #f9f9fc;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex flex-wrap flex-stack pb-4 align-items-center justify-content-between">
    <div>
        <h1 class="fw-bold text-dark fs-3 mb-1">Location Management</h1>
        <span class="text-muted fw-semibold fs-7">Manage locations from posts</span>
    </div>
    <a href="/Admin/Portal" class="btn btn-sm btn-icon btn-light text-muted">
        <i class="fas fa-arrow-left"></i>
    </a>
</div>

<div class="card card-flush shadow-sm">
    <div class="card-header align-items-center py-5 gap-2 gap-md-5">
        <form method="get" class="w-100">
            <div class="row g-3 align-items-center">
                <div class="col-md-6 position-relative">
                    <div class="input-group input-group-solid">
                        <span class="input-group-text bg-light border-0 ps-3">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input name="SearchTerm" type="text"
                               class="form-control form-control-solid bg-light border-0 ps-2"
                               value="@ViewBag.SearchTerm"
                               placeholder="Search by location name..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary fw-bold w-100">
                        Search
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                {
                    <div class="col-md-2">
                        <a href="@Url.Action("Index", "Location", new { area = "Admin" })" class="btn btn-light w-100 text-muted fw-bold">
                            Reset
                        </a>
                    </div>
                }
            </div>
        </form>
    </div>

    <div class="card-body pt-0">
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th style="min-width: 250px;">Location</th>
                        <th style="min-width: 100px;">Posts</th>
                        <th style="min-width: 100px;">Total Views</th>
                        <th style="min-width: 100px;">Total Likes</th>
                        <th style="min-width: 150px;">Last Post</th>
                        <th class="text-end" style="min-width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var location in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-map-marker-alt text-danger me-2"></i>
                                        <span class="text-dark fw-bold">@location.Location</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-primary">@location.PostCount posts</span>
                                </td>

                                <td>
                                    <div class="text-dark fw-semibold">
                                        <i class="fas fa-eye text-primary me-1"></i>@location.TotalViews.ToString("N0")
                                    </div>
                                </td>

                                <td>
                                    <div class="text-dark fw-semibold">
                                        <i class="fas fa-heart text-danger me-1"></i>@location.TotalLikes.ToString("N0")
                                    </div>
                                </td>

                                <td>
                                    @if (location.LastPostDate.HasValue)
                                    {
                                        <div class="text-dark fw-bold fs-7">@location.LastPostDate.Value.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted fs-8">@location.LastPostDate.Value.ToString("HH:mm")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button type="button" class="btn btn-sm btn-primary" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#renameModal"
                                                data-location="@location.Location"
                                                onclick="setRenameLocation('@location.Location')">
                                            <i class="fas fa-edit me-1"></i> Rename
                                        </button>
                                        <button type="button" class="btn btn-sm btn-info" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#mergeModal"
                                                data-location="@location.Location"
                                                onclick="setMergeSourceLocation('@location.Location')">
                                            <i class="fas fa-code-branch me-1"></i> Merge
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="mb-3 text-muted opacity-50 display-1">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <h5 class="text-muted fw-normal">No locations found</h5>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Rename Location Modal -->
<div class="modal fade" id="renameModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rename Location</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Rename" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Current Location</label>
                        <input type="text" class="form-control" id="renameOldLocation" name="OldLocation" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Location Name</label>
                        <input type="text" class="form-control" id="renameNewLocation" name="NewLocation" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Rename</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Merge Location Modal -->
<div class="modal fade" id="mergeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Merge Locations</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Merge" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        This will merge all posts from the source location into the target location. This action cannot be undone.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Source Location (will be merged)</label>
                        <input type="text" class="form-control" id="mergeSourceLocation" name="SourceLocation" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Target Location (will receive all posts)</label>
                        <input type="text" class="form-control" id="mergeTargetLocation" name="TargetLocation" required placeholder="Enter target location name">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info" onclick="return confirm('Are you sure you want to merge these locations?')">Merge</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setRenameLocation(location) {
        document.getElementById('renameOldLocation').value = location;
        document.getElementById('renameNewLocation').value = '';
    }

    function setMergeSourceLocation(location) {
        document.getElementById('mergeSourceLocation').value = location;
        document.getElementById('mergeTargetLocation').value = '';
    }
</script>
