@{
    ViewData["Title"] = "Partners & Monetization";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link rel="stylesheet" href="~/css/admin-portal.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="portal-container">
    
    <div class="portal-header">
        <h2>🤝 Đối tác & Kinh doanh</h2>
        <p>Quản lý đối tác, quảng cáo và doanh thu</p>
    </div>

    <div class="portal-sections">
        
        <div class="section-card">
            <div class="section-header">
                <div class="section-icon partners">
                    <i class="fas fa-building"></i>
                </div>
                <div class="section-title">
                    <h3>Quản lý đối tác</h3>
                    <p>Partners Management</p>
                </div>
            </div>
            <div class="section-links">
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-list"></i> Tất cả đối tác</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-plus"></i> Thêm đối tác mới</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-handshake"></i> Hợp đồng</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <div class="section-icon partners">
                    <i class="fas fa-ad"></i>
                </div>
                <div class="section-title">
                    <h3>Gói quảng cáo</h3>
                    <p>Advertising Packages</p>
                </div>
            </div>
            <div class="section-links">
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-box"></i> Các gói quảng cáo</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-chart-line"></i> Hiệu quả quảng cáo</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <div class="section-icon partners">
                    <i class="fas fa-chart-bar"></i>
                </div>
                <div class="section-title">
                    <h3>Thống kê doanh thu</h3>
                    <p>Revenue Statistics</p>
                </div>
            </div>
            <div class="section-links">
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-dollar-sign"></i> Doanh thu tổng</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-file-invoice-dollar"></i> Báo cáo tài chính</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <div class="section-icon partners">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="section-title">
                    <h3>Giao dịch Coin</h3>
                    <p>Coin Transactions</p>
                </div>
            </div>
            <div class="section-links">
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-exchange-alt"></i> Lịch sử giao dịch</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
                <a href="#" class="section-link disabled">
                    <span><i class="fas fa-wallet"></i> Ví người dùng</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>

    <a href="/Admin/Portal" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Quay lại Portal
    </a>

</div>
