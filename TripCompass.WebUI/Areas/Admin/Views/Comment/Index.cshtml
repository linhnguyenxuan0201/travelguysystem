@using TripCompass.Application.Common.Models
@using TripCompass.Application.Features.Admin.Comments.GetComments
@using TripCompass.Application.DTOs
@model PaginatedList<CommentListItemDto>

@{
    ViewData["Title"] = "Comment Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --bs-font-sans-serif: 'Inter', sans-serif;
        --bs-body-color: #3f4254;
        --bs-light-bg: #f9f9fc;
    }

    body {
        background-color: var(--bs-light-bg);
    }

    .card-flush {
        border: none;
        box-shadow: 0 0 20px 0 rgba(76, 87, 125, 0.02);
        background-color: #fff;
        border-radius: 12px;
    }

    .table-custom thead th {
        background-color: #f9f9fc;
        color: #a1a5b7;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #eff2f5;
    }

    .table-custom tbody td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px dashed #eff2f5;
        font-size: 0.95rem;
        color: #5e6278;
    }

    .table-custom tbody tr:hover {
        background-color: #f9f9fc;
    }

    .badge-soft-danger {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>

<div class="d-flex flex-wrap flex-stack pb-4 align-items-center justify-content-between">
    <div>
        <h1 class="fw-bold text-dark fs-3 mb-1">Comment Management</h1>
        <span class="text-muted fw-semibold fs-7">Manage user comments and reviews</span>
    </div>
    <a href="/Admin/Portal" class="btn btn-sm btn-icon btn-light text-muted">
        <i class="fas fa-arrow-left"></i>
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-flush shadow-sm">
    <div class="card-header align-items-center py-5 gap-2 gap-md-5">
        <form method="get" class="w-100">
            <div class="row g-3 align-items-center">
                <div class="col-md-4 position-relative">
                    <div class="input-group input-group-solid">
                        <span class="input-group-text bg-light border-0 ps-3">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input name="SearchTerm" type="text"
                               class="form-control form-control-solid bg-light border-0 ps-2"
                               value="@ViewBag.SearchTerm"
                               placeholder="Search by content, post title, user..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <select name="IsDeleted" class="form-select form-select-solid bg-light border-0 fw-bold text-muted" onchange="this.form.submit()">
                        <option value="">All</option>
                        <option value="false" selected="@(ViewBag.IsDeleted == false)">Active</option>
                        <option value="true" selected="@(ViewBag.IsDeleted == true)">Deleted</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary fw-bold w-100">
                        Apply Filter
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.IsDeleted != null)
                {
                    <div class="col-md-2">
                        <a href="@Url.Action("Index", "Comment", new { area = "Admin" })" class="btn btn-light w-100 text-muted fw-bold">
                            Reset
                        </a>
                    </div>
                }
            </div>
        </form>
    </div>

    <div class="card-body pt-0">
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th style="min-width: 200px;">Comment</th>
                        <th style="min-width: 150px;">Post</th>
                        <th style="min-width: 150px;">User</th>
                        <th style="min-width: 100px;">Status</th>
                        <th style="min-width: 100px;">Stats</th>
                        <th style="min-width: 120px;">Created</th>
                        <th class="text-end" style="min-width: 100px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var comment in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="text-dark fw-semibold" style="max-width: 300px;">
                                        @(comment.Content.Length > 100 ? comment.Content.Substring(0, 100) + "..." : comment.Content)
                                    </div>
                                    @if (comment.ParentCommentId.HasValue)
                                    {
                                        <span class="badge bg-secondary small">Reply</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark fw-bold">@(comment.PostTitle.Length > 30 ? comment.PostTitle.Substring(0, 30) + "..." : comment.PostTitle)</span>
                                        <span class="text-muted fs-8">Post ID: #@comment.PostId</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark fw-bold">@comment.UserName</span>
                                        <span class="text-muted fs-8">@comment.UserEmail</span>
                                    </div>
                                </td>

                                <td>
                                    @if (comment.IsDeleted)
                                    {
                                        <span class="badge-soft-danger">Deleted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>

                                <td>
                                    <div class="text-muted small">
                                        <i class="fas fa-heart text-danger me-1"></i>@comment.ReactionCount reactions
                                    </div>
                                </td>

                                <td>
                                    <div class="text-dark fw-bold fs-7">@comment.CreatedAt.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted fs-8">@comment.CreatedAt.ToString("HH:mm")</div>
                                </td>

                                <td class="text-end">
                                    @if (!comment.IsDeleted)
                                    {
                                        <form asp-action="Delete" asp-route-id="@comment.CommentId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger fw-bold px-3" onclick="return confirm('Are you sure you want to delete this comment?')">
                                                <i class="fas fa-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Already deleted</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="mb-3 text-muted opacity-50 display-1">
                                        <i class="fas fa-comments"></i>
                                    </div>
                                    <h5 class="text-muted fw-normal">No comments found matching your criteria</h5>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center pt-4 pb-2">
            <div class="text-muted small fw-semibold">
                Showing page <span class="text-dark fw-bold">@Model.PageNumber</span> of <span class="text-dark fw-bold">@Model.TotalPages</span>
            </div>
            <div class="d-flex gap-1">
                <a href="@(Model.HasPreviousPage? Url.Action("Index", new { PageNumber = Model.PageNumber - 1, SearchTerm = ViewBag.SearchTerm, IsDeleted = ViewBag.IsDeleted }) : "#")"
                   class="btn btn-sm btn-light @(!Model.HasPreviousPage ? "disabled opacity-50" : "")">
                    <i class="fas fa-chevron-left"></i> Previous
                </a>

                <a href="@(Model.HasNextPage? Url.Action("Index", new { PageNumber = Model.PageNumber + 1, SearchTerm = ViewBag.SearchTerm, IsDeleted = ViewBag.IsDeleted }) : "#")"
                   class="btn btn-sm btn-light @(!Model.HasNextPage ? "disabled opacity-50" : "")">
                    Next <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
