@using System.Linq
@using TripCompass.Application.Features.Admin.Posts.GetPostById
@using TripCompass.Application.Common
@using TripCompass.Domain.Enums
@model PostDetailDto

@{
    ViewData["Title"] = "Post Review";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- PAGE HEADER -->
<div class="mb-4 pb-3 border-bottom">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="h4 fw-semibold mb-1">@Model.Title</h1>
            <div class="text-muted small">
                Author: <strong>@Model.AuthorName</strong> • Created @Model.CreatedAt.ToString("dd/MM/yyyy")
                @if ( Model.PublishedAt.HasValue )
                {
                    <span> • Published @Model.PublishedAt.Value.ToString("dd/MM/yyyy")</span>
                }
                @if (Model.IsDeleted)
                {
                    <span class="text-danger"> • Deleted</span>
                }
            </div>
        </div>

        <div class="d-flex gap-2 align-items-center">
            @if (Model.IsDeleted)
            {
                <span class="badge bg-danger fs-6">🗑️ Deleted</span>
            }
            <span class="badge fs-6
                @( Model.Status == PostStatus.Published ? "bg-success" :
                                Model.Status == PostStatus.Pending ? "bg-warning text-dark" :
                                Model.Status == PostStatus.Rejected ? "bg-danger" :
                                Model.Status == PostStatus.Draft ? "bg-secondary" :
                                Model.Status == PostStatus.Archived ? "bg-dark" : "bg-secondary" )">
                @Model.Status
            </span>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- CONTENT -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h6 class="fw-semibold mb-0">
                    <i class="fas fa-file-alt me-2"></i>Content Preview
                </h6>
            </div>
            <div class="card-body">
                @if ( Model.Images.Any() )
                {
                    <img src="@Model.Images.First()" class="img-fluid rounded mb-4" />
                }

                <article class="post-content">
                    @Html.Raw(Model.Content)
                </article>
            </div>
        </div>

        @if ( !string.IsNullOrWhiteSpace(Model.ModerationNote) )
        {
            <div class="alert alert-warning mt-4">
                <strong>Moderation Note:</strong><br />
                @Model.ModerationNote
            </div>
        }
    </div>

    <!-- SIDEBAR -->
    <div class="col-lg-4">
        <!-- ACTIONS -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h6 class="fw-semibold mb-0">
                    <i class="fas fa-gavel me-2"></i>Moderation Actions
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="ChangeStatus" method="post">
                    <input type="hidden" name="PostId" value="@Model.PostId" />

                    <div class="mb-3">
                        <label for="NewStatus" class="form-label fw-semibold">
                            <i class="fas fa-tag me-2"></i>Change Status
                        </label>
                        <select name="NewStatus" id="NewStatus" class="form-select form-select-lg">
                            <option value="">-- Select New Status --</option>
                            @{
                                var validStatuses = PostStatusWorkflow.GetValidNextStatuses(Model.Status);
                            }
                            @foreach (var status in validStatuses)
                            {
                                var statusLabel = status switch
                                {
                                    PostStatus.Draft => "📝 Draft",
                                    PostStatus.Pending => "🟡 Pending Approval",
                                    PostStatus.Published => "🟢 Published",
                                    PostStatus.Rejected => "🔴 Rejected",
                                    PostStatus.Archived => "📦 Archived",
                                    _ => status.ToString()
                                };
                                <option value="@((int)status)">@statusLabel</option>
                            }
                        </select>
                        <small class="form-text text-muted">
                            Current status: <strong>@Model.Status</strong>
                            @if (validStatuses != null && validStatuses.Any())
                            {
                                <text>
                                <br />Valid transitions: @string.Join(", ", validStatuses.Select(s => s.ToString()))
                                </text>
                            }
                        </small>
                    </div>

                    <div class="mb-3">
                        @if (!Model.IsDeleted)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsDeleted" id="IsDeleted" value="true" />
                                <label class="form-check-label text-danger" for="IsDeleted">
                                    <i class="fas fa-trash me-2"></i>Soft Delete (can be restored)
                                </label>
                            </div>
                        }
                        else
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsDeleted" id="RestoreDeleted" value="false" />
                                <label class="form-check-label text-success" for="RestoreDeleted">
                                    <i class="fas fa-undo me-2"></i>Restore from Deleted
                                </label>
                            </div>
                            <small class="text-muted">Post is currently deleted. Check to restore.</small>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="ModerationNote" class="form-label fw-semibold">
                            <i class="fas fa-sticky-note me-2"></i>Moderation Note (Optional)
                        </label>
                        <textarea name="ModerationNote" id="ModerationNote" class="form-control"
                                  rows="3" placeholder="Reason / internal note..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-save me-2"></i>Update Status
                    </button>
                </form>
            </div>
        </div>

        <!-- METADATA -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h6 class="fw-semibold mb-0">
                    <i class="fas fa-info-circle me-2"></i>Metadata
                </h6>
            </div>
            <div class="card-body small">
                <dl class="row mb-0">
                    <dt class="col-5">Views</dt>
                    <dd class="col-7">@Model.ViewCount</dd>

                    <dt class="col-5">Likes</dt>
                    <dd class="col-7">@Model.LikeCount</dd>

                    <dt class="col-5">SEO Title</dt>
                    <dd class="col-7">@Model.SeoTitle ?? "—"</dd>

                    <dt class="col-5">Slug</dt>
                    <dd class="col-7">@Model.Slug ?? "—"</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
