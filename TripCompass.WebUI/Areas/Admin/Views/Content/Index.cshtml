@using TripCompass.Application.Common.Models
@using TripCompass.Application.Features.Admin.Posts.GetPosts
@using TripCompass.Domain.Enums
@model PaginatedList<PostDto>

@{
    ViewData["Title"] = "Content Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="mb-4 pb-3 border-bottom">
    <h1 class="h4 fw-semibold mb-1">Content Management</h1>
    <p class="text-muted small mb-0">Manage all posts and moderation workflow</p>
</div>

<!-- FILTERS -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input name="SearchTerm" class="form-control"
                       value="@ViewBag.SearchTerm"
                       placeholder="Title or Post ID" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="Status" class="form-select" id="statusFilter">
                    <option value="">All Status</option>
                    @if (ViewBag.SelectedStatus == PostStatus.Draft)
                    {
                        <option value="@((int)PostStatus.Draft)" selected>📝 Draft</option>
                    }
                    else
                    {
                        <option value="@((int)PostStatus.Draft)">📝 Draft</option>
                    }

                    @if (ViewBag.SelectedStatus == PostStatus.Pending)
                    {
                        <option value="@((int)PostStatus.Pending)" selected>🟡 Pending Approval</option>
                    }
                    else
                    {
                        <option value="@((int)PostStatus.Pending)">🟡 Pending Approval</option>
                    }

                    @if (ViewBag.SelectedStatus == PostStatus.Published)
                    {
                        <option value="@((int)PostStatus.Published)" selected>🟢 Published</option>
                    }
                    else
                    {
                        <option value="@((int)PostStatus.Published)">🟢 Published</option>
                    }

                    @if (ViewBag.SelectedStatus == PostStatus.Rejected)
                    {
                        <option value="@((int)PostStatus.Rejected)" selected>🔴 Rejected</option>
                    }
                    else
                    {
                        <option value="@((int)PostStatus.Rejected)">🔴 Rejected</option>
                    }

                    @if (ViewBag.SelectedStatus == PostStatus.Archived)
                    {
                        <option value="@((int)PostStatus.Archived)" selected>📦 Archived</option>
                    }
                    else
                    {
                        <option value="@((int)PostStatus.Archived)">📦 Archived</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100">
                    <i class="fas fa-filter me-2"></i>Apply
                </button>
            </div>
        </form>
    </div>
</div>

<!-- TABLE -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Post</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th>Views</th>
                    <th>Date</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach ( var item in Model.Items )
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Title</div>
                            <small class="text-muted">ID #@item.PostId • @item.CategoryName</small>
                        </td>
                        <td>@item.AuthorName</td>
                        <td>
                            <span class="badge
                                    @( item.Status == PostStatus.Published ? "bg-success" :
                                                                    item.Status == PostStatus.Pending ? "bg-warning text-dark" :
                                                                    item.Status == PostStatus.Rejected ? "bg-danger" :
                                                                    item.Status == PostStatus.Draft ? "bg-secondary" :
                                                                    item.Status == PostStatus.Archived ? "bg-dark" : "bg-secondary" )">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.ViewCount</td>
                        <td>
                            <small>@item.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", "Content", new { area = "Admin", id = item.PostId })"
                               class="btn btn-sm btn-outline-primary">
                                Review
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-between">
        <small class="text-muted">
            Page @Model.PageNumber of @Model.TotalPages
        </small>
        <div>
            @if ( Model.HasPreviousPage )
            {
                <a asp-route-PageNumber="@(Model.PageNumber - 1)"
                   class="btn btn-sm btn-outline-secondary">Previous</a>
            }
            @if ( Model.HasNextPage )
            {
                <a asp-route-PageNumber="@(Model.PageNumber + 1)"
                   class="btn btn-sm btn-outline-secondary">Next</a>
            }
        </div>
    </div>
</div>
 