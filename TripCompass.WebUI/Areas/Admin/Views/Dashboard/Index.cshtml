@model TripCompass.Application.DTOs.DashboardStatsDto

@{
    ViewData["Title"] = "Admin Dashboard";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<style>
    :root {
        --bs-font-sans-serif: 'Inter', system-ui, -apple-system, sans-serif;
        --card-border-radius: 16px;
        --card-shadow: 0 10px 30px 0 rgba(82, 63, 105, 0.05);
        --text-muted: #a1a5b7;
        --text-dark: #3f4254;
    }

    body {
        background-color: #f9f9fc; /* Màu nền sáng, sạch */
        font-family: var(--bs-font-sans-serif);
        color: var(--text-dark);
    }

    .dashboard-container {
        padding: 30px;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* CARDS */
    .card {
        border: none;
        border-radius: var(--card-border-radius);
        box-shadow: var(--card-shadow);
        background: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card-stat {
        overflow: hidden;
        position: relative;
    }

    a .card-stat:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px 0 rgba(82, 63, 105, 0.1);
    }

    .stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        transition: all 0.3s;
    }

    /* Custom Color Backgrounds for Icons */
    .bg-light-primary {
        background-color: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
    }

    .bg-light-success {
        background-color: rgba(25, 135, 84, 0.1);
        color: #198754;
    }

    .bg-light-danger {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }

    .bg-light-warning {
        background-color: rgba(255, 193, 7, 0.1);
        color: #ffc107;
    }

    /* CHART & TABLE */
    .card-header {
        background-color: transparent;
        border-bottom: 1px solid #eff2f5;
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        color: var(--text-dark);
    }

    .chart-container {
        position: relative;
        height: 320px;
        width: 100%;
        padding: 0 10px;
    }

    /* Table Styling */
    .table-custom th {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--text-muted);
        background-color: #f9f9fc;
        padding: 12px 16px;
        border-bottom: 1px dashed #e4e6ef;
    }

    .table-custom td {
        vertical-align: middle;
        padding: 16px;
        border-bottom: 1px dashed #e4e6ef;
        font-weight: 500;
        color: #5e6278;
    }

    .table-custom tr:last-child td {
        border-bottom: none;
    }

    .avatar-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background-color: #f1f1f4;
        color: #7e8299;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        font-size: 1.1rem;
    }

    /* Buttons */
    .btn-light-action {
        background: #f5f8fa;
        color: #7e8299;
        font-weight: 600;
        border: none;
    }

        .btn-light-action:hover {
            background: #eff2f5;
            color: var(--text-dark);
        }
</style>

<div class="dashboard-container">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">
        <div>
            <h3 class="fw-bold text-dark mb-1">Dashboard Overview</h3>
            <div class="text-muted small fw-medium">Welcome back, Admin! Here's what's happening today.</div>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/Dashboard/ExportReport" class="btn btn-primary d-flex align-items-center shadow-sm">
                <i class="fas fa-cloud-download-alt me-2"></i> Export Report
            </a>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <a href="/Admin/User" class="text-decoration-none">
                <div class="card card-stat h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="icon-box bg-light-primary">
                                <i class="fas fa-users"></i>
                            </div>
                            @if ( Model.NewUsersToday > 0 )
                            {
                                <span class="badge bg-light-success text-success fw-bold px-3 py-2 rounded-pill">
                                    <i class="fas fa-arrow-up me-1"></i> +@Model.NewUsersToday
                                </span>
                            }
                        </div>
                        <div>
                            <h2 class="stat-value">@Model.TotalUsers.ToString("N0")</h2>
                            <div class="stat-label mt-1">Total Users</div>
                        </div>
                        <div class="mt-3 pt-3 border-top border-dashed">
                            <small class="text-muted fw-semibold">
                                <span class="text-danger me-1"><i class="fas fa-ban"></i> @Model.BannedUsers</span> Banned accounts
                            </small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="/Admin/Content" class="text-decoration-none">
                <div class="card card-stat h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="icon-box bg-light-success">
                                <i class="fas fa-file-alt"></i>
                            </div>
                            <span class="badge bg-light-warning text-warning fw-bold px-3 py-2 rounded-pill">
                                @Model.PendingPosts Pending
                            </span>
                        </div>
                        <div>
                            <h2 class="stat-value">@Model.TotalPosts.ToString("N0")</h2>
                            <div class="stat-label mt-1">Total Posts</div>
                        </div>
                        <div class="mt-3 pt-3 border-top border-dashed">
                            <small class="text-muted fw-semibold">Content generation stats</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="/Admin/Report" class="text-decoration-none">
                <div class="card card-stat h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="icon-box bg-light-danger">
                                <i class="fas fa-flag"></i>
                            </div>
                            @if ( Model.PendingReports > 0 )
                            {
                                <div class="spinner-grow text-danger spinner-grow-sm" role="status">
                                    <span class="visually-hidden">Action needed</span>
                                </div>
                            }
                        </div>
                        <div>
                            <h2 class="stat-value">@Model.PendingReports</h2>
                            <div class="stat-label mt-1">Pending Reports</div>
                        </div>
                        <div class="mt-3 pt-3 border-top border-dashed">
                            @if ( Model.PendingReports > 0 )
                            {
                                <small class="text-danger fw-bold"><i class="fas fa-exclamation-circle me-1"></i>Action Required</small>
                            }
                            else
                            {
                                <small class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i>System Clear</small>
                            }
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="/Admin/Partner" class="text-decoration-none">
                <div class="card card-stat h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="icon-box bg-light-warning">
                                <i class="fas fa-coins"></i>
                            </div>
                        </div>
                        <div>
                            <h2 class="stat-value">@Model.TotalCoinBalance.ToString("N0")</h2>
                            <div class="stat-label mt-1">System Coins</div>
                        </div>
                        <div class="mt-3 pt-3 border-top border-dashed">
                            <small class="text-muted fw-semibold">Total circulating value</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title">User Growth Analytics</h5>
                    <select class="form-select form-select-sm w-auto border-0 bg-light fw-bold text-muted">
                        <option>Last 7 Days</option>
                        <option>Last 30 Days</option>
                    </select>
                </div>
                <div class="card-body d-flex align-items-center">
                    <div class="chart-container">
                        <canvas id="userGrowthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title">Trending Content</h5>
                    <a href="/Admin/Content" class="btn btn-sm btn-light-action">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom mb-0 w-100">
                            <thead>
                                <tr>
                                    <th class="ps-4">Post Title</th>
                                    <th class="text-end pe-4">Views</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach ( var post in Model.TopViewedPosts )
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-placeholder flex-shrink-0">
                                                    <i class="fas fa-newspaper"></i>
                                                </div>
                                                <div style="min-width: 0;">
                                                    <div class="fw-bold text-dark text-truncate" style="max-width: 180px;" title="@post.Title">
                                                        @post.Title
                                                    </div>
                                                    <div class="small text-muted">by @post.AuthorName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="badge bg-secondary text-dark fw-bold rounded-pill">
                                                @post.ViewCount
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a href="/Admin/Portal" class="btn btn-light-action text-dark fw-bold px-4">
            <i class="fas fa-arrow-left me-2"></i> Quay lại Portal
        </a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('userGrowthChart').getContext('2d');

        // Tạo Gradient cho chart đẹp hơn
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(13, 110, 253, 0.25)');
        gradient.addColorStop(1, 'rgba(13, 110, 253, 0.0)');

        const labels = @Html.Raw(Json.Serialize(Model.UserGrowthData.Select(x => x.Date)));
        const data = @Html.Raw(Json.Serialize(Model.UserGrowthData.Select(x => x.Count)));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'New Users',
                    data: data,
                    borderColor: '#0d6efd',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4, // Làm đường cong mềm mại (Smooth curve)
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#0d6efd',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e2129',
                        padding: 12,
                        titleFont: { size: 13 },
                        bodyFont: { size: 14, weight: 'bold' },
                        cornerRadius: 8,
                        displayColors: false
                    }
                },
                scales: {
                    x: {
                        grid: { display: false, drawBorder: false },
                        ticks: { color: '#a1a5b7', font: { size: 11 } }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [5, 5], color: '#eff2f5', drawBorder: false },
                        ticks: { color: '#a1a5b7', padding: 10, font: { size: 11 } }
                    }
                },
                interaction: {
                    intersect: false,
                    mode: 'index',
                },
            }
        });
    });
</script>