@model TripCompass.Application.DTOs.DashboardStatsDto

@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #f4f6f9;
    }

    .dashboard-container {
        padding: 24px;
    }

    /* STAT CARDS */
    .card-stat {
        border-radius: 14px;
        border: none;
        height: 100%;
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }

        .card-stat .card-body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }

    .icon-shape {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .bg-light-primary {
        background: rgba(13,110,253,.12);
        color: #0d6efd
    }

    .bg-light-success {
        background: rgba(25,135,84,.12);
        color: #198754
    }

    .bg-light-danger {
        background: rgba(220,53,69,.12);
        color: #dc3545
    }

    .bg-light-warning {
        background: rgba(255,193,7,.15);
        color: #ffc107
    }

    /* CHART */
    .chart-container {
        height: 300px;
    }

    /* TABLE */
    table td, table th {
        vertical-align: middle;
    }

    .table thead th {
        font-size: 0.7rem;
        letter-spacing: 0.05em;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }

    /* CLICKABLE CARD HOVER */
    a .card-stat:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        transition: all 0.3s ease;
    }

    a .card-stat {
        transition: all 0.3s ease;
    }
</style>

<div class="dashboard-container">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Overview</h3>
            <small class="text-muted">System summary and recent activity</small>
        </div>
        <a href="/Admin/Dashboard/ExportReport" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-download me-2"></i>Export Report
        </a>
    </div>

    <!-- STATISTICS -->
    <div class="row g-4 mb-4">
        <!-- USERS -->
        <div class="col-xl-3 col-md-6">
            <a href="/Admin/User" class="text-decoration-none">
                <div class="card card-stat" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <small class="text-muted text-uppercase fw-semibold">Total Users</small>
                                <h3 class="fw-bold mt-1">@Model.TotalUsers.ToString("N0")</h3>
                            </div>
                            <div class="icon-shape bg-light-primary">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill">
                                +@Model.NewUsersToday today
                            </span>
                            <small class="text-danger fw-semibold">
                                <i class="fas fa-ban me-1"></i>@Model.BannedUsers
                            </small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- POSTS -->
        <div class="col-xl-3 col-md-6">
            <a href="/Admin/Content" class="text-decoration-none">
                <div class="card card-stat" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <small class="text-muted text-uppercase fw-semibold">Total Posts</small>
                                <h3 class="fw-bold mt-1">@Model.TotalPosts.ToString("N0")</h3>
                            </div>
                            <div class="icon-shape bg-light-success">
                                <i class="fas fa-file-alt"></i>
                            </div>
                        </div>
                        <small class="text-muted mt-3">
                            Pending Approval:
                            <span class="fw-bold text-warning">@Model.PendingPosts</span>
                        </small>
                    </div>
                </div>
            </a>
        </div>

        <!-- REPORTS -->
        <div class="col-xl-3 col-md-6">
            <a href="/Admin/Report" class="text-decoration-none">
                <div class="card card-stat" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <small class="text-muted text-uppercase fw-semibold">Pending Reports</small>
                                <h3 class="fw-bold mt-1">@Model.PendingReports</h3>
                            </div>
                            <div class="icon-shape bg-light-danger">
                                <i class="fas fa-flag"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            @if ( Model.PendingReports > 0 )
                            {
                                <span class="text-danger fw-semibold">
                                    <i class="fas fa-exclamation-circle me-1"></i>Requires Action
                                </span>
                            }
                            else
                            {
                                <span class="text-success fw-semibold">
                                    <i class="fas fa-check-circle me-1"></i>All clear
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- COINS -->
        <div class="col-xl-3 col-md-6">
            <a href="/Admin/Partner" class="text-decoration-none">
                <div class="card card-stat" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <small class="text-muted text-uppercase fw-semibold">System Coins</small>
                                <h3 class="fw-bold mt-1">@Model.TotalCoinBalance.ToString("N0")</h3>
                            </div>
                            <div class="icon-shape bg-light-warning">
                                <i class="fas fa-coins"></i>
                            </div>
                        </div>
                        <small class="text-muted mt-3">Circulating currency</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- CHART + TABLE -->
    <div class="row g-4">
        <!-- USER GROWTH -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 d-flex justify-content-between">
                    <h5 class="fw-bold mb-0">User Growth</h5>
                    <select class="form-select form-select-sm w-auto">
                        <option>Last 7 Days</option>
                        <option>Last Month</option>
                    </select>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="userGrowthChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- TRENDING POSTS -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0">
                    <h5 class="fw-bold mb-0">Trending Posts</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">Title</th>
                                <th class="text-end pe-3">Views</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach ( var post in Model.TopViewedPosts )
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-light-primary me-2">
                                                <i class="fas fa-newspaper"></i>
                                            </div>
                                            <div class="text-truncate" style="max-width:200px" title="@post.Title">
                                                <div class="fw-semibold">@post.Title</div>
                                                <small class="text-muted">by @post.AuthorName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end pe-3">
                                        <span class="badge bg-light text-dark">
                                            <i class="far fa-eye me-1"></i>@post.ViewCount
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white text-center">
                    <a href="/Admin/Content" class="fw-bold small text-decoration-none">
                        View All Posts <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- BACK TO PORTAL -->
    <div class="mt-4">
        <a href="/Admin/Portal" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại Portal
        </a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('userGrowthChart');

        const labels = @Html.Raw(Json.Serialize(Model.UserGrowthData.Select(x => x.Date)));
        const data = @Html.Raw(Json.Serialize(Model.UserGrowthData.Select(x => x.Count)));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    data,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13,110,253,0.15)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    });
</script>
