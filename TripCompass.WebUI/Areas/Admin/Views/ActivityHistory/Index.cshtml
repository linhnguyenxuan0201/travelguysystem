@model List<TripCompass.Application.DTOs.ActivityHistoryDto>

@{
    ViewData["Title"] = "Lịch sử hoạt động";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 20;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<style>
    body {
        background-color: #f4f6f9;
    }

    .page-header h3 {
        margin-bottom: 4px;
    }

    .card {
        border-radius: 14px;
        border: none;
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }

    table th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6c757d;
    }

    table td {
        vertical-align: middle;
    }

    .activity-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .activity-icon.danger { background-color: #fee; color: #dc3545; }
    .activity-icon.success { background-color: #d4edda; color: #28a745; }
    .activity-icon.warning { background-color: #fff3cd; color: #ffc107; }
    .activity-icon.info { background-color: #d1ecf1; color: #17a2b8; }
    .activity-icon.primary { background-color: #cce5ff; color: #007bff; }
    .activity-icon.secondary { background-color: #e9ecef; color: #6c757d; }

    .activity-note {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .time-ago {
        color: #6c757d;
        font-size: 0.875rem;
    }
</style>

<div class="container-fluid p-4">
    <!-- HEADER -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold"><i class="fas fa-history me-2"></i>Lịch sử hoạt động</h3>
            <small class="text-muted">Xem lại tất cả các thao tác của Admin trong hệ thống</small>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small">Loại hành động</label>
                    <select name="ActionType" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        <option value="BAN_USER" selected="@(ViewBag.ActionType == "BAN_USER")">Khóa người dùng</option>
                        <option value="UNBAN_USER" selected="@(ViewBag.ActionType == "UNBAN_USER")">Mở khóa người dùng</option>
                        <option value="CHANGE_POST_STATUS" selected="@(ViewBag.ActionType == "CHANGE_POST_STATUS")">Thay đổi trạng thái bài viết</option>
                        <option value="UPDATE_POST" selected="@(ViewBag.ActionType == "UPDATE_POST")">Cập nhật bài viết</option>
                        <option value="DELETE_POST" selected="@(ViewBag.ActionType == "DELETE_POST")">Xóa bài viết</option>
                        <option value="APPROVE_POST" selected="@(ViewBag.ActionType == "APPROVE_POST")">Duyệt bài viết</option>
                        <option value="REJECT_POST" selected="@(ViewBag.ActionType == "REJECT_POST")">Từ chối bài viết</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small">Bảng đích</label>
                    <select name="TargetTable" class="form-select form-select-sm">
                        <option value="">Tất cả</option>
                        <option value="Users" selected="@(ViewBag.TargetTable == "Users")">Users</option>
                        <option value="Posts" selected="@(ViewBag.TargetTable == "Posts")">Posts</option>
                        <option value="Comments" selected="@(ViewBag.TargetTable == "Comments")">Comments</option>
                        <option value="Reports" selected="@(ViewBag.TargetTable == "Reports")">Reports</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small">Từ ngày</label>
                    <input type="date" name="FromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small">Đến ngày</label>
                    <input type="date" name="ToDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small">Tìm kiếm</label>
                    <input type="text" name="SearchTerm" class="form-control form-control-sm" 
                           placeholder="Tìm kiếm..." value="@ViewBag.SearchTerm" />
                </div>

                <div class="col-md-12">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-filter me-1"></i>Lọc
                    </button>
                    <a href="/Admin/ActivityHistory" class="btn btn-outline-secondary btn-sm ms-2">
                        <i class="fas fa-redo me-1"></i>Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- STATS -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Tổng số bản ghi</small>
                            <h4 class="mb-0">@totalCount</h4>
                        </div>
                        <div>
                            <small class="text-muted">Trang @currentPage / @totalPages</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 60px;">Icon</th>
                            <th>Hành động</th>
                            <th>Admin</th>
                            <th>Đối tượng</th>
                            <th>Ghi chú</th>
                            <th>Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="activity-icon @log.ActionColor">
                                        <i class="fas @log.ActionIcon"></i>
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-semibold">@log.ActionDisplayName</div>
                                    <small class="text-muted">@log.ActionType</small>
                                </td>

                                <td>
                                    <div class="fw-semibold">@log.AdminName</div>
                                    <small class="text-muted">@log.AdminEmail</small>
                                    <div class="mt-1">
                                        <span class="badge bg-@(log.UserRole == "Admin" ? "danger" : log.UserRole == "Moderator" ? "warning" : "secondary") text-white" style="font-size: 0.65rem;">
                                            @log.UserRole
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div>
                                        <span class="badge bg-secondary">@log.TargetTable</span>
                                        <span class="text-muted">#@log.TargetId</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="activity-note" title="@log.Note">
                                        @(log.Note ?? "-")
                                    </div>
                                </td>

                                <td>
                                    <div>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    <small class="time-ago">
                                        @{
                                            var timeSpan = DateTime.UtcNow - log.CreatedAt;
                                            string timeAgo;
                                            if (timeSpan.TotalDays >= 7)
                                                timeAgo = $"{(int)timeSpan.TotalDays / 7} tuần trước";
                                            else if (timeSpan.TotalDays >= 1)
                                                timeAgo = $"{(int)timeSpan.TotalDays} ngày trước";
                                            else if (timeSpan.TotalHours >= 1)
                                                timeAgo = $"{(int)timeSpan.TotalHours} giờ trước";
                                            else if (timeSpan.TotalMinutes >= 1)
                                                timeAgo = $"{(int)timeSpan.TotalMinutes} phút trước";
                                            else
                                                timeAgo = "Vừa xong";
                                        }
                                        @timeAgo
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- PAGINATION -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white">
                        <nav>
                            <ul class="pagination justify-content-center mb-0">
                                @if (currentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(currentPage - 1)&ActionType=@ViewBag.ActionType&TargetTable=@ViewBag.TargetTable&FromDate=@ViewBag.FromDate&ToDate=@ViewBag.ToDate&SearchTerm=@ViewBag.SearchTerm">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           href="?page=@i&ActionType=@ViewBag.ActionType&TargetTable=@ViewBag.TargetTable&FromDate=@ViewBag.FromDate&ToDate=@ViewBag.ToDate&SearchTerm=@ViewBag.SearchTerm">
                                            @i
                                        </a>
                                    </li>
                                }

                                @if (currentPage < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@(currentPage + 1)&ActionType=@ViewBag.ActionType&TargetTable=@ViewBag.TargetTable&FromDate=@ViewBag.FromDate&ToDate=@ViewBag.ToDate&SearchTerm=@ViewBag.SearchTerm">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center p-5">
                    <i class="fas fa-history fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Không có lịch sử hoạt động nào</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- BACK TO PORTAL -->
<div class="container-fluid px-4 mb-4">
    <a href="/Admin/Portal" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Quay lại Portal
    </a>
</div>
