@using TripCompass.Application.Features.Admin.Security.GetSecuritySettings
@using TripCompass.Application.DTOs
@model SecuritySettingsDto

@{
    ViewData["Title"] = "Security Settings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --bs-font-sans-serif: 'Inter', sans-serif;
        --bs-body-color: #3f4254;
        --bs-light-bg: #f9f9fc;
    }

    body {
        background-color: var(--bs-light-bg);
    }

    .card-flush {
        border: none;
        box-shadow: 0 0 20px 0 rgba(76, 87, 125, 0.02);
        background-color: #fff;
        border-radius: 12px;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #3f4254;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #eff2f5;
    }
</style>

<div class="d-flex flex-wrap flex-stack pb-4 align-items-center justify-content-between">
    <div>
        <h1 class="fw-bold text-dark fs-3 mb-1">Security Settings</h1>
        <span class="text-muted fw-semibold fs-7">Manage system security and password policies</span>
    </div>
    <a href="/Admin/Portal" class="btn btn-sm btn-icon btn-light text-muted">
        <i class="fas fa-arrow-left"></i>
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()

    <!-- Password Policy -->
    <div class="card card-flush shadow-sm mb-4">
        <div class="card-body p-5">
            <h3 class="section-title">
                <i class="fas fa-key me-2 text-primary"></i>Password Policy
            </h3>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Minimum Length</label>
                    <input type="number" name="PasswordPolicy.MinLength" class="form-control" 
                           value="@Model.PasswordPolicy.MinLength" min="6" max="32" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Max Failed Attempts</label>
                    <input type="number" name="PasswordPolicy.MaxFailedAttempts" class="form-control" 
                           value="@Model.PasswordPolicy.MaxFailedAttempts" min="3" max="10" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Lockout Duration (minutes)</label>
                    <input type="number" name="PasswordPolicy.LockoutDurationMinutes" class="form-control" 
                           value="@Model.PasswordPolicy.LockoutDurationMinutes" min="5" max="1440" required />
                </div>

                <div class="col-md-6"></div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="PasswordPolicy.RequireUppercase" 
                               id="requireUppercase" checked="@Model.PasswordPolicy.RequireUppercase" />
                        <label class="form-check-label fw-bold" for="requireUppercase">
                            Require Uppercase Letter
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="PasswordPolicy.RequireLowercase" 
                               id="requireLowercase" checked="@Model.PasswordPolicy.RequireLowercase" />
                        <label class="form-check-label fw-bold" for="requireLowercase">
                            Require Lowercase Letter
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="PasswordPolicy.RequireDigit" 
                               id="requireDigit" checked="@Model.PasswordPolicy.RequireDigit" />
                        <label class="form-check-label fw-bold" for="requireDigit">
                            Require Digit
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="PasswordPolicy.RequireSpecialChar" 
                               id="requireSpecialChar" checked="@Model.PasswordPolicy.RequireSpecialChar" />
                        <label class="form-check-label fw-bold" for="requireSpecialChar">
                            Require Special Character
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Security -->
    <div class="card card-flush shadow-sm mb-4">
        <div class="card-body p-5">
            <h3 class="section-title">
                <i class="fas fa-shield-alt me-2 text-danger"></i>System Security
            </h3>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Session Timeout (minutes)</label>
                    <input type="number" name="SystemSecurity.SessionTimeoutMinutes" class="form-control" 
                           value="@Model.SystemSecurity.SessionTimeoutMinutes" min="15" max="480" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Auto Ban Report Threshold</label>
                    <input type="number" name="SystemSecurity.AutoBanReportThreshold" class="form-control" 
                           value="@Model.SystemSecurity.AutoBanReportThreshold" min="3" max="20" required />
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="SystemSecurity.RequireEmailVerification" 
                               id="requireEmailVerification" checked="@Model.SystemSecurity.RequireEmailVerification" />
                        <label class="form-check-label fw-bold" for="requireEmailVerification">
                            Require Email Verification
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="SystemSecurity.EnableTwoFactorAuth" 
                               id="enableTwoFactorAuth" checked="@Model.SystemSecurity.EnableTwoFactorAuth" />
                        <label class="form-check-label fw-bold" for="enableTwoFactorAuth">
                            Enable Two-Factor Authentication
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="SystemSecurity.EnableIpWhitelist" 
                               id="enableIpWhitelist" checked="@Model.SystemSecurity.EnableIpWhitelist" />
                        <label class="form-check-label fw-bold" for="enableIpWhitelist">
                            Enable IP Whitelist
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="SystemSecurity.EnableContentModeration" 
                               id="enableContentModeration" checked="@Model.SystemSecurity.EnableContentModeration" />
                        <label class="form-check-label fw-bold" for="enableContentModeration">
                            Enable Content Moderation
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="SystemSecurity.EnableAutoBan" 
                               id="enableAutoBan" checked="@Model.SystemSecurity.EnableAutoBan" />
                        <label class="form-check-label fw-bold" for="enableAutoBan">
                            Enable Auto Ban (Based on Reports)
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a href="/Admin/Portal" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>Save Settings
        </button>
    </div>
</form>
